---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { contacto } from '../data/contacto';
import { marca } from '../data/seo';

// jsonLd: datos estructurados de la página (schema.org), si los tiene.
interface Props { title: string; description: string; jsonLd?: object }
const { title, description, jsonLd } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL(marca.imagen, Astro.site);
// «<» escapado para que ningún texto pueda cerrar la etiqueta <script>.
const jsonLdTexto = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0A0E" data-theme-color />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonica} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={marca.imagenAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagen} />
    {jsonLdTexto && <script is:inline type="application/ld+json" set:html={jsonLdTexto} />}
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-instrument" preload />
    <Font cssVariable="--font-jetbrains" />
    <script is:inline>
      // Tema guardado (oscuro por defecto, como la marca). Va antes de pintar para que no parpadee.
      try {
        if (localStorage.getItem('rd-theme') === 'light') {
          document.documentElement.classList.add('light');
          document.querySelector('[data-theme-color]').setAttribute('content', '#F4F0E8');
        }
      } catch (e) {}
      // Antes de pintar: marcar si habrá animación, para ocultar lo que va a entrar.
      // Sin JS o con «menos movimiento», todo se ve desde el inicio.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('has-motion');
        // Respaldo: si el JavaScript de la página no llega a cargar, se muestra todo igual.
        setTimeout(function () { if (!window.__rdMotion) document.documentElement.classList.remove('has-motion'); }, 4000);
      }
    </script>
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-bone focus:px-4 focus:py-2 focus:text-ink">Ir al contenido</a>
    <slot />
    {/* Rebel en la web: la plataforma sirve el script y coloca al asistente abajo a la derecha. */}
    {contacto.rebel && <script is:inline src={`${contacto.rebel}/rebel.js`} async></script>}
  </body>
</html>
