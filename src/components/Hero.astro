---
import { MARK } from '../lib/mark';
import { contacto } from '../data/contacto';

const servicios = ['Software a medida', 'Automatización de procesos', 'Plataformas web', 'Integraciones'];
---
<!-- Pantalla de carga (estilo Zentry): el </> se dibuja y se deshace en partículas (estilo Philos). Solo en la primera visita de la sesión. -->
<div class="intro" data-intro aria-hidden="true">
  <svg class="intro-mark" data-intro-mark viewBox={`0 0 ${MARK.width} ${MARK.height}`}>
    <g fill="none" stroke-width={MARK.stroke} stroke-linecap="round" stroke-linejoin="round">
      <path d={MARK.left} stroke="var(--color-bone)" data-intro-path />
      <path d={MARK.right} stroke="var(--color-bone)" data-intro-path />
      <path d={MARK.slash} stroke="var(--color-red)" data-intro-slash />
    </g>
  </svg>
</div>

<section id="inicio" class="hero relative overflow-hidden" data-hero>
  <canvas class="pointer-events-none absolute inset-0 h-full w-full" data-particles aria-hidden="true"></canvas>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="wrap hero-grid relative">
    <div class="hero-slot" data-mark-slot aria-hidden="true">
      <!-- Respaldo sin JavaScript -->
      <svg class="hero-fallback" viewBox={`0 0 ${MARK.width} ${MARK.height}`}>
        <g fill="none" stroke-width={MARK.stroke} stroke-linecap="round" stroke-linejoin="round">
          <path d={MARK.left} stroke="var(--color-bone)" /><path d={MARK.slash} stroke="var(--color-red)" /><path d={MARK.right} stroke="var(--color-bone)" />
        </g>
      </svg>
    </div>

    <div class="hero-copy" data-hero-copy>
      <p class="text-lead max-w-[30ch] text-ash">Primero entendemos tu negocio; después construimos la solución que realmente necesitas.</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={contacto.whatsappLink} target="_blank" rel="noopener" class="btn btn-primary" data-magnetic>Agenda una demo</a>
        <a href="#rebelbot" class="btn btn-ghost">Mira cómo trabaja RebelBot</a>
      </div>
    </div>

    <h1 class="hero-title text-hero" data-hero-title>
      <span class="line"><span>Ingeniería para</span></span>
      <span class="line"><span>empresas rebeldes.</span></span>
    </h1>

    <p class="hero-strip text-note text-ash" data-hero-strip>
      <span class="sr-only">Servicios: </span>
      {servicios.map((s, i) => <>{i > 0 && <span class="slash" aria-hidden="true">/</span>}<span>{s}</span></>)}
    </p>
  </div>
</section>

<style>
  .intro { display: none; }
  :global(html.show-intro) .intro {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 80; background: var(--color-ink);
  }
  .intro-mark { width: clamp(84px, 11vw, 140px); height: auto; overflow: visible; }

  .hero { min-height: 100svh; }
  .hero-glow {
    position: absolute; inset: auto -10% -30% 30%; height: 80%; pointer-events: none;
    background: radial-gradient(closest-side, rgb(228 18 31 / 0.16), transparent 70%);
    filter: blur(20px);
  }
  .hero-grid {
    display: grid; min-height: 100svh; padding-top: 6.5rem; padding-bottom: 1.5rem; row-gap: 2rem;
    grid-template-columns: 1fr;
    grid-template-areas: "slot" "title" "copy" "strip";
    align-content: end;
  }
  .hero-slot { grid-area: slot; width: min(78vw, 26rem); aspect-ratio: 55.5 / 30; justify-self: center; align-self: center; }
  .hero-fallback { width: 100%; height: 100%; overflow: visible; }
  :global(.particles-on) .hero-fallback { visibility: hidden; }
  .hero-copy { grid-area: copy; }
  .hero-title { grid-area: title; margin: 0; }
  .hero-title .line { display: block; overflow: clip; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .hero-title .line > span { display: inline-block; }
  .hero-strip { grid-area: strip; border-top: 1px solid var(--color-line); padding-top: 1.1rem; }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-rows: 1fr auto auto;
      grid-template-areas: "copy slot" "title title" "strip strip";
      row-gap: 2.5rem; padding-top: 7rem;
    }
    .hero-slot { width: min(100%, 40rem); justify-self: end; align-self: center; }
    .hero-copy { align-self: end; padding-bottom: 0.5rem; }
  }

  :global(html.has-motion) [data-hero-title] .line > span,
  :global(html.has-motion) [data-hero-copy],
  :global(html.has-motion) [data-hero-strip] { visibility: hidden; }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion, coarsePointer, lenis } from '../scripts/motion';

  const root = document.documentElement;
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('[data-particles]')!;
  const slot = hero.querySelector<HTMLElement>('[data-mark-slot]')!;
  const intro = document.querySelector<HTMLElement>('[data-intro]')!;
  const showIntro = root.classList.contains('show-intro');

  // Three.js se carga aparte para no frenar la página. Sin WebGL se queda el </> en SVG.
  const particles = import('../scripts/particles')
    .then(({ ParticleMark }) => {
      if (!ParticleMark.supported()) return null;
      const pm = new ParticleMark(canvas, slot, { interactive: !reduceMotion && !coarsePointer, still: reduceMotion });
      hero.classList.add('particles-on');
      return pm;
    })
    .catch((e) => { console.warn('[rebeldev] partículas desactivadas', e); return null; });

  const lines = hero.querySelectorAll('[data-hero-title] .line > span');
  const copy = hero.querySelector('[data-hero-copy]');
  const strip = hero.querySelector('[data-hero-strip]');

  function heroIn(delay = 0) {
    return gsap.timeline({ delay })
      .fromTo(lines, { yPercent: 105, autoAlpha: 1 }, { yPercent: 0, duration: 1.15, ease: 'expo.out', stagger: 0.12 })
      .fromTo(copy, { autoAlpha: 0, y: 18 }, { autoAlpha: 1, y: 0, duration: 0.9 }, '-=0.75')
      .fromTo(strip, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.9 }, '-=0.6');
  }

  Promise.all([particles, document.fonts.ready]).then(([pm]) => {
    if (reduceMotion) { pm?.build(); return; }

    if (showIntro) {
      lenis?.stop();
      window.scrollTo(0, 0);
      const mark = intro.querySelector<SVGSVGElement>('[data-intro-mark]')!;
      gsap.timeline()
        .fromTo(intro.querySelectorAll('[data-intro-path]'), { drawSVG: '50% 50%' }, { drawSVG: '0% 100%', duration: 0.75, ease: 'power3.inOut', stagger: 0.08 }, 0.15)
        .fromTo(intro.querySelector('[data-intro-slash]'), { drawSVG: '0% 0%' }, { drawSVG: '0% 100%', duration: 0.45, ease: 'power4.out' }, '+=0.05')
        .to({}, { duration: 0.3 })
        .add(() => {
          // El dibujo se deshace: las partículas salen de donde estaba y arman el </> grande.
          const r = mark.getBoundingClientRect(), c = canvas.getBoundingClientRect();
          pm?.build({ x: r.left - c.left, y: r.top - c.top, w: r.width, h: r.height });
          if (pm) gsap.set(mark, { autoAlpha: 0 });
          heroIn(0.35);
        })
        .to(intro, { autoAlpha: 0, duration: 0.8, ease: 'power2.out' })
        .add(() => {
          root.classList.remove('show-intro');
          try { sessionStorage.setItem('rd-intro', '1'); } catch (e) {}
          lenis?.start();
        });
    } else {
      pm?.build();
      heroIn(0.15);
    }

    // Al bajar, el </> se deshace en polvo.
    if (pm) ScrollTrigger.create({
      trigger: hero, start: 'top top', end: 'bottom top', scrub: true,
      onUpdate: (self) => { pm.scatter = self.progress; },
    });
  });
</script>
