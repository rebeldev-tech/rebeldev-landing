---
// «Lo que construimos»: los servicios como un tablero de 12 columnas sin huecos. Cada bloque lleva UN detalle
// de interfaz construido en em y ampliado (font-size de su raíz data-ui, en unidades del bloque), corrido
// hacia una esquina para que dos bordes lo recorten. Entra animado una vez; con hover se acerca un poco.
import { tablero } from '../../data/v6';

type El = 'burbuja' | 'interruptor' | 'llaves' | 'estado' | 'discos' | 'direccion' | 'deslizador' | 'cursor';

// Escritorio: 12 columnas × 8 filas de 104 px, sin celdas vacías (grid-area: fila / columna / fila / columna).
// Fila 1-2: titular | dirección · Fila 3-6: burbuja | interruptor | discos · Fila 7-8: estado | deslizador | llaves | cursor
const lugar: Record<El, string> = {
  direccion: '1 / 7 / 3 / 13',
  burbuja: '3 / 1 / 7 / 7',
  interruptor: '3 / 7 / 7 / 10',
  discos: '3 / 10 / 7 / 13',
  estado: '7 / 1 / 9 / 4',
  deslizador: '7 / 4 / 9 / 7',
  llaves: '7 / 7 / 9 / 10',
  cursor: '7 / 10 / 9 / 13',
};
// Orden del documento = orden en el teléfono (dos columnas, sin tonos iguales que se toquen)
const orden: El[] = ['burbuja', 'interruptor', 'discos', 'direccion', 'estado', 'deslizador', 'llaves', 'cursor'];
const bloques = orden
  .map((el) => tablero.bloques.find((b) => b.el === el))
  .filter((b): b is (typeof tablero.bloques)[number] => Boolean(b));
---
<section id="servicios" class="tb marco" aria-labelledby="tb-h2" data-tablero>
  <div class="tb-rej">
    <div class="bloque t-hueso tb-titular" data-reveal>
      <h2 id="tb-h2" class="tb-h2">{tablero.titulo}</h2>
    </div>

    {bloques.map((b) => {
      const el = b.el as El;
      const grande = b.tam.startsWith('6');
      return (
        <article class:list={['bloque', `t-${b.tono}`, 'tb-b', { 'tb-b--grande': grande }]} data-el={el} style={`--area: ${lugar[el]}`} data-reveal>
          <div class={`tb-ui tb-ui--${el}`} data-ui aria-hidden="true">
            {el === 'burbuja' && (
              <div class="tb-burbuja">
                <p class="tb-bt">¿Me lo reservas para el sábado?</p>
                <span class="tb-meta">23:14
                  <span class="tb-checks">
                    <svg viewBox="0 0 18 12"><path d="m1 6.5 3.5 3.5L11 3.5M7 9.5l.5.5L14 3.5" fill="none" stroke="#8696A0" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    <svg class="tb-azul" viewBox="0 0 18 12"><path d="m1 6.5 3.5 3.5L11 3.5M7 9.5l.5.5L14 3.5" fill="none" stroke="#53BDEB" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                </span>
              </div>
            )}
            {el === 'interruptor' && (
              <div class="tb-ajuste">
                <span class="tb-aj-l">Automático</span>
                <span class="tb-sw"><span class="tb-sw-on"></span><span class="tb-sw-k"></span></span>
              </div>
            )}
            {el === 'llaves' && (
              <div class="tb-teclas">
                <span class="tb-tecla"><span>&lt;</span></span>
                <span class="tb-tecla is-roja"><span>/</span></span>
                <span class="tb-tecla"><span>&gt;</span></span>
              </div>
            )}
            {el === 'estado' && (
              <div class="tb-estado"><span class="tb-punto"></span><code>200 OK</code></div>
            )}
            {el === 'discos' && (
              <div class="tb-discos">
                <span class="tb-d tb-d1">V</span><span class="tb-d tb-d2">A</span><span class="tb-d tb-d3">W</span>
              </div>
            )}
            {el === 'direccion' && (
              <div class="tb-dir">
                <svg class="tb-candado" viewBox="0 0 24 24" fill="none" stroke="#0B0A0E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                <span class="tb-url" data-url="tuempresa.pe">tuempresa.pe</span><span class="tb-caret"></span>
              </div>
            )}
            {el === 'deslizador' && (
              <div class="tb-desl">
                <span class="tb-pista"><span class="tb-lleno"></span></span>
                <span class="tb-mov"><span class="tb-perilla"></span></span>
              </div>
            )}
            {el === 'cursor' && (
              <div class="tb-cur">
                <span class="tb-mas">+</span>
                <svg class="tb-flecha" viewBox="0 0 20 26"><path d="M2 2v19.5l5.2-5 3.4 7.8 3.6-1.6-3.4-7.6H18z" fill="#fff" stroke="#0B0A0E" stroke-width="1.8" stroke-linejoin="round" /></svg>
              </div>
            )}
          </div>
          <span class="tb-res" aria-hidden="true"></span>
          <div class="tb-txt">
            <h3 class="tb-t">{b.t}</h3>
            <p class="tb-d">{b.d}</p>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .tb { padding-block: calc(var(--sec) / 2); }

  /* Teléfono y tableta: dos columnas, filas de 28vw */
  .tb-rej { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(28vw, auto); gap: var(--gap); }
  .tb-titular { grid-column: 1 / -1; padding: 24px; }
  .tb-h2 { margin: 0; font-size: clamp(36px, 4vw, 60px); }
  .tb-b { grid-row: span 2; }
  .tb-b--grande { grid-column: span 2; grid-row: span 2; }
  /* Tableta: filas más bajas y los bloques grandes a dos filas, para que no queden vacíos */
  @media (min-width: 640px) and (max-width: 1023px) {
    .tb-rej { grid-auto-rows: minmax(150px, auto); }
    .tb-b--grande { grid-row: span 2; }
  }

  @media (min-width: 1024px) {
    .tb-rej { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: minmax(104px, auto); }
    .tb-titular { grid-area: 1 / 1 / 3 / 7; }
    .tb-b, .tb-b--grande { grid-area: var(--area); }
  }

  /* El bloque: el detalle arriba a la derecha (absoluto), una reserva de su alto y el texto abajo a la izquierda */
  .tb-b { position: relative; container-type: inline-size; display: flex; flex-direction: column; padding: 20px; }
  .tb-res { flex: none; display: block; height: calc(var(--fs) * var(--res)); }
  .tb-txt { position: relative; margin-top: auto; padding-top: 12px; max-width: 34ch; }
  .tb-b--grande .tb-txt { max-width: 46ch; }
  .tb-t { margin: 0; font-family: var(--font-instrument), sans-serif; font-size: 18px; font-weight: 600; line-height: 1.25; letter-spacing: 0; }
  .tb-d { margin: 4px 0 0; font-size: 16px; line-height: 1.4; }
  .t-rojo .tb-d { font-size: var(--t-body); }

  /* Tamaño del detalle (relativo al ancho del bloque) y su reserva en em */
  .tb-b[data-el='burbuja'] { --fs: min(11cqw, 64px); --res: 3.8; }
  .tb-b[data-el='direccion'] { --fs: min(8cqw, 48px); --res: 1.8; }
  .tb-b[data-el='interruptor'] { --fs: min(15cqw, 60px); --res: 3.9; }
  .tb-b[data-el='discos'] { --fs: min(17cqw, 60px); --res: 1.55; }
  .tb-b[data-el='estado'] { --fs: min(19cqw, 76px); --res: 1.5; }
  .tb-b[data-el='deslizador'] { --fs: min(18cqw, 72px); --res: 1.6; }
  .tb-b[data-el='llaves'] { --fs: min(21cqw, 80px); --res: 1.35; }
  .tb-b[data-el='cursor'] { --fs: min(19cqw, 76px); --res: 1.6; }

  /* Raíz de cada detalle: en em, corrida hacia arriba a la derecha (los bordes la recortan) */
  [data-ui].tb-ui {
    position: absolute; top: 0; right: 0; font-size: var(--fs); line-height: 1.15; letter-spacing: 0;
    font-family: var(--font-instrument), sans-serif; transform-origin: top right; transition: transform 0.5s var(--ease);
  }
  .tb-b:hover [data-ui].tb-ui { transform: scale(1.04); }

  /* burbuja: mensaje de WhatsApp enviado, con doble check azul */
  [data-ui] .tb-burbuja {
    position: absolute; top: -0.5em; right: -0.7em; width: 9.5em; padding: 0.85em 1.1em 0.35em 0.55em;
    border-radius: 0.3em; background: #144D37; color: #E9EDEF;
  }
  [data-ui] .tb-bt { margin: 0; }
  [data-ui] .tb-meta { display: flex; align-items: center; justify-content: flex-end; gap: 0.25em; margin-top: 0.15em; font-size: 0.48em; color: #AEBAC1; }
  [data-ui] .tb-checks { position: relative; display: block; width: 1.5em; height: 1em; }
  [data-ui] .tb-checks svg { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* interruptor: un ajuste «Automático» que se prende solo */
  [data-ui] .tb-ajuste {
    position: absolute; top: -0.4em; right: -0.8em; display: flex; flex-direction: column; align-items: flex-start; gap: 0.35em;
    padding: 0.85em 1.3em 0.55em 0.55em; border-radius: 0.25em; background: #F4F0E8; color: #0B0A0E;
  }
  [data-ui] .tb-aj-l { font-weight: 600; }
  [data-ui] .tb-sw { position: relative; display: block; width: 2.3em; height: 1.3em; border-radius: 0.65em; background: #CFC6B8; overflow: hidden; }
  [data-ui] .tb-sw-on { position: absolute; inset: 0; background: #E4121F; }
  [data-ui] .tb-sw-k { position: absolute; top: 0.14em; left: 0.14em; width: 1.02em; height: 1.02em; border-radius: 50%; background: #fff; transform: translateX(1em); }

  /* llaves: las teclas < / > como teclas físicas (cara y base planas, sin sombra) */
  [data-ui] .tb-teclas { position: absolute; top: -0.15em; right: -0.45em; display: flex; gap: 0.14em; }
  [data-ui] .tb-tecla { display: block; width: 1.2em; padding-bottom: 0.12em; border-radius: 0.18em; background: #B9B0A2; }
  [data-ui] .tb-tecla > span {
    display: grid; place-items: center; height: 1.15em; border-radius: 0.16em; background: #FBF8F2; color: #0B0A0E;
    font-family: var(--font-bricolage), sans-serif; font-weight: 800; font-size: 1em;
  }
  [data-ui] .tb-tecla.is-roja { background: #9E0B15; }
  [data-ui] .tb-tecla.is-roja > span { background: #E4121F; color: #fff; }

  /* estado: respuesta del servidor con un punto verde */
  [data-ui] .tb-estado {
    position: absolute; top: -0.3em; right: -0.7em; display: flex; align-items: center; gap: 0.35em;
    padding: 0.5em 1.25em 0.4em 0.5em; border-radius: 0.22em; background: #0B0A0E; color: #F4F0E8;
  }
  [data-ui] .tb-estado code { font-family: var(--font-jetbrains), monospace; font-size: 0.8em; font-weight: 500; }
  [data-ui] .tb-punto { flex: none; width: 0.42em; height: 0.42em; border-radius: 50%; background: #2BD576; }

  /* discos: Ventas, Agenda y WhatsApp, juntos */
  [data-ui] .tb-discos { position: absolute; top: -0.2em; right: -0.5em; display: flex; }
  [data-ui] .tb-d {
    display: grid; place-items: center; width: 1.5em; height: 1.5em; border-radius: 50%; border: 0.09em solid #E4DDD0;
    font-family: var(--font-bricolage), sans-serif; font-weight: 800; font-size: 1em; line-height: 1;
  }
  [data-ui] .tb-d + .tb-d { margin-left: -0.42em; }
  [data-ui] .tb-d1 { background: #0B0A0E; color: #F4F0E8; }
  [data-ui] .tb-d2 { background: #E4121F; color: #fff; }
  [data-ui] .tb-d3 { background: #FF6A2C; color: #0B0A0E; }

  /* direccion: barra del navegador con la web del cliente y el cursor de texto */
  [data-ui] .tb-dir {
    position: absolute; top: -0.25em; right: -1.2em; display: flex; align-items: center; gap: 0.3em; width: 8.6em;
    padding: 0.5em 1.4em 0.4em 0.5em; border-radius: 0.3em; background: #F4F0E8; color: #0B0A0E; font-size: 1em;
  }
  [data-ui] .tb-candado { flex: none; width: 0.62em; height: 0.62em; }
  [data-ui] .tb-url { font-weight: 600; white-space: nowrap; }
  [data-ui] .tb-caret { flex: none; width: 0.06em; height: 1em; margin-left: 0.03em; background: #E4121F; animation: tb-parpadeo 1.05s steps(1) infinite; }
  @keyframes tb-parpadeo { 50% { opacity: 0; } }

  /* deslizador: corre de borde a borde; la perilla se desplaza */
  [data-ui].tb-ui--deslizador { left: 0; }
  [data-ui] .tb-desl { position: absolute; top: 0.55em; left: -0.6em; right: -0.6em; height: 1em; }
  [data-ui] .tb-pista { position: absolute; top: 0.37em; left: 0; right: 0; height: 0.26em; border-radius: 0.13em; background: #A50D17; overflow: hidden; }
  [data-ui] .tb-lleno { position: absolute; inset: 0; background: #F4F0E8; transform-origin: left; transform: scaleX(0.62); }
  [data-ui] .tb-mov { position: absolute; inset: 0; transform: translateX(62%); }
  [data-ui] .tb-perilla { position: absolute; top: 0; left: -0.5em; width: 1em; height: 1em; border-radius: 50%; background: #F4F0E8; }

  /* cursor: el puntero llega al «+» */
  [data-ui] .tb-cur { position: absolute; top: -0.3em; right: -0.3em; width: 3.4em; height: 2.1em; }
  [data-ui] .tb-mas {
    position: absolute; top: 0; right: 0; display: grid; place-items: center; width: 1.5em; height: 1.5em; border-radius: 0.25em;
    background: #0B0A0E; color: #F4F0E8; font-family: var(--font-bricolage), sans-serif; font-weight: 800; font-size: 1em; line-height: 1;
  }
  [data-ui] .tb-flecha { position: absolute; top: 0.8em; right: 1em; width: 0.8em; height: 1.04em; }

  @media (prefers-reduced-motion: reduce) {
    [data-ui].tb-ui { transition: none; }
    .tb-b:hover [data-ui].tb-ui { transform: none; }
    [data-ui] .tb-caret { animation: none; }
  }
</style>

<script>
  import { gsap } from '../../scripts/motion';

  const sec = document.querySelector<HTMLElement>('[data-tablero]');
  if (sec) {
    const bloques = Array.from(sec.querySelectorAll<HTMLElement>('.tb-b'));

    // Cada detalle: estado inicial y su animación de entrada (en pausa hasta que el bloque entra)
    const entrada = (b: HTMLElement): gsap.core.Timeline => {
      const q = gsap.utils.selector(b);
      const tl = gsap.timeline({ paused: true, delay: 0.25, defaults: { ease: 'power3.out' } });
      switch (b.dataset.el) {
        case 'burbuja':
          tl.from(q('.tb-burbuja'), { xPercent: 30, autoAlpha: 0, duration: 0.7 })
            .from(q('.tb-azul'), { autoAlpha: 0, duration: 0.3 }, '+=0.5');
          break;
        case 'interruptor':
          tl.from(q('.tb-ajuste'), { yPercent: -20, autoAlpha: 0, duration: 0.6 })
            .from(q('.tb-sw-on'), { autoAlpha: 0, duration: 0.3 }, '+=0.35')
            .from(q('.tb-sw-k'), { x: 0, duration: 0.45, ease: 'power2.inOut', clearProps: 'transform' }, '<');
          break;
        case 'llaves':
          tl.from(q('.tb-tecla'), { yPercent: -70, autoAlpha: 0, duration: 0.5, stagger: 0.09 })
            .to(q('.tb-tecla.is-roja > span'), { yPercent: 9, duration: 0.12, ease: 'power1.in', yoyo: true, repeat: 1 }, '+=0.15');
          break;
        case 'estado':
          tl.from(q('.tb-estado'), { xPercent: 25, autoAlpha: 0, duration: 0.6 })
            .from(q('.tb-punto'), { scale: 0, duration: 0.4, ease: 'back.out(3)' }, '-=0.15')
            .to(q('.tb-punto'), { scale: 0.7, duration: 0.8, ease: 'sine.inOut', yoyo: true, repeat: -1 });
          break;
        case 'discos':
          tl.from(q('.tb-d'), { autoAlpha: 0, scale: 0.6, duration: 0.45, stagger: 0.08 })
            .from(q('.tb-d1'), { xPercent: -45, duration: 0.6, ease: 'power3.inOut' }, '+=0.1')
            .from(q('.tb-d3'), { xPercent: 45, duration: 0.6, ease: 'power3.inOut' }, '<');
          break;
        case 'direccion': {
          const url = q('.tb-url')[0] as HTMLElement | undefined;
          const texto = url?.dataset.url ?? '';
          const n = { v: 0 };
          tl.from(q('.tb-dir'), { xPercent: 12, autoAlpha: 0, duration: 0.6 })
            .to(n, {
              v: texto.length, duration: 0.9, ease: 'none',
              onStart: () => { if (url) url.textContent = ''; },
              onUpdate: () => { if (url) url.textContent = texto.slice(0, Math.round(n.v)); },
            });
          if (url) url.textContent = '';
          break;
        }
        case 'deslizador':
          tl.fromTo(q('.tb-mov'), { x: 0, xPercent: 15 }, { x: 0, xPercent: 62, duration: 1.1, ease: 'power3.inOut', clearProps: 'transform' })
            .fromTo(q('.tb-lleno'), { scaleX: 0.15 }, { scaleX: 0.62, duration: 1.1, ease: 'power3.inOut', clearProps: 'transform' }, '<');
          break;
        case 'cursor':
          tl.from(q('.tb-flecha'), { xPercent: -260, yPercent: 90, autoAlpha: 0, duration: 0.9, ease: 'power2.inOut' })
            .to(q('.tb-mas'), { scale: 0.88, duration: 0.1, ease: 'power1.in', yoyo: true, repeat: 1 });
          break;
      }
      return tl;
    };

    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const lineas = new Map<Element, gsap.core.Timeline>();
      bloques.forEach((b) => {
        const tl = entrada(b);
        tl.progress(0); // aplica el estado inicial
        lineas.set(b, tl);
      });
      // Una vez, al entrar en pantalla (IntersectionObserver, como el resto de la página)
      const io = new IntersectionObserver((entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting && e.boundingClientRect.top > 0) continue;
          io.unobserve(e.target);
          lineas.get(e.target)?.play();
        }
      }, { rootMargin: '0px 0px -12% 0px' });
      bloques.forEach((b) => io.observe(b));
      return () => {
        io.disconnect();
        lineas.forEach((tl) => tl.revert());
        const url = sec.querySelector<HTMLElement>('.tb-url');
        if (url) url.textContent = url.dataset.url ?? '';
      };
    });
  }
</script>
