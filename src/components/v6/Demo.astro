---
// La pieza viva, «Pruébalo tú»: una demo de RebelBot con su ficha y controles. A la izquierda, el chat de
// WhatsApp; a la derecha, la ficha del negocio de ejemplo con un interruptor por dato. Si el dato está en la
// ficha, RebelBot responde y la fila se ilumina en ámbar; si está apagado, no lo inventa: pasa a un asesor.
// Sin JS: el chat queda con una pregunta respondida y una derivada, y la ficha sin controles.
import Chat from './ui/Chat.astro';
import { demo } from '../../data/v6';
import { contacto } from '../../data/contacto';

// Lo que contesta el asesor cuando el dato no está en la ficha (texto propio de la demo, ilustrativo)
const asesor: Record<string, string> = {
  disponible: 'Hola, te escribo del equipo de ventas. Te confirmo que sigue disponible.',
  precio: 'Hola, te confirmo el precio: S/ 385 000. ¿Te paso las opciones de pago?',
  area: 'Hola, te confirmo: son 72 m², con 2 dormitorios.',
  visitas: 'Hola, sí: las visitas son los sábados de 10:00 a 13:00. ¿A qué hora te acomoda?',
  estacionamiento: 'Hola, te confirmo que incluye un estacionamiento.',
};
const respuestaAsesor = (f: (typeof demo.filas)[number]) => asesor[f.k] ?? f.a;

// Conversación estática (sin JS): la primera pregunta respondida y la primera sin dato, derivada
const primera = demo.filas[0];
const derivada = demo.filas.find((f) => !f.on);
const enFicha = demo.filas.filter((f) => f.on).length;
---
<section id="demo" class="dm marco" aria-labelledby="dm-h2" data-demo data-deriva={demo.deriva} data-aviso={demo.aviso}>
  <div class="rejilla dm-rej">
    <div class="dm-cab">
      <h2 id="dm-h2" class="dm-h2" data-reveal>{demo.titulo}</h2>
      <p class="dm-frase" data-reveal>{demo.frase}</p>
    </div>

    <div class="bloque t-tinta dm-panel" data-reveal>
      <div class="dm-chat">
        <Chat mensajes={[]} vivo etiqueta="Chat de WhatsApp con RebelBot: toca una pregunta de la ficha y mira cómo responde">
          <div class="wa6-m wa6-m--out">
            <p class="wa6-b"><span class="sr-only">RebelBot: </span>{demo.saludo}<span class="wa6-hora" aria-hidden="true">23:14</span></p>
          </div>
          <div class="wa6-m wa6-m--in">
            <p class="wa6-b"><span class="sr-only">Tú: </span>{primera.q}<span class="wa6-hora" aria-hidden="true">23:14</span></p>
          </div>
          <div class="wa6-m wa6-m--out">
            <p class="wa6-b"><span class="sr-only">RebelBot: </span>{primera.a}<span class="wa6-hora" aria-hidden="true">23:14</span></p>
          </div>
          {derivada && (
            <div class="dm-par" data-sin-js>
              <div class="wa6-m wa6-m--in">
                <p class="wa6-b"><span class="sr-only">Tú: </span>{derivada.q}<span class="wa6-hora" aria-hidden="true">23:15</span></p>
              </div>
              <div class="wa6-m wa6-m--out">
                <p class="wa6-b"><span class="sr-only">RebelBot: </span>{demo.deriva}<span class="wa6-hora" aria-hidden="true">23:15</span></p>
              </div>
              <p class="wa6-sis">{demo.aviso}</p>
              <div class="wa6-m wa6-m--agent">
                <p class="wa6-b"><span class="wa6-quien">Asesor</span>{respuestaAsesor(derivada)}<span class="wa6-hora" aria-hidden="true">23:16</span></p>
              </div>
            </div>
          )}
          <div class="wa6-m wa6-m--out" data-escribe hidden aria-hidden="true"><span class="wa6-escribiendo"><i></i><i></i><i></i></span></div>
        </Chat>
      </div>

      <p class="dm-agenda">
        <a class="enlace6 dm-link" href={contacto.whatsappLink} target="_blank" rel="noopener">Agenda una demo con tus datos</a>
      </p>

      <div data-ui class="dm-ficha">
        <div class="dm-ficha-cab">
          <p class="dm-negocio">{demo.negocio}</p>
          <p class="dm-col" data-js hidden>En la ficha</p>
        </div>
        <ul class="dm-filas" role="list" aria-label="Ficha del negocio de ejemplo">
          {demo.filas.map((f) => (
            <li
              class:list={['dm-fila', { 'is-off': !f.on, 'is-usada': f.k === primera.k, 'is-falta': f.k === derivada?.k }]}
              data-fila={f.k}
            >
              <p class="dm-dato">
                <span class="dm-l">{f.l}</span>
                <span class="dm-v">{f.v}</span>
                <span class="sr-only" data-fuera hidden={f.on}>(fuera de la ficha)</span>
              </p>
              <button type="button" class="dm-q" data-q={f.k} data-a={f.a} data-asesor={respuestaAsesor(f)} data-js hidden>{f.q}</button>
              <button
                type="button"
                role="switch"
                class="dm-sw"
                aria-checked={f.on ? 'true' : 'false'}
                aria-label={`${f.l} en la ficha`}
                data-sw={f.k}
                data-js
                hidden
              >
                <span class="dm-pista" aria-hidden="true"><span class="dm-perilla"></span></span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="dm-instr" data-reveal>{demo.instruccion}</p>

    <div class="bloque t-rojo dm-leyenda" data-reveal>
      <div><p class="dm-ley">No inventa.</p><p class="dm-ley-d">Si un dato no está en la ficha, RebelBot no lo responde: llama a un asesor.</p></div>
      <p class="dm-cuenta"><span class="dm-num" data-cuenta>{enFicha}</span> de {demo.filas.length} datos en la ficha</p>
    </div>
  </div>
</section>

<style>
  .dm { padding-block: calc(var(--sec) / 2); }
  .dm-rej { row-gap: var(--gap); }
  .dm-cab { grid-column: 1 / 7; grid-row: 1; margin-bottom: clamp(24px, 3vw, 40px); }
  .dm-h2 { margin: 0; font-size: var(--t-2); }
  .dm-frase { margin: 16px 0 0; max-width: 46ch; font-size: 17px; }

  /* El panel: chat (62 %) y ficha (38 %), dos tonos del oscuro de la marca */
  .dm-panel { grid-column: 1 / 11; grid-row: 2; display: grid; grid-template-columns: 62fr 38fr; grid-template-rows: minmax(0, 1fr) auto; }
  .dm.is-vivo .dm-panel { height: 640px; }
  .dm-chat { grid-area: 1 / 1 / 2 / 2; display: flex; flex-direction: column; min-height: 0; padding: 20px 20px 0; background: var(--surface); }
  .dm-chat :global([data-ui].wa6) { flex: 1; min-height: 0; border-radius: var(--r); overflow: hidden; font-size: 16px; }
  .dm-chat :global(.wa6-b) { max-width: min(84%, 30em); }
  .dm.is-vivo .dm-chat :global(.wa6-log) { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  .dm-par { display: flex; flex-direction: column; gap: 0.4em; }

  .dm-agenda { grid-area: 2 / 1 / 3 / 2; margin: 0; padding: 4px 20px 12px; background: var(--surface); }
  .dm-link { display: inline-flex; align-items: center; min-height: 44px; color: #F4F0E8; font-weight: 600; }

  /* La ficha del negocio: una pieza del producto (colores fijos: dentro de data-ui la tinta es clara) */
  [data-ui].dm-ficha { grid-area: 1 / 2 / 3 / 3; min-width: 0; padding: 24px 20px; background: var(--surface-2); color: #F4F0E8; font-size: 16px; line-height: 1.3; overflow-y: auto; }
  [data-ui] .dm-ficha-cab { display: flex; align-items: end; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  [data-ui] .dm-negocio { margin: 0; font-size: var(--t-3); font-weight: 600; line-height: 1.2; }
  [data-ui] .dm-col { flex: none; margin: 0; color: #A7A0A8; font-size: 15px; }
  [data-ui] .dm-filas { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }

  [data-ui] .dm-fila {
    position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: 8px;
    min-height: 44px; padding: 6px 4px 6px 12px; border-radius: var(--r); overflow: hidden;
  }
  /* Fondo de la fila: hover suave, ámbar si respondió, hueso si faltaba el dato (solo opacity y transform) */
  [data-ui] .dm-fila::before {
    content: ''; position: absolute; inset: 0; z-index: -1; background: #2A2432; opacity: 0;
    transform-origin: left; transition: opacity 0.3s var(--ease), transform 0.45s var(--ease);
  }
  [data-ui] .dm-fila:hover::before { opacity: 1; }
  [data-ui] .dm-fila.is-usada::before { background: var(--ambar); opacity: 1; }
  [data-ui] .dm-fila.is-falta::before { background: var(--hueso); opacity: 1; }
  [data-ui] .dm-fila.is-usada, [data-ui] .dm-fila.is-falta { color: #0B0A0E; }

  [data-ui] .dm-dato { grid-column: 1; margin: 0; display: flex; flex-wrap: wrap; column-gap: 0.5em; }
  [data-ui] .dm-l { font-weight: 600; }
  [data-ui] .dm-v { text-decoration: line-through transparent; text-decoration-thickness: 2px; transition: text-decoration-color 0.25s; }
  [data-ui] .dm-fila.is-off .dm-v { color: #A7A0A8; text-decoration-color: currentColor; }
  [data-ui] .dm-fila.is-off.is-falta .dm-v, [data-ui] .dm-fila.is-off.is-usada .dm-v { color: #4F4954; }

  /* La pregunta: toda la fila es el botón (su capa la cubre), el interruptor queda encima a la derecha */
  [data-ui] .dm-q {
    grid-column: 1; margin: 2px 0 0; padding: 0; border: 0; background: none; color: #53BDEB; font: inherit; font-weight: 600;
    text-align: left; cursor: pointer; touch-action: manipulation;
  }
  [data-ui] .dm-q::after { content: ''; position: absolute; inset: 0; border-radius: var(--r); }
  [data-ui] .dm-q:focus-visible { outline: none; }
  [data-ui] .dm-q:focus-visible::after { outline: 3px solid var(--accent-text); outline-offset: -3px; }
  [data-ui] .dm-fila:has(.dm-q:active) { transform: scale(0.985); }
  [data-ui] .dm-fila { transition: transform 0.2s var(--ease); }
  [data-ui] .dm-fila.is-usada .dm-q, [data-ui] .dm-fila.is-falta .dm-q { color: #0B0A0E; }

  /* El interruptor: botón real de 44 px con su pista y perilla */
  [data-ui] .dm-sw {
    position: relative; z-index: 1; grid-column: 2; grid-row: 1 / span 2; display: grid; place-items: center; width: 52px; height: 44px;
    padding: 0; border: 0; border-radius: var(--r); background: none; cursor: pointer; touch-action: manipulation;
  }
  [data-ui] .dm-sw[hidden] { display: none; }
  [data-ui] .dm-pista { position: relative; display: block; width: 40px; height: 24px; border-radius: 12px; background: #3A3342; overflow: hidden; }
  [data-ui] .dm-pista::before { content: ''; position: absolute; inset: 0; background: var(--rojo); opacity: 0; transition: opacity 0.25s; }
  [data-ui] .dm-perilla {
    position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #F4F0E8;
    transition: transform 0.3s var(--ease);
  }
  [data-ui] .dm-sw[aria-checked='true'] .dm-pista::before { opacity: 1; }
  [data-ui] .dm-sw[aria-checked='true'] .dm-perilla { transform: translateX(16px); }
  [data-ui] .dm-sw:active .dm-perilla { transform: scale(0.9); }
  [data-ui] .dm-sw[aria-checked='true']:active .dm-perilla { transform: translateX(16px) scale(0.9); }
  [data-ui] .dm-sw:focus-visible { outline: 3px solid var(--accent-text); outline-offset: -2px; }

  .dm-instr { grid-column: 1 / 11; grid-row: 3; margin: 12px 0 0; font-size: var(--t-body); }

  /* La leyenda: bloque rojo alto con la regla de la demo y el conteo en vivo */
  .dm-leyenda { grid-column: 11 / 13; grid-row: 2; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: 24px; }
  .dm-ley { margin: 0; font-family: var(--font-bricolage), sans-serif; font-weight: 800; font-size: var(--t-2); line-height: 1.02; letter-spacing: -0.03em; }
  .dm-ley-d { margin: 12px 0 0; font-size: var(--t-body); line-height: 1.4; }
  .dm-cuenta { margin: 0; font-size: var(--t-body); font-weight: 600; line-height: 1.3; }
  .dm-num { display: block; font-family: var(--font-bricolage), sans-serif; font-weight: 800; font-size: var(--t-1); line-height: 0.9; letter-spacing: -0.04em; }

  @media (max-width: 899px) {
    .dm-cab, .dm-panel, .dm-instr, .dm-leyenda { grid-column: 1 / -1; grid-row: auto; }
    .dm-panel { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; }
    .dm.is-vivo .dm-panel { height: auto; }
    .dm-chat { grid-area: auto; aspect-ratio: 4 / 3; padding: 12px 12px 0; }
    .dm-chat :global([data-ui].wa6) { font-size: 15px; }
    [data-ui].dm-ficha { grid-area: auto; padding: 20px 12px; overflow: visible; }
    .dm-agenda { grid-area: auto; order: 3; padding: 4px 16px 12px; }
    [data-ui] .dm-fila { min-height: 52px; }
    .dm-instr { margin: 4px 0 8px; }
    .dm-leyenda { flex-direction: row; align-items: end; }
    .dm-ley { max-width: 14ch; }
    .dm-cuenta { text-align: right; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ui] .dm-fila, [data-ui] .dm-fila::before, [data-ui] .dm-perilla, [data-ui] .dm-pista::before { transition: none; }
  }
</style>

<script>
  import { gsap, reduceMotion } from '../../scripts/motion';

  const CHECK = '<svg viewBox="0 0 18 12" width="16" height="11"><path d="m1 6.5 3.5 3.5L11 3.5M7 9.5l.5.5L14 3.5" fill="none" stroke="#53bdeb" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>';

  const sec = document.querySelector<HTMLElement>('[data-demo]');
  const log = sec?.querySelector<HTMLElement>('.wa6-log');
  const escribe = sec?.querySelector<HTMLElement>('[data-escribe]');

  if (sec && log && escribe) {
    const filas = Array.from(sec.querySelectorAll<HTMLElement>('[data-fila]'));
    const cuenta = sec.querySelector<HTMLElement>('[data-cuenta]');
    const deriva = sec.dataset.deriva ?? '';
    const aviso = sec.dataset.aviso ?? '';

    // Con JS: sale la conversación derivada estática y aparecen los controles
    sec.querySelectorAll('[data-sin-js]').forEach((el) => el.remove());
    sec.querySelectorAll<HTMLElement>('[data-js]').forEach((el) => { el.hidden = false; });
    filas.forEach((f) => f.classList.remove('is-falta'));
    sec.classList.add('is-vivo');
    log.tabIndex = 0;
    log.setAttribute('data-lenis-prevent', '');

    const ahora = () => {
      const d = new Date();
      return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    };
    const bajar = () => log.scrollTo({ top: log.scrollHeight, behavior: reduceMotion ? 'auto' : 'smooth' });
    const entrar = (el: HTMLElement) => {
      if (!reduceMotion) gsap.fromTo(el, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.45, ease: 'power3.out', clearProps: 'transform' });
    };
    // Todo mensaje nuevo entra antes del «escribiendo…», que siempre va al final
    const poner = (el: HTMLElement) => { log.insertBefore(el, escribe); entrar(el); bajar(); };
    const escribiendo = (si: boolean) => { escribe.hidden = !si; if (si) bajar(); };

    const burbuja = (tipo: 'in' | 'out' | 'agent', texto: string) => {
      const m = document.createElement('div');
      m.className = `wa6-m wa6-m--${tipo}`;
      const b = document.createElement('p');
      b.className = 'wa6-b';
      const quien = document.createElement('span');
      if (tipo === 'agent') { quien.className = 'wa6-quien'; quien.textContent = 'Asesor'; }
      else { quien.className = 'sr-only'; quien.textContent = tipo === 'in' ? 'Tú: ' : 'RebelBot: '; }
      const hora = document.createElement('span');
      hora.className = 'wa6-hora';
      hora.setAttribute('aria-hidden', 'true');
      hora.textContent = ahora();
      if (tipo === 'in') hora.insertAdjacentHTML('beforeend', CHECK);
      b.append(quien, texto, hora);
      m.append(b);
      return m;
    };
    const sistema = (texto: string) => {
      const p = document.createElement('p');
      p.className = 'wa6-sis';
      p.textContent = texto;
      return p;
    };

    const marcar = (k: string, on: boolean) => {
      filas.forEach((f) => {
        const es = f.dataset.fila === k;
        f.classList.toggle('is-usada', es && on);
        f.classList.toggle('is-falta', es && !on);
      });
    };

    // Cola de pasos con pausa: una pregunta nueva termina al instante la anterior
    type Paso = { ms: number; hacer: () => void };
    let pasos: Paso[] = [];
    let reloj = 0;
    const siguiente = () => {
      if (!pasos.length) return;
      reloj = window.setTimeout(() => { pasos.shift()?.hacer(); siguiente(); }, pasos[0].ms);
    };
    const vaciar = () => {
      window.clearTimeout(reloj);
      const resto = pasos;
      pasos = [];
      resto.forEach((p) => p.hacer());
    };

    const preguntar = (b: HTMLButtonElement) => {
      vaciar();
      const k = b.dataset.q ?? '';
      const fila = b.closest<HTMLElement>('[data-fila]');
      const on = fila?.querySelector('[data-sw]')?.getAttribute('aria-checked') === 'true';
      poner(burbuja('in', b.textContent?.trim() ?? ''));
      escribiendo(true);
      pasos = [{ ms: 600, hacer: () => { escribiendo(false); poner(burbuja('out', on ? b.dataset.a ?? '' : deriva)); marcar(k, on); } }];
      if (!on) pasos.push(
        { ms: 450, hacer: () => { poner(sistema(aviso)); escribiendo(true); } },
        { ms: 1100, hacer: () => { escribiendo(false); poner(burbuja('agent', b.dataset.asesor ?? '')); } },
      );
      siguiente();
    };

    const contar = () => {
      if (!cuenta) return;
      const n = sec.querySelectorAll('[data-sw][aria-checked="true"]').length;
      if (cuenta.textContent === String(n)) return;
      cuenta.textContent = String(n);
      if (!reduceMotion) gsap.fromTo(cuenta, { yPercent: 40, autoAlpha: 0 }, { yPercent: 0, autoAlpha: 1, duration: 0.4, ease: 'power3.out' });
    };

    const alternar = (s: HTMLButtonElement) => {
      const on = s.getAttribute('aria-checked') !== 'true';
      s.setAttribute('aria-checked', String(on));
      const fila = s.closest<HTMLElement>('[data-fila]');
      if (fila) {
        fila.classList.toggle('is-off', !on);
        fila.classList.remove('is-usada', 'is-falta'); // la fila cambió: su respuesta anterior ya no vale
        const fuera = fila.querySelector<HTMLElement>('[data-fuera]');
        if (fuera) fuera.hidden = on;
      }
      contar();
    };

    sec.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const s = t.closest<HTMLButtonElement>('[data-sw]');
      if (s) { alternar(s); return; }
      const b = t.closest<HTMLButtonElement>('[data-q]');
      if (b) preguntar(b);
    });
  }
</script>
