---
// «Frase de entrada sobre cuatro columnas»: un párrafo que abre como un texto y, debajo, cuatro columnas
// que responden quiénes somos, qué hacemos, cómo trabajamos y cómo hablarnos.
import { intro } from '../../data/v6';
---
<section class="in marco" aria-labelledby="in-h2">
  <h2 id="in-h2" class="in-h2" data-reveal>RebelDEV en cuatro respuestas</h2>
  <p class="in-lead" data-reveal>{intro.lead}</p>
  <div class="in-cols">
    {intro.columnas.map((c) => (
      <p class="in-col" data-reveal><strong>{c.t}</strong> {c.d}</p>
    ))}
  </div>
</section>

<style>
  .in { padding-block: calc(var(--sec) * 1.6) calc(var(--sec) * 0.8); }
  .in-h2 { font-size: var(--t-2); }
  .in-lead { margin-top: 28px; max-width: 62ch; font-size: clamp(22px, 2.2vw, 32px); line-height: 1.2; letter-spacing: -0.01em; }
  .in-cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin-top: 72px; align-items: start; }
  .in-col { font-size: var(--t-body); line-height: 1.5; color: var(--muted); }
  .in-col strong { color: var(--ink); font-weight: 600; }

  @media (max-width: 900px) {
    .in-cols { grid-template-columns: 1fr 1fr; row-gap: 40px; }
  }
  @media (max-width: 639px) {
    .in-lead { font-size: 22px; }
    .in-cols { grid-template-columns: 1fr; row-gap: 28px; margin-top: 48px; }
  }
</style>
