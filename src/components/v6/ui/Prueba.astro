---
// Fragmento de interfaz: la semana a prueba en producción. Siete días, cada uno con su estado,
// y el aviso de que todavía no se paga (ámbar = «a prueba», como en la versión 4).
const dias = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
---
<div data-ui class="pb">
  <div class="pb-cab">
    <p class="pb-titulo">Semana a prueba</p>
    <p class="pb-sub">En producción, antes de pagar</p>
  </div>

  <ul class="pb-dias">
    {dias.map((d) => (
      <li>
        <span class="pb-dia">{d}</span>
        <span class="pb-est">En producción</span>
        <span class="pb-ok"><span class="pb-punto" aria-hidden="true"></span>Sin incidentes</span>
      </li>
    ))}
  </ul>

  <div class="pb-aviso">
    <p class="pb-aviso-t">Todavía no pagas</p>
    <p class="pb-aviso-d">Después de la prueba, el pago se reparte en cuotas.</p>
  </div>
</div>

<style>
  [data-ui].pb {
    width: 100%; padding: 1.1em; background: var(--surface); color: var(--ink);
    font-family: var(--font-instrument), sans-serif; font-size: 15px; line-height: 1.35; letter-spacing: 0; text-align: left;
  }
  [data-ui] .pb-cab p { margin: 0; }
  [data-ui] .pb-titulo { font-weight: 600; font-size: 1.07em; }
  [data-ui] .pb-cab .pb-sub { margin-top: 0.2em; color: var(--muted); font-size: 0.87em; }

  [data-ui] .pb-dias { list-style: none; margin: 0.9em 0 0; padding: 0; display: grid; gap: 0.3em; font-size: 0.87em; }
  [data-ui] .pb-dias li { display: grid; grid-template-columns: 5.6em 1fr auto; align-items: center; gap: 0.6em; min-height: 2.5em; padding: 0 0.75em; border-radius: 0.4em; background: var(--surface-2); }
  [data-ui] .pb-dia { font-weight: 600; }
  [data-ui] .pb-est { color: var(--muted); }
  [data-ui] .pb-ok { display: inline-flex; align-items: center; gap: 0.4em; color: #4BD37B; }
  [data-ui] .pb-punto { width: 0.55em; height: 0.55em; border-radius: 50%; background: #4BD37B; }

  [data-ui] .pb-aviso { margin-top: 0.9em; padding: 0.75em 0.85em; border-radius: 0.5em; border: 1px solid var(--amber); }
  [data-ui] .pb-aviso p { margin: 0; }
  [data-ui] .pb-aviso-t { color: var(--amber); font-weight: 600; }
  [data-ui] .pb-aviso .pb-aviso-d { margin-top: 0.15em; font-size: 0.87em; }
</style>
