---
// Logotipo PROVISIONAL: «Rebel</DEV>» en texto, con los signos en rojo (L-5).
// Va solo, sin isotipo al lado. Cuando haya SVG definitivo, se cambia solo este archivo.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<span class:list={['logo', className]} aria-label="RebelDEV" translate="no">
  <span aria-hidden="true">Rebel<span class="sign">&lt;</span><span class="sign">/</span>DEV<span class="sign">&gt;</span></span>
</span>

<style>
  .logo {
    display: inline-flex; align-items: baseline;
    font-family: var(--font-display); font-weight: 800; letter-spacing: -0.035em; line-height: 1;
    white-space: nowrap;
  }
  .sign { color: var(--color-red); }
</style>
