---
// Servicios como índice tipográfico (versión 3): una fila enorme por especialidad, en vez de tarjetas.
// Escritorio con ratón: al pasar por una fila, su ícono animado (Glifo) aparece y sigue al cursor;
// las demás filas se apagan. Táctil o pantalla angosta: cada fila se abre con un toque (acordeón).
// Sin JavaScript o con «menos movimiento», todo se ve abierto, con el ícono junto al texto.
import Glifo from '../Glifo.astro';
import { servicios } from '../../data/estudio';
import { contacto } from '../../data/contacto';
---
<section id="servicios" class="wrap v3-sec ix" aria-labelledby="ix-title" data-ix>
  <h2 id="ix-title" class="text-d2 max-w-[18ch]">Lo que construimos, pieza por pieza.</h2>

  <ul class="ix-list" data-ix-list>
    {servicios.map((s, i) => (
      <li class="ix-row" data-ix-row data-g={s.g}>
        <h3 class="ix-h" data-ix-h><span class="ix-name">{s.t}</span></h3>
        <div class="ix-desc" id={`ix-d-${i}`} data-ix-desc>
          <div class="ix-desc-in">
            <Glifo id={s.g} class="ix-glifo" />
            <p class="text-body text-ash">{s.d}</p>
          </div>
        </div>
      </li>
    ))}
    <li class="ix-row ix-otro" data-ix-row>
      <h3 class="ix-h" data-ix-h><span class="ix-name">¿Algo más?</span></h3>
      <div class="ix-desc" id={`ix-d-${servicios.length}`} data-ix-desc>
        <div class="ix-desc-in">
          <p class="text-body text-ash">Si implica software, probablemente podemos construirlo. <a href={contacto.whatsappLink} target="_blank" rel="noopener" class="ix-link">Conversemos</a></p>
        </div>
      </div>
    </li>
  </ul>

  <!-- Ícono flotante que sigue al cursor (solo escritorio con ratón) -->
  <div class="ix-float" data-ix-float aria-hidden="true">
    {servicios.map((s) => <div class="ix-float-g" data-ix-fg={s.g}><Glifo id={s.g} /></div>)}
  </div>
</section>

<style>
  .ix { position: relative; }
  .ix-list { list-style: none; margin: clamp(3rem, 6vw, 5rem) 0 0; padding: 0; border-bottom: 1px solid var(--color-line); }
  .ix-row { border-top: 1px solid var(--color-line); }

  /* Fila: nombre enorme a la izquierda; la descripción a la derecha en escritorio */
  .ix-h { margin: 0; font-size: clamp(2rem, 5.4vw, 5rem); line-height: 1; letter-spacing: -0.04em; }
  .ix-name { display: inline-flex; align-items: baseline; padding-block: clamp(1.1rem, 2.4vw, 1.9rem); transition: transform 0.6s var(--ease-out-expo), color 0.4s; }
  .ix-name::before {
    /* La barra roja de la marca entra delante del nombre activo */
    content: '/'; display: inline-block; width: 0; overflow: hidden; color: var(--color-red-text); opacity: 0;
    transition: width 0.6s var(--ease-out-expo), opacity 0.3s;
  }
  .ix-desc-in { display: flex; gap: 1.25rem; align-items: flex-start; padding-bottom: 1.6rem; max-width: 46ch; }
  .ix-desc-in p { margin: 0; }
  .ix :global(svg.ix-glifo) { flex: none; width: 2.75rem; height: 2.75rem; }
  .ix-link { color: var(--color-red-text); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }

  @media (min-width: 900px) {
    .ix-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem); column-gap: 3rem; align-items: center; }
    .ix-desc-in { padding-block: 1rem; }
  }

  /* Con ratón (lo activa el script): el ícono flota y las filas se apagan alrededor de la activa */
  .ix-float { display: none; }
  .ix.has-float .ix-float {
    display: block; position: absolute; left: 0; top: 0; z-index: 2; width: 0; height: 0; pointer-events: none;
  }
  .ix-float-g {
    position: absolute; left: 1.5rem; top: -4.5rem; width: 7rem; height: 7rem; display: grid; place-items: center;
    border-radius: 1.5rem; background: var(--color-surface-2); border: 1px solid var(--color-line-strong); visibility: hidden;
  }
  .ix-float :global(svg.glifo) { width: 4rem; height: 4rem; }
  .ix.has-float :global(svg.ix-glifo) { display: none; }
  .ix.has-float .ix-row { cursor: default; }
  .ix.has-float .ix-desc-in p { transition: color 0.4s; }
  .ix.has-float .ix-list:has(.is-active) .ix-row:not(.is-active) .ix-name { color: var(--color-ash-dim); }
  .ix.has-float .ix-row.is-active .ix-name { transform: translateX(0.12em); }
  .ix.has-float .ix-row.is-active .ix-name::before { width: 0.62em; opacity: 1; }
  .ix.has-float .ix-row.is-active .ix-desc-in p { color: var(--color-bone); }

  /* Acordeón (táctil o angosto): el script convierte cada título en un botón */
  :global(.ix-btn) {
    all: unset; box-sizing: border-box; touch-action: manipulation; -webkit-tap-highlight-color: transparent; display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer;
  }
  :global(.ix-btn:active .ix-name) { color: var(--color-red-text); }
  :global(.ix-btn:focus-visible) { outline: 2px solid var(--color-red-text); outline-offset: -2px; border-radius: 4px; }
  :global(.ix-plus) { position: relative; flex: none; width: 1.1rem; height: 1.1rem; margin-right: 0.25rem; }
  :global(.ix-plus::before), :global(.ix-plus::after) {
    content: ''; position: absolute; left: 0; top: 50%; width: 100%; height: 2px; margin-top: -1px; border-radius: 2px; background: var(--color-bone);
    transition: transform 0.4s var(--ease-out-expo), background-color 0.3s;
  }
  :global(.ix-plus::after) { transform: rotate(90deg); }
  :global(.ix-btn[aria-expanded="true"] .ix-plus::after) { transform: rotate(0deg); }
  :global(.ix-btn[aria-expanded="true"] .ix-plus::before) { background: var(--color-red-text); }
  .ix.is-acc .ix-desc { overflow: hidden; }
  .ix.is-acc .ix-row.is-open .ix-name::before { width: 0.62em; opacity: 1; }
</style>

<script>
  import { gsap, reduceMotion } from '../../scripts/motion';
  import { glifoTl } from '../../scripts/glifos';

  const sec = document.querySelector<HTMLElement>('[data-ix]')!;
  const rows = Array.from(sec.querySelectorAll<HTMLElement>('[data-ix-row]'));
  const float = sec.querySelector<HTMLElement>('[data-ix-float]')!;

  if (!reduceMotion) {
    gsap.matchMedia().add({
      desk: '(min-width: 900px) and (hover: hover) and (pointer: fine)',
      acc: '(max-width: 899px), (hover: none), (pointer: coarse)',
    }, (ctx) => {
      if (ctx.conditions!.desk) {
        // El ícono flotante sigue al cursor con un poco de retraso; cada fila muestra el suyo y lo arma de nuevo.
        sec.classList.add('has-float');
        const fx = gsap.quickTo(float, 'x', { duration: 0.6, ease: 'power3.out' });
        const fy = gsap.quickTo(float, 'y', { duration: 0.6, ease: 'power3.out' });
        const tls = new Map<string, gsap.core.Timeline | null>();
        float.querySelectorAll<HTMLElement>('[data-ix-fg]').forEach((g) => tls.set(g.dataset.ixFg!, glifoTl(g.querySelector('svg'))));
        let shown: HTMLElement | null = null;

        const show = (g: string | undefined) => {
          const next = g ? float.querySelector<HTMLElement>(`[data-ix-fg="${g}"]`) : null;
          if (next === shown) return;
          if (shown) gsap.to(shown, { autoAlpha: 0, scale: 0.85, duration: 0.25, ease: 'power3.out', overwrite: true });
          if (next) {
            gsap.fromTo(next, { autoAlpha: 0, scale: 0.85 }, { autoAlpha: 1, scale: 1, duration: 0.45, ease: 'power3.out', overwrite: true });
            tls.get(g!)?.restart();
          }
          shown = next;
        };
        const activate = (row: HTMLElement | null) => {
          rows.forEach((r) => r.classList.toggle('is-active', r === row));
          show(row?.dataset.g);
        };

        const move = (e: PointerEvent) => {
          const r = sec.getBoundingClientRect();
          fx(e.clientX - r.left); fy(e.clientY - r.top);
        };
        const onLeave = () => activate(null);
        sec.addEventListener('pointermove', move);
        sec.addEventListener('pointerleave', onLeave);
        const enters = rows.map((row) => {
          const fn = () => activate(row);
          row.addEventListener('pointerenter', fn);
          return fn;
        });
        // Con el teclado: el enlace de «¿Algo más?» activa su fila.
        const focusIn = (e: FocusEvent) => activate((e.target as Element).closest<HTMLElement>('[data-ix-row]'));
        sec.addEventListener('focusin', focusIn);
        const focusOut = (e: FocusEvent) => { if (!sec.contains(e.relatedTarget as Node)) activate(null); };
        sec.addEventListener('focusout', focusOut);

        return () => {
          sec.classList.remove('has-float');
          rows.forEach((r, i) => { r.classList.remove('is-active'); r.removeEventListener('pointerenter', enters[i]); });
          sec.removeEventListener('pointermove', move);
          sec.removeEventListener('pointerleave', onLeave);
          sec.removeEventListener('focusin', focusIn);
          sec.removeEventListener('focusout', focusOut);
        };
      }

      // Acordeón: cada título se vuelve un botón que abre su descripción y arma su ícono.
      sec.classList.add('is-acc');
      const undo = rows.map((row) => {
        const h = row.querySelector<HTMLElement>('[data-ix-h]')!;
        const desc = row.querySelector<HTMLElement>('[data-ix-desc]')!;
        const name = h.querySelector('.ix-name')!;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ix-btn';
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-controls', desc.id);
        h.replaceChildren(btn);
        btn.append(name);
        btn.insertAdjacentHTML('beforeend', '<span class="ix-plus" aria-hidden="true"></span>');
        desc.hidden = true;
        const tl = glifoTl(desc.querySelector<SVGSVGElement>('[data-glifo]'));

        const toggle = () => {
          const open = btn.getAttribute('aria-expanded') !== 'true';
          btn.setAttribute('aria-expanded', String(open));
          row.classList.toggle('is-open', open);
          if (open) {
            desc.hidden = false;
            gsap.fromTo(desc, { height: 0 }, { height: 'auto', duration: 0.55, ease: 'expo.out', overwrite: true });
            tl?.restart();
          } else {
            gsap.to(desc, { height: 0, duration: 0.4, ease: 'power3.out', overwrite: true, onComplete: () => { desc.hidden = true; } });
          }
        };
        btn.addEventListener('click', toggle);

        return () => {
          btn.removeEventListener('click', toggle);
          h.replaceChildren(name);
          desc.hidden = false;
          gsap.set(desc, { clearProps: 'height' });
          row.classList.remove('is-open');
        };
      });
      return () => {
        undo.forEach((u) => u());
        sec.classList.remove('is-acc');
      };
    });
  }
</script>
