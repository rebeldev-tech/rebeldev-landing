---
// Cierre: las piezas sueltas de «Del caos al sistema» vuelven y, al bajar, arman un </> gigante
// (la barra en rojo). Después, la invitación a conversar. Sin JavaScript o con «menos movimiento»,
// el </> ya está armado.
// Las piezas son segmentos a lo largo de los tres trazos del isotipo (MARK), girados como su trazo:
// juntos se leen como el </> con trazo grueso y puntas redondas, hecho pieza por pieza.
import { MARK } from '../../lib/mark';
import { cierre } from '../../data/v3';
import { contacto } from '../../data/contacto';

const S = MARK.stroke;
const LARGO = S * 0.52, GROSOR = S * 0.9, PASO = S * 0.66;

const nums = (d: string) => (d.match(/-?\d+(?:\.\d+)?/g) ?? []).map(Number);
function piezasDe(d: string, rojo: boolean) {
  const n = nums(d);
  const pts: [number, number][] = [];
  for (let i = 0; i < n.length; i += 2) pts.push([n[i], n[i + 1]]);
  const out: { x: number; y: number; r: number; rojo: boolean }[] = [];
  pts.slice(1).forEach(([x1, y1], k) => {
    const [x0, y0] = pts[k];
    const len = Math.hypot(x1 - x0, y1 - y0);
    const ux = (x1 - x0) / len, uy = (y1 - y0) / len;
    const pasos = Math.max(1, Math.round(len / PASO));
    const ultimo = k === pts.length - 2;
    for (let j = 0; j <= pasos; j++) {
      if (j === pasos && !ultimo) continue; // el vértice lo pone el tramo siguiente
      const t = (j / pasos) * len;
      out.push({ x: x0 + ux * t, y: y0 + uy * t, r: (Math.atan2(uy, ux) * 180) / Math.PI, rojo });
    }
  });
  return out;
}

const pct = (v: number, total: number) => +((v / total) * 100).toFixed(3);
const chips = [...piezasDe(MARK.left, false), ...piezasDe(MARK.slash, true), ...piezasDe(MARK.right, false)].map((p) => ({
  ...p,
  // Centrado con márgenes (en % del ancho, como todo margen) para dejarle «transform» libre a GSAP.
  style: `left:${pct(p.x, MARK.width)}%;top:${pct(p.y, MARK.height)}%;width:${pct(LARGO, MARK.width)}%;height:${pct(GROSOR, MARK.height)}%;margin:${-pct(GROSOR / 2, MARK.width)}% 0 0 ${-pct(LARGO / 2, MARK.width)}%;--r:${p.r.toFixed(1)}deg`,
}));
---
<section id="contacto" class="wrap v3-sec ci" aria-labelledby="ci-title" data-ci>
  <div class="ci-mark" style={`aspect-ratio: ${MARK.width} / ${MARK.height}`} aria-hidden="true" data-ci-mark>
    {chips.map((c) => <span class:list={['ci-chip', { 'is-red': c.rojo }]} style={c.style} data-ci-chip><i></i></span>)}
  </div>

  <div class="ci-text" data-ci-text>
    <h2 id="ci-title" class="text-d1">{cierre.titulo}</h2>
    <p class="mt-6 max-w-[40ch] text-lead text-ash">{cierre.bajada}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={contacto.whatsappLink} target="_blank" rel="noopener" class="btn btn-primary" data-magnetic>Agenda una demo por WhatsApp</a>
      <a href={`mailto:${contacto.correo}`} class="btn btn-ghost">Escríbenos</a>
    </div>
  </div>
</section>

<style>
  .ci { overflow: clip; display: grid; gap: clamp(3rem, 6vw, 5rem); }
  @media (min-width: 1024px) {
    .ci { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; }
  }
  .ci-mark { position: relative; width: min(100%, 44rem); }
  /* Cada pieza: la caja la mueve GSAP; el segmento de adentro va girado como su trazo */
  .ci-chip { position: absolute; }
  .ci-chip i { position: absolute; inset: 0; border-radius: 22%; background: var(--color-bone); transform: rotate(var(--r)); }
  .ci-chip.is-red i { background: var(--color-red); }
  .ci-text h2 { max-width: 14ch; }
</style>

<script>
  import { gsap, reduceMotion } from '../../scripts/motion';

  if (!reduceMotion) {
    const chips = gsap.utils.toArray<HTMLElement>('[data-ci-chip]');
    const rnd = gsap.utils.random;

    // Las piezas llegan desde lejos, giradas, y encajan en su trazo mientras se baja.
    gsap.fromTo(chips, {
      x: () => rnd(-0.55, 0.55) * window.innerWidth,
      y: () => rnd(-0.45, 0.45) * window.innerHeight,
      rotation: () => rnd(-160, 160),
      autoAlpha: 0,
    }, {
      x: 0, y: 0, rotation: 0, autoAlpha: 1, ease: 'power3.out',
      stagger: { each: 0.012, from: 'random' },
      scrollTrigger: { trigger: '[data-ci-mark]', start: 'top 95%', end: 'center 50%', scrub: 1 },
    });

    // El texto entra una vez, cuando el </> ya casi está armado.
    gsap.fromTo('[data-ci-text] > *', { autoAlpha: 0, y: 24 }, {
      autoAlpha: 1, y: 0, duration: 1, ease: 'expo.out', stagger: 0.12,
      scrollTrigger: { trigger: '[data-ci-text]', start: 'top 82%', once: true },
    });
  }
</script>
