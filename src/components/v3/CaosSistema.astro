---
// «Del caos al sistema», el momento fuerte de la versión 3. Explica cómo trabaja RebelDEV:
// las piezas sueltas de un negocio (ejemplos ilustrativos, no clientes) flotan desordenadas,
// se conectan (el diagnóstico), se ordenan por capas con GSAP Flip y, al final, entra una pieza
// nueva sin mover el resto. En escritorio la sección se fija y el scroll avanza los cuatro pasos;
// en móvil no se fija: la animación avanza mientras el escenario pasa por la pantalla.
// Sin JavaScript o con «menos movimiento»: el sistema ya ordenado y los cuatro pasos a la vista.
import { pasosCaos, capas, piezas, piezaNueva } from '../../data/v3';
---
<section id="como" class="cs" data-cs aria-labelledby="cs-title">
  <h2 id="cs-title" class="sr-only">Cómo trabajamos</h2>
  <div class="wrap cs-grid">
    <ol class="cs-steps" data-cs-steps>
      {pasosCaos.map((p, i) => (
        <li class="cs-step" data-cs-step>
          <span class="cs-n text-note" aria-hidden="true">{i + 1}<span class="cs-of">/{pasosCaos.length}</span></span>
          <h3 class="text-d2 cs-t">{p.t}</h3>
          <p class="mt-4 text-lead text-ash cs-d">{p.d}</p>
        </li>
      ))}
    </ol>

    <div class="cs-stage" data-cs-stage aria-hidden="true">
      <div class="cs-chaos" data-cs-chaos></div>
      <svg class="cs-links" data-cs-links></svg>

      <div class="cs-order">
        {capas.map((c, ci) => (
          <div class="cs-row" data-cs-row>
            <p class="cs-label text-note" data-cs-label>{c.t}</p>
            <ul class="cs-slots">
              {piezas.filter((p) => p.capa === c.id).map((p) => (
                <li class="cs-slot">
                  <span class="pz" data-pz data-x={p.x} data-y={p.y} data-r={p.r} data-capa={p.capa}>
                    <span class="pz-dot"></span>
                    <span class="pz-txt"><span class="pz-a">{p.antes}</span><span class="pz-d">{p.despues}</span></span>
                  </span>
                </li>
              ))}
              {piezaNueva.capa === c.id && (
                <li class="cs-slot cs-slot-new" data-cs-new-slot>
                  <span class="pz pz-new" data-cs-new><span class="pz-dot"></span><span class="pz-txt"><span class="pz-d">{piezaNueva.t}</span></span></span>
                </li>
              )}
            </ul>
            {ci < capas.length - 1 && <span class="cs-wire" data-cs-wire></span>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .cs { position: relative; padding-block: clamp(5rem, 10vw, 8rem); }
  .cs-grid { display: grid; gap: 3rem; }
  .cs-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.5rem; }
  .cs-n { display: block; font-variant-numeric: tabular-nums; color: var(--color-red-text); margin-bottom: 0.9rem; }
  .cs-of { color: var(--color-ash-dim); }
  .cs-t { margin: 0; max-width: 18ch; }
  .cs-d { margin-bottom: 0; max-width: 40ch; }

  /* Escenario: por defecto, el sistema ordenado en cuatro capas */
  .cs-stage { position: relative; min-height: 26rem; }
  .cs-chaos { position: absolute; inset: 0; pointer-events: none; }
  .cs-links { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .cs-links :global(line) { stroke: var(--color-ash-dim); stroke-width: 1.25; }
  .cs-links :global(circle) { fill: var(--color-red-text); }
  .cs-order { position: relative; display: grid; gap: 1.6rem; }
  .cs-row { position: relative; display: grid; gap: 0.55rem; }
  .cs-label { margin: 0; color: var(--color-ash); }
  .cs-slots { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; }
  .cs-slot { min-height: 3.1rem; border-radius: 0.7rem; display: flex; }
  /* flex: none para que la ranura no apriete la pieza mientras todavía está «en el caos» */
  .cs-slot > .pz { flex: none; }
  .cs-slot-new { border: 1px dashed var(--color-line-strong); }
  /* Cable rojo entre capas: une el centro de una capa con la siguiente */
  .cs-wire { position: absolute; left: 50%; bottom: -1.6rem; width: 2px; height: 1.6rem; background: var(--color-red); transform-origin: top; }

  .pz {
    --amp: 0px;
    position: relative; display: flex; align-items: center; gap: 0.55rem; width: 100%;
    padding: 0.7rem 0.85rem; border-radius: 0.7rem; background: var(--color-surface); border: 1px solid var(--color-line-strong);
    font-size: 0.92rem; line-height: 1.25; color: var(--color-bone); white-space: normal;
  }
  .pz-dot { flex: none; width: 7px; height: 7px; border-radius: 99px; background: var(--color-red-text); }
  .pz-txt { display: grid; }
  .pz-a, .pz-d { grid-area: 1 / 1; }
  .pz-a { visibility: hidden; }
  .pz-new { border-color: color-mix(in srgb, var(--color-red) 60%, transparent); }

  /* En el caos: cada pieza flota a su ritmo (la amplitud la baja el script al ordenar) */
  .cs-chaos .pz { position: absolute; width: auto; max-width: 15rem; white-space: nowrap; }
  :global(.cs.is-chaos .pz-in-float) { animation: pz-float var(--dur, 5s) ease-in-out infinite alternate; }
  @keyframes pz-float { from { translate: 0 calc(var(--amp) * -1); } to { translate: 0 var(--amp); } }

  @media (min-width: 640px) {
    .cs-slots { gap: 0.65rem; }
    .pz { font-size: 0.98rem; }
  }
  @media (max-width: 639px) {
    .cs-slots { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cs-wire { display: none; }
  }

  /* Escritorio: dos columnas; con animación, la sección se fija y los pasos se turnan en el mismo lugar */
  @media (min-width: 1024px) {
    .cs-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(3rem, 6vw, 6rem); align-items: center; }
    :global(html.has-motion) .cs.is-pinned { height: 100vh; padding-block: 0; display: flex; align-items: center; }
    :global(html.has-motion) .cs.is-pinned .cs-steps { display: block; position: relative; min-height: 20rem; }
    :global(html.has-motion) .cs.is-pinned .cs-step { position: absolute; inset: 0 0 auto 0; }
    :global(html.has-motion) .cs.is-pinned .cs-stage { height: min(72vh, 40rem); }
    :global(html.has-motion) .cs.is-pinned .cs-order { position: absolute; inset: 0; align-content: center; }
  }
  /* Móvil con animación: el escenario queda pegado arriba y los pasos pasan por debajo;
     el que corresponde se enciende. Piezas más chicas para que las cuatro capas quepan. */
  .cs.is-mobile .cs-stage { order: -1; position: sticky; top: 4.25rem; z-index: 1; min-height: 0; padding-block: 0.75rem; background: var(--color-ink); }
  .cs.is-mobile .cs-order { gap: 0.9rem; }
  .cs.is-mobile .cs-slots { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.35rem; }
  .cs.is-mobile .cs-slot { min-height: 2.5rem; }
  .cs.is-mobile .pz { padding: 0.45rem 0.5rem; font-size: 0.74rem; gap: 0.35rem; border-radius: 0.5rem; }
  .cs.is-mobile .pz-dot { width: 5px; height: 5px; }
  .cs.is-mobile .cs-label { font-size: 0.75rem; }
  .cs.is-mobile .cs-chaos .pz { max-width: 9.5rem; }
  .cs.is-mobile .cs-steps { gap: 0; }
  .cs.is-mobile .cs-step { min-height: 55vh; padding-top: 1.5rem; transition: opacity 0.5s; }
  .cs.is-mobile .cs-step:not(.is-on) { opacity: 0.6; }
  .cs.is-mobile .cs-t { font-size: clamp(1.5rem, 6.4vw, 2rem); }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../../scripts/motion';
  import { Flip } from 'gsap/Flip';

  gsap.registerPlugin(Flip);

  const sec = document.querySelector<HTMLElement>('[data-cs]')!;
  const stage = sec.querySelector<HTMLElement>('[data-cs-stage]')!;
  const chaos = sec.querySelector<HTMLElement>('[data-cs-chaos]')!;
  const svg = sec.querySelector<SVGSVGElement>('[data-cs-links]')!;
  const steps = gsap.utils.toArray<HTMLElement>('[data-cs-step]', sec);
  const pieces = gsap.utils.toArray<HTMLElement>('[data-pz]', sec);
  const slots = pieces.map((p) => p.parentElement!);
  const newPiece = sec.querySelector<HTMLElement>('[data-cs-new]')!;
  const newSlot = sec.querySelector<HTMLElement>('[data-cs-new-slot]')!;
  const labels = sec.querySelectorAll('[data-cs-label]');
  const wires = sec.querySelectorAll('[data-cs-wire]');
  const NS = 'http://www.w3.org/2000/svg';

  // Las piezas flotan dentro de un envoltorio propio, para no pisar los transform de Flip.
  pieces.forEach((p, i) => {
    const inner = document.createElement('span');
    inner.className = 'pz-in-float';
    inner.style.cssText = `display:flex;align-items:center;gap:inherit;--dur:${4 + (i % 5) * 0.7}s;animation-delay:${-i * 0.6}s`;
    while (p.firstChild) inner.appendChild(p.firstChild);
    p.appendChild(inner);
  });

  // Une cada pieza con la siguiente de su misma capa: así se ve el «diagnóstico».
  function drawLinks() {
    svg.replaceChildren();
    const sr = stage.getBoundingClientRect();
    const center = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return { x: r.left - sr.left + r.width / 2, y: r.top - sr.top + r.height / 2 }; };
    const byCapa = new Map<string, HTMLElement[]>();
    pieces.forEach((p) => byCapa.set(p.dataset.capa!, [...(byCapa.get(p.dataset.capa!) ?? []), p]));
    byCapa.forEach((list) => list.slice(1).forEach((p, i) => {
      const s = center(list[i]), e = center(p);
      const l = document.createElementNS(NS, 'line');
      Object.entries({ x1: s.x, y1: s.y, x2: e.x, y2: e.y }).forEach(([k, v]) => l.setAttribute(k, String(v)));
      svg.appendChild(l);
      const c = document.createElementNS(NS, 'circle');
      Object.entries({ cx: e.x, cy: e.y, r: 3 }).forEach(([k, v]) => c.setAttribute(k, String(v)));
      svg.appendChild(c);
    }));
    return { lines: svg.querySelectorAll('line'), dots: svg.querySelectorAll('circle') };
  }

  function build(pinned: boolean) {
    sec.classList.add(pinned ? 'is-pinned' : 'is-mobile', 'is-chaos');

    // 1) Llevar las piezas al desorden y fotografiarlas ahí.
    const W = stage.clientWidth, H = stage.clientHeight;
    pieces.forEach((p) => chaos.appendChild(p));
    pieces.forEach((p) => {
      const x = (Number(p.dataset.x) / 100) * W, y = (Number(p.dataset.y) / 100) * H;
      gsap.set(p, { left: Math.max(0, Math.min(x, W - p.offsetWidth)), top: Math.max(0, Math.min(y, H - p.offsetHeight)), rotation: Number(p.dataset.r) });
    });
    gsap.set(sec.querySelectorAll('.pz-a'), { visibility: 'visible', autoAlpha: 1 });
    gsap.set(sec.querySelectorAll('[data-pz] .pz-d'), { autoAlpha: 0 });
    gsap.set(stage, { '--amp': pinned ? '7px' : '4px' });
    const { lines, dots } = drawLinks();
    const state = Flip.getState(pieces);

    // 2) Devolverlas a su lugar en el sistema; Flip anima desde el desorden.
    pieces.forEach((p, i) => { slots[i].appendChild(p); gsap.set(p, { clearProps: 'left,top', rotation: 0 }); });
    const flip = Flip.from(state, { duration: 1.6, ease: 'power3.inOut', stagger: { each: 0.04, from: 'random' }, absolute: true });

    gsap.set([labels, newSlot], { autoAlpha: 0 });
    gsap.set(wires, { scaleY: 0 });
    gsap.set(newPiece, { xPercent: 140, autoAlpha: 0 });

    // El paso activo sale del tiempo de la línea de tiempo (donde empieza cada frase).
    const starts = [1.1, 3.1, 5.5];
    const show = (k: number) => steps.forEach((s, i) => s.classList.toggle('is-on', i === k));
    const sync = () => show(starts.filter((t0) => tl.time() >= t0).length);
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: pinned
        ? { trigger: sec, start: 'top top', end: '+=360%', pin: true, scrub: 0.7, refreshPriority: 1,
            onUpdate: () => sync() }
        : { trigger: sec.querySelector('[data-cs-steps]'), start: 'top 70%', end: 'bottom 75%', scrub: 0.7,
            onUpdate: () => sync() },
    });

    if (pinned) {
      // Solo opacidad (no visibility): los lectores de pantalla siguen leyendo los cuatro pasos.
      gsap.set(steps.slice(1), { opacity: 0, y: 30 });
      const swap = (from: number, at: number) => tl
        .to(steps[from], { opacity: 0, y: -30, duration: 0.35, ease: 'power2.in' }, at)
        .to(steps[from + 1], { opacity: 1, y: 0, duration: 0.45, ease: 'power3.out' }, at + 0.3);
      swap(0, 0.8); swap(1, 2.8); swap(2, 5.2);
    }

    // Paso 2: el diagnóstico conecta las piezas de cada capa.
    tl.fromTo(lines, { drawSVG: '0% 0%' }, { drawSVG: '0% 100%', duration: 0.8, stagger: 0.05 }, 1.2)
      .fromTo(dots, { scale: 0, transformOrigin: '50% 50%' }, { scale: 1, duration: 0.3, stagger: 0.05 }, 1.5)
      // Paso 3: se ordenan por capas y cada una toma su nombre.
      .to([lines, dots], { autoAlpha: 0, duration: 0.4 }, 2.9)
      .to(stage, { '--amp': '0px', duration: 0.6 }, 2.9)
      .add(flip, 3.0)
      .to(sec.querySelectorAll('[data-pz] .pz-a'), { autoAlpha: 0, duration: 0.4 }, 3.6)
      .to(sec.querySelectorAll('[data-pz] .pz-d'), { autoAlpha: 1, duration: 0.4 }, 3.8)
      .to(labels, { autoAlpha: 1, duration: 0.5, stagger: 0.1 }, 4.1)
      .to(wires, { scaleY: 1, duration: 0.4, stagger: 0.12 }, 4.4)
      // Paso 4: llega una pieza nueva y encaja sin mover el resto.
      .to(newSlot, { autoAlpha: 1, duration: 0.3 }, 5.4)
      .to(newPiece, { xPercent: 0, autoAlpha: 1, duration: 0.8, ease: 'power3.out' }, 5.6)
      .to(newSlot, { borderColor: 'transparent', duration: 0.3 }, 6.4)
      .to({}, { duration: 0.8 });
    show(0);

    return () => {
      flip.kill();
      pieces.forEach((p, i) => { slots[i].appendChild(p); });
      svg.replaceChildren();
      gsap.set(pieces, { clearProps: 'all' });
      sec.classList.remove('is-pinned', 'is-mobile', 'is-chaos');
      steps.forEach((s) => s.classList.remove('is-on'));
    };
  }

  if (!reduceMotion) {
    document.fonts.ready.then(() => {
      gsap.matchMedia().add({ desk: '(min-width: 1024px)', mob: '(max-width: 1023px)' }, (ctx) => build(!!ctx.conditions!.desk));
      // Este pin se crea después que los ScrollTrigger de más abajo: hay que reordenarlos para que
      // midan su inicio contando el espacio que agrega.
      ScrollTrigger.sort();
      ScrollTrigger.refresh();
    });
  }
</script>
