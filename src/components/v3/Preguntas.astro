---
// Preguntas del estudio (sin las propias de RebelBot). Acordeón con <details>: sin JavaScript funciona
// igual; con JavaScript la respuesta se abre y se cierra con su altura animada.
import { preguntas } from '../../data/estudio';

const lista = [0, 6, 7, 8, 9].map((i) => preguntas[i]);
---
<section id="preguntas" class="wrap v3-sec pq" aria-labelledby="pq-title">
  <h2 id="pq-title" class="text-d2 pq-title">Preguntas frecuentes.</h2>
  <div class="pq-list">
    {lista.map((p) => (
      <details class="pq-item" data-pq>
        <summary class="pq-q">
          <span class="text-d3">{p.q}</span>
          <span class="pq-ico" aria-hidden="true"></span>
        </summary>
        <div class="pq-a" data-pq-a>
          <p class="text-body text-ash">{p.a}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .pq { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) {
    .pq { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: start; }
    .pq-title { position: sticky; top: 7rem; }
  }
  .pq-list { border-bottom: 1px solid var(--color-line); }
  .pq-item { border-top: 1px solid var(--color-line); }
  .pq-q {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 1.5rem;
    cursor: pointer; list-style: none; color: var(--color-bone); transition: color 0.3s;
  }
  .pq-q::-webkit-details-marker { display: none; }
  .pq-q:hover { color: var(--color-max); }

  /* Más que se vuelve equis al abrir; el rojo marca la pregunta abierta */
  .pq-ico { position: relative; flex: none; width: 1.1rem; height: 1.1rem; transition: transform 0.45s var(--ease-out-expo); }
  .pq-ico::before, .pq-ico::after {
    content: ''; position: absolute; left: 0; top: 50%; width: 100%; height: 2px; margin-top: -1px; border-radius: 2px;
    background: currentColor; transition: background-color 0.3s;
  }
  .pq-ico::after { transform: rotate(90deg); }
  .pq-item[open]:not(.is-closing) .pq-ico { transform: rotate(135deg); }
  .pq-item[open]:not(.is-closing) .pq-ico::before, .pq-item[open]:not(.is-closing) .pq-ico::after { background: var(--color-red-text); }

  .pq-a { overflow: hidden; }
  .pq-a p { margin: 0; padding-bottom: 1.6rem; max-width: 60ch; }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../../scripts/motion';

  // Recalcular posiciones una sola vez después de abrir o cerrar varias seguidas.
  const refresh = (() => { let t = 0; return () => { clearTimeout(t); t = window.setTimeout(() => ScrollTrigger.refresh(true), 200); }; })();

  // Con «menos movimiento» se deja el comportamiento nativo del <details>.
  if (!reduceMotion) {
    document.querySelectorAll<HTMLDetailsElement>('[data-pq]').forEach((d) => {
      const a = d.querySelector<HTMLElement>('[data-pq-a]')!;
      d.querySelector('summary')!.addEventListener('click', (e) => {
        e.preventDefault();
        gsap.killTweensOf(a);
        const opening = !d.open || d.classList.contains('is-closing');
        if (opening) {
          // Si se estaba cerrando, sigue desde la altura en que quedó.
          const from = d.classList.contains('is-closing') ? a.offsetHeight : 0;
          d.classList.remove('is-closing');
          d.open = true;
          gsap.fromTo(a, { height: from, opacity: from ? Number(gsap.getProperty(a, 'opacity')) : 0 }, {
            height: 'auto', opacity: 1, duration: 0.55, ease: 'power3.out',
            onComplete: () => { gsap.set(a, { clearProps: 'height,opacity' }); refresh(); },
          });
        } else {
          d.classList.add('is-closing');
          gsap.to(a, {
            height: 0, opacity: 0, duration: 0.45, ease: 'power3.out',
            onComplete: () => { d.open = false; d.classList.remove('is-closing'); gsap.set(a, { clearProps: 'height,opacity' }); refresh(); },
          });
        }
      });
    });
  }
</script>
