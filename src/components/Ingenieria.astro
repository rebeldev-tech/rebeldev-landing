---
// «Pieza por pieza»: cómo se prueba cada cambio antes de llegar a producción (así está hecho RebelBot).
// Animación ligada al scroll: un pulso rojo recorre el camino y cada etapa se marca al pasar.
const etapas = ['Cambio en el código', 'Reglas de arquitectura', 'Pruebas automáticas', 'Ambiente de pruebas', 'Producción'];
const log = ['nuevo cambio', 'reglas de arquitectura: ok', 'pruebas automáticas: ok', 'publicado en el ambiente de pruebas', 'en producción'];
const hechos = [
  { t: 'Hecho para durar y crecer', d: 'Arquitectura limpia: el sistema está dividido en módulos, con reglas que se revisan solas en cada cambio. Las piezas se pueden cambiar sin rehacer el sistema.' },
  { t: 'Probado antes de salir', d: 'Pruebas automáticas en cada cambio y un ambiente de pruebas antes de pasar a producción.' },
  { t: 'Nada a ciegas', d: 'Las decisiones quedan documentadas y la operación tiene alertas y monitoreo.' },
  { t: 'Datos cuidados', d: 'Las claves se guardan en una bóveda en la nube y los teléfonos se ocultan en los registros.' },
];
const stack = ['Java 21', 'Spring Boot', 'React', 'TypeScript', 'PostgreSQL', 'WhatsApp Cloud API', 'Microsoft Azure'];
---
<section id="ingenieria" class="relative overflow-hidden border-t border-line py-24 lg:py-36" aria-labelledby="ing-title">
  <div class="wrap">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-24" data-reveal>
      <h2 id="ing-title" class="text-d1">Hecho pieza por pieza.</h2>
      <p class="text-lead max-w-[48ch] text-ash lg:pt-3">Integramos inteligencia artificial en nuestro proceso para elevar la calidad de cada entrega y reducir los tiempos: cada proyecto se trabaja con el detalle y el criterio de un desarrollo hecho pieza por pieza, con arquitectura limpia, código sólido y listo para escalar.</p>
    </div>

    <div class="pipe mt-16 lg:mt-24" data-pipe>
      <p class="mb-8 text-body text-ash">Así llega cada cambio de RebelBot a tus clientes:</p>
      <div class="pipe-track" aria-hidden="true">
        <span class="pipe-line"></span>
        <span class="pipe-fill" data-pipe-fill></span>
        <span class="pipe-pulse" data-pipe-pulse></span>
      </div>
      <ol class="pipe-steps">
        {etapas.map((e) => (
          <li class="pipe-step" data-pipe-step>
            <span class="pipe-dot" aria-hidden="true">
              <svg viewBox="0 0 16 16"><path d="M4 8.5l2.5 2.5L12 5.5" /></svg>
            </span>
            <span class="text-body font-medium">{e}</span>
          </li>
        ))}
      </ol>
      <div class="term mt-12" aria-hidden="true">
        <div class="term-bar"><i></i><i></i><i></i></div>
        <div class="term-body font-mono">
          {log.map((l, i) => <p class="term-line" data-term-line><span class="text-ash-dim">{i === 0 ? '>' : '✓'}</span> {l}</p>)}
        </div>
      </div>
    </div>

    <div class="mt-20 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-24" data-reveal>
      <p class="text-d2 font-display">La IA acelera, no decide.</p>
      <p class="text-body max-w-[46ch] text-ash">La IA escribe borradores de código, pruebas y documentación. Un ingeniero senior define la arquitectura y aprueba cada cambio. Lo construimos rápido con IA y lo revisan ingenieros que han hecho sistemas para millones de personas.</p>
    </div>
    <div class="mt-16 grid gap-x-16 sm:grid-cols-2">
      {hechos.map((h) => (
        <div class="border-t border-line py-7" data-reveal>
          <h3 class="text-d3">{h.t}</h3>
          <p class="text-body mt-2 max-w-[42ch] text-ash">{h.d}</p>
        </div>
      ))}
    </div>
    <p class="mt-10 text-note text-ash-dim">
      <span class="text-ash">Con qué está hecho RebelBot:</span>
      {stack.map((s, i) => <>{i > 0 && <span class="slash" aria-hidden="true">/</span>}<span>{s}</span></>)}
    </p>
  </div>
</section>

<style>
  .pipe-track { position: relative; height: 2px; margin-inline: 0.9rem; }
  .pipe-line, .pipe-fill { position: absolute; inset: 0; border-radius: 2px; }
  .pipe-line { background: var(--color-line); }
  .pipe-fill { background: var(--color-red); transform-origin: left; transform: scaleX(var(--p, 1)); }
  .pipe-pulse {
    position: absolute; top: 50%; left: calc(var(--p, 1) * 100%); width: 0.9rem; height: 0.9rem; border-radius: 99px;
    background: var(--color-red-text); transform: translate(-50%, -50%); box-shadow: 0 0 0 6px rgb(255 45 63 / 0.18), 0 0 30px 6px rgb(255 45 63 / 0.55);
  }
  .pipe-steps { list-style: none; margin: -0.95rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; }
  .pipe-step { display: flex; flex-direction: column; gap: 1rem; color: var(--color-ash); transition: color .4s; }
  .pipe-step.is-done { color: var(--color-bone); }
  .pipe-dot {
    display: grid; place-items: center; width: 1.8rem; height: 1.8rem; border-radius: 99px;
    background: var(--color-ink); border: 1px solid var(--color-line-strong); transition: background-color .4s, border-color .4s;
  }
  .pipe-dot svg { width: 0.9rem; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; opacity: 0; transition: opacity .3s; }
  .is-done .pipe-dot { background: var(--color-red); border-color: var(--color-red); }
  .is-done .pipe-dot svg { opacity: 1; }

  .term { max-width: 36rem; border: 1px solid var(--color-line); border-radius: 0.9rem; background: var(--color-surface); overflow: hidden; }
  .term-bar { display: flex; gap: 0.4rem; padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--color-line); }
  .term-bar i { width: 0.6rem; height: 0.6rem; border-radius: 99px; background: color-mix(in srgb, var(--color-bone) 15%, transparent); }
  .term-body { padding: 1rem 1.1rem 1.2rem; font-size: 0.85rem; line-height: 1.9; color: var(--color-bone); }
  .term-line { margin: 0; }

  @media (max-width: 767px) {
    .pipe-track { display: none; }
    .pipe-steps { grid-template-columns: 1fr; margin: 0; gap: 0.9rem; }
    .pipe-step { flex-direction: row; align-items: center; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../scripts/motion';

  const pipe = document.querySelector<HTMLElement>('[data-pipe]')!;
  const steps = Array.from(pipe.querySelectorAll<HTMLElement>('[data-pipe-step]'));
  const lines = Array.from(pipe.querySelectorAll<HTMLElement>('[data-term-line]'));

  const render = (p: number) => {
    pipe.style.setProperty('--p', String(p));
    const n = steps.length - 1;
    steps.forEach((s, i) => s.classList.toggle('is-done', p >= i / n - 0.001));
    lines.forEach((l, i) => { l.style.opacity = p >= i / n - 0.001 ? '1' : '0.15'; });
  };

  if (reduceMotion) render(1);
  else {
    render(0);
    ScrollTrigger.create({
      trigger: pipe, start: 'top 70%', end: 'bottom 45%', scrub: 0.6,
      onUpdate: (self) => render(gsap.utils.snap(0.001, self.progress)),
    });
  }
</script>
