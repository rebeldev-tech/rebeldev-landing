---
// «Output slips along the edge»: lo que el cliente recibe, como papeletas que asoman por el borde.
// Es la pieza viva de la versión: eliges cuántas semanas construimos y las papeletas se llenan con
// fechas reales desde el próximo lunes. Sin JavaScript quedan en semanas relativas.
import { entregas, chat, fotos } from '../../data/v5';
import { papeletas } from '../../lib/calendario';

const fondo = fotos.centralita;
const lista = papeletas(entregas.semanas.inicial, null);
// La conversación va en tercer lugar, entre el diagnóstico y las demos.
const orden = [lista[0], lista[1], 'chat', lista[2], lista[3], lista[4]] as const;
---
<section class="en" id="entregas" aria-labelledby="en-h2">
  <img class="en-fondo" src={fondo.src} width={fondo.w} height={fondo.h} alt={fondo.alt} loading="lazy" decoding="async" data-en-fondo />

  <div class="en-col" data-reveal>
    <h2 id="en-h2" class="en-h2">{entregas.titulo}</h2>
    <p class="en-p">{entregas.texto}</p>
    <div class="en-ctrl" data-en-ctrl hidden>
      <p class="en-desde">Si empezamos el <strong data-en-inicio>próximo lunes</strong>, con</p>
      <div class="en-paso" role="group" aria-label="Semanas de construcción">
        <button type="button" class="en-btn" data-en-menos aria-label="Una semana menos">−</button>
        <output class="en-n" data-en-n aria-live="polite">{entregas.semanas.inicial} semanas</output>
        <button type="button" class="en-btn" data-en-mas aria-label="Una semana más">+</button>
      </div>
      <p class="en-aviso">{entregas.aviso}</p>
    </div>
  </div>

  <ol class="en-tiras" aria-label="Papeletas de ejemplo" data-en-tiras data-min={entregas.semanas.min} data-max={entregas.semanas.max} data-inicial={entregas.semanas.inicial}>
    {orden.map((p, i) => p === 'chat' ? (
      <li class="en-tira en-chat" style={`--i:${i}`} data-ui>
        <p class="en-t">RebelBot · WhatsApp</p>
        <p class="en-raya" aria-hidden="true">- - - - - - - - - - -</p>
        {chat.map((m) => <p class:list={['en-m', `en-${m.de}`]}>{m.t}</p>)}
      </li>
    ) : (
      <li class="en-tira" style={`--i:${i}`} data-en-tira={p.id}>
        <p class="en-t">{p.titulo}</p>
        <p class="en-raya" aria-hidden="true">- - - - - - - - - - -</p>
        <div data-en-lineas>{p.lineas.map((l) => <p>{l}</p>)}</div>
      </li>
    ))}
  </ol>
</section>

<style>
  .en { position: relative; min-height: max(96svh, 820px); overflow: clip; display: grid; grid-template-rows: auto 1fr; background: var(--c-bg); }
  .en-fondo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(0.62) contrast(1.05); }

  .en-col {
    position: relative; margin: clamp(72px, 10vh, 120px) 0 0 18%; width: min(620px, 64%);
    padding: 28px 32px; background: rgb(11 10 14 / 0.86); color: var(--c-ink);
  }
  .en-h2 { font-size: var(--t-m); line-height: 1.15; letter-spacing: -0.02em; }
  .en-p { margin-top: 12px; font-size: var(--t-m); line-height: 1.3; font-family: var(--font-display); font-weight: 400; letter-spacing: -0.015em; }
  .en-ctrl { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; font-size: 18px; }
  .en-desde strong { font-weight: 600; }
  .en-paso { display: inline-flex; align-items: center; background: var(--c-paper); color: var(--c-paper-ink); }
  .en-btn { width: 48px; height: 48px; font-size: 24px; line-height: 1; cursor: pointer; transition: background-color .2s, color .2s; }
  .en-btn:hover { background: var(--c-red); color: #fff; }
  .en-btn:active { transform: scale(0.94); }
  .en-btn:disabled { opacity: 0.35; cursor: not-allowed; background: none; color: inherit; }
  .en-n { min-width: 9ch; text-align: center; font-weight: 600; font-variant-numeric: tabular-nums; }
  .en-aviso { flex-basis: 100%; font-size: 15px; color: var(--c-muted); }

  .en-tiras { position: relative; align-self: end; list-style: none; margin: 48px 0 0; padding: 0 var(--m); display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; align-items: end; }
  .en-tira {
    --alto: 34svh; min-height: var(--alto); max-height: calc(var(--alto) + 6svh); overflow: hidden;
    padding: 18px 16px 0; background: var(--c-paper); color: var(--c-paper-ink); font-size: 15px; line-height: 1.45;
  }
  .en-tira:nth-child(1) { --alto: 30svh; rotate: -1.5deg; }
  .en-tira:nth-child(2) { --alto: 40svh; }
  .en-tira:nth-child(3) { --alto: 36svh; rotate: 1.2deg; }
  .en-tira:nth-child(4) { --alto: 28svh; }
  .en-tira:nth-child(5) { --alto: 38svh; rotate: -1deg; }
  .en-tira:nth-child(6) { --alto: 33svh; }
  .en-t { font-weight: 600; }
  .en-raya { color: var(--c-paper-muted); letter-spacing: 0.05em; overflow: hidden; white-space: nowrap; }
  .en-chat { background: var(--c-wa); color: #E9EDEF; }
  .en-chat .en-raya { color: #8696A0; }
  .en-m { margin-top: 6px; padding: 6px 9px; max-width: 92%; border-radius: 8px; }
  .en-cliente { background: var(--c-wa-in); }
  .en-bot { margin-left: auto; background: var(--c-wa-out); }
  .en-sistema { max-width: none; text-align: center; color: #8696A0; }

  @media (max-width: 1023px) {
    .en { min-height: 100svh; }
    .en-col { margin: 64px var(--m) 0; width: auto; padding: 22px 20px; }
    .en-tiras { grid-template-columns: 1fr 1fr; align-items: start; }
    .en-tira { min-height: 0; max-height: none; padding-bottom: 16px; rotate: none !important; }
  }
</style>
