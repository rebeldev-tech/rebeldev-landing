---
// Cierre: la franja roja entera es el botón («One word is the button») y el pie tiene el correo como titular.
import Logo from '../Logo.astro';
import { cierre, fotos } from '../../data/v5';
import { contacto } from '../../data/contacto';

const [usuario, dominio] = contacto.correo.split('@');
---
<a class="ci" href={contacto.whatsappLink} target="_blank" rel="noopener" aria-label={`${cierre.palabra} por WhatsApp: ${cierre.frase}`}>
  <span class="ci-frase">{cierre.frase}</span>
  <svg class="ci-flecha" viewBox="0 0 48 48" aria-hidden="true"><path d="M12 36 36 12M16 12h20v20" /></svg>
  <span class="ci-palabra" aria-hidden="true">{cierre.palabra}</span>
</a>

<footer class="pie">
  <div class="pie-top">
    <span class="pie-marca"><Logo /></span>
    <div class="pie-notas">{cierre.notas.map((n) => <p>{n}</p>)}</div>
    <a href="#inicio" class="pie-arriba">Volver arriba</a>
  </div>

  <h2 class="pie-correo"><a href={`mailto:${contacto.correo}`}>{usuario}<wbr />@{dominio}</a></h2>

  <div class="pie-meta">
    <p><a href={contacto.whatsappLink} target="_blank" rel="noopener">WhatsApp {contacto.whatsapp}</a></p>
    <p class="pie-creditos">Fotos de archivo vía Wikimedia Commons, sin restricciones de derechos conocidas:
      {Object.values(fotos).map((f, i, a) => <><a href={f.url} target="_blank" rel="noopener">{f.titulo}</a>, {f.autor}{i < a.length - 1 ? '; ' : '.'}</>)}
    </p>
    <p class="pie-lugar">{cierre.lugar}</p>
  </div>
</footer>

<style>
  .ci {
    position: relative; display: block; min-height: 60svh; padding: 28px var(--m) 24px; overflow: hidden;
    background: var(--c-red); color: #fff;
    clip-path: polygon(0 40px, 40px 0, calc(100% - 40px) 0, 100% 40px, 100% 100%, 0 100%);
  }
  .ci:hover, .ci:focus-visible { background: var(--c-paper); color: var(--c-paper-ink); }
  .ci:focus-visible { outline: none; }
  .ci-frase { display: block; max-width: 30ch; padding-top: 20px; font-size: var(--t-m); line-height: 1.35; }
  .ci-flecha { position: absolute; top: 48px; right: var(--m); width: 48px; height: 48px; fill: none; stroke: currentColor; stroke-width: 4; stroke-linecap: square; transition: translate .3s var(--ease-out-expo); }
  .ci:hover .ci-flecha { translate: 6px -6px; }
  .ci-palabra {
    position: absolute; left: var(--m); bottom: 24px;
    font-family: var(--font-display); font-weight: 800; font-size: clamp(110px, 27vw, 440px); line-height: 0.74; letter-spacing: -0.055em;
  }

  .pie { min-height: 90svh; display: grid; grid-template-rows: auto 1fr auto; padding: 40px var(--m) 32px; background: var(--c-bg); color: var(--c-ink); }
  .pie-top { display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: 32px; font-size: 18px; }
  .pie-notas { display: grid; gap: 6px; max-width: 40ch; }
  .pie-marca { font-size: var(--t-m); }
  .pie-arriba, .pie-meta a { text-underline-offset: 4px; }
  .pie-arriba:hover, .pie-meta a:hover { text-decoration: underline; text-decoration-color: var(--c-red); }
  .pie-correo { align-self: end; padding-block: 64px 48px; font-size: clamp(40px, 9vw, 150px); line-height: 0.95; letter-spacing: -0.045em; }
  .pie-correo a { transition: color .2s; }
  .pie-correo a:hover { color: var(--c-red-text); }
  .pie-meta { display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 24px; font-size: 15px; color: var(--c-muted); }
  .pie-creditos { justify-self: center; max-width: 70ch; text-align: center; }
  .pie-lugar { text-align: right; }

  @media (max-width: 767px) {
    .ci { min-height: 46svh; clip-path: polygon(0 24px, 24px 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 0 100%); }
    .ci-frase { max-width: 22ch; }
    .ci-flecha { width: 32px; height: 32px; top: 40px; }
    .ci-palabra { font-size: 28vw; }
    .pie { min-height: 0; row-gap: 0; }
    .pie-top { grid-template-columns: 1fr auto; }
    .pie-notas { grid-row: 2; grid-column: 1 / -1; }
    .pie-correo { font-size: 9.4vw; padding-block: 72px 40px; }
    .pie-meta { grid-template-columns: 1fr; }
    .pie-creditos, .pie-lugar { justify-self: start; text-align: left; }
  }
</style>
