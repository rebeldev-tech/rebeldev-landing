---
// «Two columns, highlighted words»: la historia de Fredy en texto grande, a dos columnas, con los datos
// que un lector busca marcados con fondos planos. La última frase es el enlace a WhatsApp.
import { fredy, fredyCierre } from '../../data/v5';
import { contacto } from '../../data/contacto';
---
<section class="fr campo-claro" id="fredy" aria-labelledby="fr-h2">
  <h2 id="fr-h2" class="fr-h2" data-reveal>Quién lo lidera</h2>
  <p class="fr-texto" data-reveal>
    {fredy.map((p) => p.m ? <mark class={`fr-${p.m}`}>{p.t}</mark> : p.t)}
    {' '}<a class="fr-cierre" href={contacto.whatsappLink} target="_blank" rel="noopener">{fredyCierre}</a>
  </p>
</section>

<style>
  .fr { padding: clamp(120px, 12vw, 180px) var(--m); }
  .fr-h2 { font-size: var(--t-l); line-height: 0.95; letter-spacing: -0.04em; margin-bottom: 56px; }
  .fr-texto {
    columns: 2; column-gap: 48px;
    font-size: var(--t-m); line-height: 1.22; color: var(--c-paper-muted);
  }
  mark { padding: 0 0.1em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .fr-nombre { background: none; color: var(--c-paper-ink); font-weight: 600; padding: 0; }
  .fr-ambar { background: var(--c-amber); color: var(--c-paper-ink); }
  .fr-tinta { background: var(--c-paper-ink); color: var(--c-paper); }
  .fr-rojo { background: var(--c-red); color: #fff; }
  .fr-cierre {
    background: var(--c-red); color: #fff; padding: 0 0.1em; -webkit-box-decoration-break: clone; box-decoration-break: clone;
    font-weight: 600; transition: background-color .2s, color .2s;
  }
  .fr-cierre:hover, .fr-cierre:focus-visible { background: var(--c-paper-ink); color: var(--c-paper); }

  @media (max-width: 767px) {
    .fr-h2 { font-size: 9vw; margin-bottom: 32px; }
    .fr-texto { columns: 1; line-height: 1.3; }
    .fr-cierre { display: block; margin-top: 24px; padding: 14px 16px; }
  }
</style>
