---
// «Tabbed index cards»: las preguntas archivadas como fichas con pestaña. Usa <details name> del navegador:
// una abierta a la vez y la primera abierta al cargar, sin JavaScript.
import { preguntas } from '../../data/v5';
import { preguntas as todas } from '../../data/estudio';
---
<section class="pq" id="preguntas" aria-labelledby="pq-h2">
  <div class="pq-col">
    <h2 id="pq-h2" class="pq-h2" data-reveal>{preguntas.titulo}</h2>
    <div class="pq-fichas">
      {preguntas.lista.map((p, i) => (
        <details class="pq-ficha" name="pq" open={i === 0} style={`--i:${i}`}>
          <summary>
            <span class="pq-tema">{p.tema}</span>
            <span class="pq-q">{todas[p.de].q}</span>
          </summary>
          <p class="pq-a">{todas[p.de].a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .pq { padding: clamp(120px, 12vw, 180px) var(--m); }
  .pq-col { width: min(100%, 980px); margin-inline: auto; }
  .pq-h2 { font-size: var(--t-l); line-height: 0.95; letter-spacing: -0.04em; margin-bottom: 56px; }
  .pq-fichas { display: grid; }

  .pq-ficha {
    --tab-x: calc(var(--i) * 150px); --tab-w: 200px; --tab-h: 44px;
    position: relative; margin-top: -40px; padding: var(--tab-h) 28px 64px;
    background: var(--c-surface-2); color: var(--c-ink);
    clip-path: polygon(0 var(--tab-h), var(--tab-x) var(--tab-h), var(--tab-x) 0, calc(var(--tab-x) + var(--tab-w)) 0, calc(var(--tab-x) + var(--tab-w)) var(--tab-h), 100% var(--tab-h), 100% 100%, 0 100%);
  }
  .pq-ficha:first-child { margin-top: 0; }
  .pq-ficha:nth-child(even) { background: var(--c-paper); color: var(--c-paper-ink); }
  .pq-ficha:last-child { padding-bottom: 28px; }
  summary { list-style: none; cursor: pointer; display: block; }
  summary::-webkit-details-marker { display: none; }
  .pq-tema { position: absolute; top: 0; left: var(--tab-x); width: var(--tab-w); height: var(--tab-h); display: flex; align-items: center; padding-inline: 18px; font-size: 15px; font-weight: 600; }
  .pq-q { display: block; padding-block: 16px 4px; font-size: var(--t-m); font-weight: 500; line-height: 1.3; transition: color .2s; }
  summary:hover .pq-q { color: var(--c-red-text); }
  .pq-ficha:nth-child(even) summary:hover .pq-q { color: var(--c-red-on-paper); }
  summary:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .pq-a { max-width: 50ch; padding-top: 8px; font-size: 18px; line-height: 1.55; }

  @media (max-width: 767px) {
    .pq-h2 { font-size: 9vw; margin-bottom: 32px; }
    .pq-ficha { --tab-x: calc(var(--i) * 40px); --tab-w: 136px; padding-inline: 20px; }
    .pq-tema { padding-inline: 14px; }
  }
</style>
