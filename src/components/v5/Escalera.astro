---
// «Staircase statement»: la promesa oficial baja en cinco renglones, cada uno más a la derecha.
import { escalera, fotos } from '../../data/v5';
const [a, b] = [fotos.telegrafo, fotos.dibujo];
---
<section class="es campo-claro" aria-label="Qué hacemos">
  <div class="es-grid">
    <p class="es-frase" data-reveal>
      {escalera.renglones.map((r, i) => <span class:list={['es-r', { 'es-rojo': i % 2 === 1 }]} style={`--i:${i}`}>{r}</span>)}
    </p>
    <div class="es-fotos">
      <img src={a.src} width={a.w} height={a.h} alt={a.alt} loading="lazy" decoding="async" data-reveal />
      <img src={b.src} width={b.w} height={b.h} alt={b.alt} loading="lazy" decoding="async" data-reveal />
    </div>
    <p class="es-nota" data-reveal>{escalera.nota}</p>
  </div>
</section>

<style>
  .es { padding-block: clamp(120px, 12vw, 180px); }
  .es-grid { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 16px; row-gap: 48px; padding-inline: var(--m); }
  .es-frase { grid-column: 1 / 8; grid-row: 1; align-self: end; font-family: var(--font-display); font-weight: 800; font-size: var(--t-s); line-height: 1.1; letter-spacing: -0.02em; }
  .es-r { display: block; padding-left: calc(var(--i) * 4vw); }
  .es-rojo { color: var(--c-red-on-paper); }
  .es-fotos { grid-column: 8 / 13; grid-row: 1 / 3; display: grid; gap: 16px; }
  .es-fotos img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .es-nota { grid-column: 1 / 7; grid-row: 2; align-self: start; max-width: 52ch; font-size: 18px; line-height: 1.5; }

  @media (max-width: 1023px) {
    .es-frase { grid-column: 1 / -1; font-size: 24px; }
    .es-r { padding-left: calc(var(--i) * 5vw); }
    .es-fotos { grid-column: 1 / -1; grid-row: 2; grid-template-columns: 1fr 1fr; }
    .es-nota { grid-row: 3; }
    .es-nota { grid-column: 1 / -1; }
  }
</style>
