---
// Portada de la versión 2, al estilo del hero de Terminal Industries: un video fijo que avanza con el
// scroll («pieza por pieza»: bloques que se ensamblan en una estructura) y, encima, frases que se
// encienden palabra por palabra. Antes, la pantalla de carga con el </>.
// Video: public/video/hero.mp4, generado con Higgsfield. Si se cambia, no hay que tocar el código.
// Sin JavaScript o con «menos movimiento», el video queda quieto y las frases se leen una debajo de otra.
import { MARK } from '../lib/mark';
import { contacto } from '../data/contacto';

const lineas = ['Software a medida', 'Automatización de procesos', 'Plataformas web', 'Integraciones'];
---
<div class="intro" data-intro aria-hidden="true">
  <svg class="intro-mark" data-intro-mark viewBox={`0 0 ${MARK.width} ${MARK.height}`}>
    <g fill="none" stroke-width={MARK.stroke} stroke-linecap="round" stroke-linejoin="round">
      <path d={MARK.left} stroke="#F4F0E8" data-intro-path />
      <path d={MARK.right} stroke="#F4F0E8" data-intro-path />
      <path d={MARK.slash} stroke="#E4121F" data-intro-slash />
    </g>
  </svg>
</div>

<section id="inicio" class="cine" data-cine>
  <div class="cine-stage" data-cine-stage>
    <video class="cine-video" data-cine-video src="/video/hero.mp4" muted playsinline preload="auto" disablepictureinpicture aria-hidden="true" tabindex="-1"></video>
    <div class="cine-shade" aria-hidden="true"></div>

    <div class="wrap cine-beats">
      <div class="cine-beat" data-beat="0">
        <h1 class="text-hero cine-title" data-cine-title>Ingeniería para empresas rebeldes.</h1>
        <p class="mt-6 max-w-[44ch] text-lead text-ash" data-cine-in>RebelDEV es un estudio de desarrollo de software. Creamos soluciones a medida según lo que necesita cada empresa.</p>
        <p class="cine-strip text-note text-ash" data-cine-in>
          <span class="sr-only">Servicios: </span>
          {lineas.map((s, i) => <>{i > 0 && <span class="slash" aria-hidden="true">/</span>}<span>{s}</span></>)}
        </p>
      </div>

      <p class="cine-beat cine-phrase text-d1" data-beat="1"><span data-words>Cada empresa trabaja distinto. Su software también debería.</span></p>
      <p class="cine-beat cine-phrase cine-wide text-d1" data-beat="2"><span data-words>Lo construimos pieza por pieza: web, automatización, integraciones y asistentes de WhatsApp.</span></p>

      <div class="cine-beat" data-beat="3">
        <p class="cine-phrase text-d1"><span data-words>Hecho para durar y crecer.</span></p>
        <p class="mt-6 max-w-[46ch] text-lead text-ash" data-beat-sub>Entregamos en semanas lo que en una empresa tradicional toma meses.</p>
        <div class="mt-8 flex flex-wrap gap-3" data-beat-sub>
          <a href={contacto.whatsappLink} target="_blank" rel="noopener" class="btn btn-primary">Agenda una demo</a>
          <a href="#servicios" class="btn btn-ghost">Mira lo que construimos</a>
        </div>
      </div>
    </div>

    <p class="cine-cue text-note" data-cine-cue aria-hidden="true">Baja para ver cómo funciona<span class="cine-cue-line"></span></p>
    <div class="cine-bar" aria-hidden="true"><span data-cine-bar></span></div>
  </div>
</section>

<style>
  .intro { display: none; }
  :global(html.show-intro) .intro { display: grid; place-items: center; position: fixed; inset: 0; z-index: 80; background: #0B0A0E; }
  .intro-mark { width: clamp(84px, 11vw, 140px); height: auto; overflow: visible; }

  /* La portada es oscura en los dos temas (como el teléfono de RebelBot): fija sus propios colores */
  .cine {
    --color-bone: #F4F0E8; --color-ash: #C9C3CA; --color-line: rgb(244 240 232 / 0.14); --color-line-strong: rgb(244 240 232 / 0.32);
    position: relative; background: #0B0A0E; color: var(--color-bone); color-scheme: dark;
  }
  .cine-stage { position: relative; min-height: 100svh; overflow: hidden; isolation: isolate; }
  .cine-video { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .cine-shade {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(to top, rgb(11 10 14 / 0.94) 0%, rgb(11 10 14 / 0.62) 34%, rgb(11 10 14 / 0.12) 64%, rgb(11 10 14 / 0.5) 100%),
      linear-gradient(to right, rgb(11 10 14 / 0.55), transparent 60%);
  }

  /* Sin animación: las frases se leen en orden, sobre el primer cuadro del video */
  .cine-beats { position: relative; display: grid; gap: 4.5rem; padding-top: 9rem; padding-bottom: 4rem; }
  .cine-title { margin: 0; max-width: 11ch; }
  .cine-phrase { margin: 0; max-width: 17ch; }
  .cine-wide { max-width: 22ch; }
  .cine-strip { margin: 2rem 0 0; padding-top: 1.1rem; border-top: 1px solid var(--color-line); }
  .cine-cue, .cine-bar { display: none; }

  /* Con animación: el escenario ocupa la pantalla y las frases se turnan en el mismo lugar */
  :global(html.has-motion) .cine-stage { height: 100svh; min-height: 0; }
  :global(html.has-motion) .cine-beats { position: absolute; inset: 0; display: block; padding: 0; }
  :global(html.has-motion) .cine-beat { position: absolute; inset-inline: clamp(1.25rem, 4vw, 3rem); bottom: clamp(4.5rem, 11vh, 7.5rem); }
  :global(html.has-motion) .cine-beat:not([data-beat="0"]) { visibility: hidden; }
  :global(html.has-motion) [data-cine-title], :global(html.has-motion) [data-cine-in] { visibility: hidden; }
  :global(html.has-motion) .cine-cue {
    display: flex; align-items: center; gap: 0.8rem; position: absolute; right: clamp(1.25rem, 4vw, 3rem); bottom: 1.6rem;
    margin: 0; color: var(--color-ash); visibility: hidden;
  }
  :global(html.has-motion) .cine-bar { display: block; position: absolute; inset: auto 0 0 0; height: 2px; background: rgb(244 240 232 / 0.08); }
  .cine-bar span { display: block; height: 100%; background: #E4121F; transform: scaleX(0); transform-origin: left; }
  .cine-cue-line { position: relative; width: 3rem; height: 1px; overflow: hidden; background: rgb(244 240 232 / 0.2); }
  .cine-cue-line::after { content: ''; position: absolute; inset: 0; background: #FF2D3F; animation: cine-cue 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
  @keyframes cine-cue { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
  @media (max-width: 640px) { :global(html.has-motion) .cine-cue { display: none; } }

  /* Palabras aún apagadas (las enciende el scroll) */
  :global(.cine .w) { display: inline; }
</style>

<script>
  import { gsap, SplitText, reduceMotion, lenis } from '../scripts/motion';

  const root = document.documentElement;
  const sec = document.querySelector<HTMLElement>('[data-cine]')!;
  const stage = sec.querySelector<HTMLElement>('[data-cine-stage]')!;
  const video = sec.querySelector<HTMLVideoElement>('[data-cine-video]')!;
  const intro = document.querySelector<HTMLElement>('[data-intro]')!;

  if (!reduceMotion) {
    const [beat0, beat1, beat2, beat3] = gsap.utils.toArray<HTMLElement>('[data-beat]', sec);
    const words = gsap.utils.toArray<HTMLElement>('[data-words]', sec).map((el) => SplitText.create(el, { type: 'words', wordsClass: 'w' }).words);
    const subs = beat3.querySelectorAll('[data-beat-sub]');
    const cue = sec.querySelector('[data-cine-cue]');

    // El archivo tiene un solo cuadro clave: se baja completo para que cada salto de cuadro sea inmediato.
    const ready = fetch(video.currentSrc || video.src)
      .then((r) => r.blob())
      .then((b) => new Promise<void>((res) => {
        video.addEventListener('loadeddata', () => res(), { once: true });
        video.src = URL.createObjectURL(b);
      }))
      .catch(() => undefined);

    // Reloj del video: el scroll mueve «clock.t» (de 0 a 1) y el ticker acerca el video a ese punto
    // sin pedir un cuadro nuevo hasta que el anterior esté listo.
    const clock = { t: 0 };
    let cur = 0, seeking = false;
    video.addEventListener('seeked', () => { seeking = false; });
    gsap.ticker.add(() => {
      if (video.readyState < 2 || !video.duration) return;
      cur += (clock.t * (video.duration - 0.05) - cur) * 0.22;
      if (!seeking && Math.abs(video.currentTime - cur) > 0.015) { seeking = true; video.currentTime = cur; }
    });

    gsap.set([beat1, beat2, beat3], { autoAlpha: 0 });
    gsap.set(words.flat(), { opacity: 0.12 });
    gsap.set(subs, { autoAlpha: 0, y: 16 });

    const out = { autoAlpha: 0, y: -48, filter: 'blur(10px)', duration: 0.8, ease: 'power1.in' };
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: sec, start: 'top top', end: '+=340%', pin: stage, scrub: 0.6 },
    });
    // El video avanza de punta a punta mientras pasan las frases (sirve para cualquier duración).
    tl.to(clock, { t: 1, duration: 9.2 }, 0.2)
      .fromTo(video, { scale: 1.12 }, { scale: 1, duration: 10 }, 0)
      .fromTo('[data-cine-bar]', { scaleX: 0 }, { scaleX: 1, duration: 10 }, 0)
      .to(cue, { autoAlpha: 0, duration: 0.4 }, 0.1)
      .to(beat0, out, 0.3)
      .set(beat1, { autoAlpha: 1 }, 1.3)
      .to(words[0], { opacity: 1, duration: 0.4, stagger: 0.14 }, 1.3)
      .to(beat1, out, 3.5)
      .set(beat2, { autoAlpha: 1 }, 4.3)
      .to(words[1], { opacity: 1, duration: 0.4, stagger: 0.13 }, 4.3)
      .to(beat2, out, 6.6)
      .set(beat3, { autoAlpha: 1 }, 7.3)
      .to(words[2], { opacity: 1, duration: 0.4, stagger: 0.16 }, 7.3)
      .to(subs, { autoAlpha: 1, y: 0, duration: 0.6, stagger: 0.2, ease: 'power2.out' }, 8.4)
      .to({}, { duration: 0.6 });

    // Entrada: el titular sube por líneas y luego aparece el resto.
    const title = sec.querySelector<HTMLElement>('[data-cine-title]')!;
    function heroIn(delay = 0) {
      const lines = SplitText.create(title, { type: 'lines', mask: 'lines' }).lines;
      gsap.set(title, { visibility: 'visible' });
      return gsap.timeline({ delay })
        .from(lines, { yPercent: 110, duration: 1.15, ease: 'expo.out', stagger: 0.1 })
        .fromTo('[data-cine-in]', { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.9, stagger: 0.12 }, '-=0.8')
        .fromTo(cue, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.8 }, '-=0.4');
    }

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    document.fonts.ready.then(() => {
      if (!root.classList.contains('show-intro')) {
        heroIn(0.1);
        return;
      }
      // Pantalla de carga (estilo Zentry): el </> se dibuja mientras baja el video (máximo ~2,6 s).
      lenis?.stop();
      window.scrollTo(0, 0);
      const draw = gsap.timeline()
        .fromTo(intro.querySelectorAll('[data-intro-path]'), { drawSVG: '50% 50%' }, { drawSVG: '0% 100%', duration: 0.75, ease: 'power3.inOut', stagger: 0.08 }, 0.15)
        .fromTo(intro.querySelector('[data-intro-slash]'), { drawSVG: '0% 0%' }, { drawSVG: '0% 100%', duration: 0.45, ease: 'power4.out' }, '+=0.05');
      Promise.all([draw.then(), Promise.race([ready, wait(1500)])]).then(() => {
        gsap.timeline()
          .to(intro.querySelector('[data-intro-mark]'), { scale: 0.6, autoAlpha: 0, duration: 0.55, ease: 'power3.in' })
          .to(intro, { autoAlpha: 0, duration: 0.7, ease: 'power2.out' }, '-=0.15')
          .add(() => heroIn(0), '-=0.55')
          .add(() => {
            root.classList.remove('show-intro');
            try { sessionStorage.setItem('rd-intro', '1'); } catch (e) {}
            lenis?.start();
          });
      });
    });
  }
</script>
