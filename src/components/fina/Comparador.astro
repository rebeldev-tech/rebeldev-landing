---
// Comparador de la v3 con un dibujo en la mitad vacía de cada capa, que avanza según cuánto la descubre la manija.
import { comparacion, garantias } from '../../data/estudio';
import { lineas } from '../../data/fina';

const us = lineas.nosotros.marcas;
const them = lineas.agencia.marcas;
---
<section class="wrap fina-sec cmp" aria-labelledby="cmp-title" data-cmp>
  <h2 id="cmp-title" class="text-d2 max-w-[18ch]">Pruébalo antes de pagar.</h2>
  <p class="mt-5 max-w-[46ch] text-lead text-ash">Una agencia tradicional frente a RebelDEV, punto por punto.</p>
  <p id="cmp-hint" class="cmp-hint mt-3 text-note text-ash">Arrastra la barra roja, o usa las flechas, para comparar.</p>

  <div class="cmp-stage mt-12" data-cmp-stage>
    <div class="cmp-layer cmp-them" data-cmp-top>
      <h3 class="cmp-who">Agencia tradicional</h3>
      <dl class="cmp-rows">
        {comparacion.map((f) => <div class="cmp-row"><dt>{f.k}</dt><dd>{f.a}</dd></div>)}
      </dl>
      <div class="cmp-vis cv-them" aria-hidden="true">
        <p class="cv-t">{lineas.agencia.titulo}</p>
        <div class="cv-gantt">
          <span class="cv-grid">{Array.from({ length: 6 }, () => <i></i>)}</span>
          <div class="cv-row" style="--n: 0"><span class="cv-l">{them[0]}</span><span class="cv-lane"><span class="cv-bar cv-striped" style="--a: 0%; --w: 26%"></span></span></div>
          <div class="cv-row" style="--n: 1"><span class="cv-l">{them[1]}</span><span class="cv-lane"><span class="cv-coins" style="--a: 0%"><i></i><i></i><i></i></span></span></div>
          <div class="cv-row" style="--n: 2"><span class="cv-l">{them[2]}</span><span class="cv-lane"><span class="cv-bar cv-gray" style="--a: 22%; --w: 68%"></span></span></div>
          <div class="cv-row" style="--n: 3"><span class="cv-l">{them[3]}</span><span class="cv-lane"><span class="cv-flag" style="--a: 88%"></span></span></div>
          <div class="cv-row" style="--n: 4"><span class="cv-l">{them[4]}</span><span class="cv-lane"><span class="cv-coins" style="--a: 74%"><i></i><i></i><i></i></span></span></div>
        </div>
      </div>
    </div>
    <div class="cmp-layer cmp-us">
      <h3 class="cmp-who">RebelDEV</h3>
      <dl class="cmp-rows">
        {comparacion.map((f) => <div class="cmp-row"><dt>{f.k}</dt><dd>{f.r}</dd></div>)}
      </dl>
      <div class="cmp-vis cv-us" aria-hidden="true">
        <p class="cv-t">{lineas.nosotros.titulo}</p>
        <div class="cv-row" style="--n: 0">
          <span class="cv-l">{us[0]}</span>
          <span class="cv-lane cv-weeks">{[0, 1, 2].map(() => <span class="cv-week"><i></i><i></i><i></i><i></i><i class="is-vie"></i></span>)}</span>
        </div>
        <div class="cv-row" style="--n: 1"><span class="cv-l">{us[1]}</span><span class="cv-lane"><span class="cv-bar cv-amber" style="--a: 0%; --w: 100%"></span></span></div>
        <div class="cv-row" style="--n: 2"><span class="cv-l">{us[2]}</span><span class="cv-lane cv-cuotas"><i></i><i></i><i></i><i></i></span></div>
        <div class="cv-row" style="--n: 3"><span class="cv-l">{us[3]}</span><span class="cv-lane cv-ticks">{Array.from({ length: 8 }, () => <i></i>)}</span></div>
      </div>
    </div>
    <div class="cmp-handle" data-cmp-handle>
      <span class="cmp-line" aria-hidden="true"></span>
      <span
        class="cmp-knob" role="slider" tabindex="0" data-cmp-knob
        aria-label="Comparar agencia tradicional y RebelDEV" aria-describedby="cmp-hint" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-valuetext="50 % agencia tradicional, 50 % RebelDEV"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7 4 12l5 5M15 7l5 5-5 5" /></svg>
      </span>
    </div>
  </div>

  <p class="cmp-garantias mt-14 text-d3">
    {garantias.map((g, i) => <>{i > 0 && <span class="slash" aria-hidden="true">/</span>}<span>{g.t}</span></>)}
  </p>
</section>

<style>
  .cmp-hint { display: none; }
  .cmp.is-live .cmp-hint { display: block; }

  .cmp-stage { display: grid; gap: 1rem; --pu: 1; --pt: 1; }
  @media (min-width: 640px) { .cmp-stage { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .cmp-layer { position: relative; border-radius: 1.5rem; padding: clamp(1.4rem, 3vw, 2.4rem); }
  .cmp-them { background: var(--color-surface); color: var(--color-ash); }
  .cmp-us { background: color-mix(in srgb, var(--color-red) 14%, var(--color-ink)); border: 1px solid color-mix(in srgb, var(--color-red) 40%, transparent); }
  .cmp-who { font-size: clamp(1.3rem, 1.9vw, 1.6rem); line-height: 1.2; letter-spacing: -0.02em; }
  .cmp-them .cmp-who { color: var(--color-ash); }
  .cmp-us .cmp-who { color: var(--color-red-text); }
  .cmp-rows { margin: 1.4rem 0 0; display: grid; }
  .cmp-row { padding-block: 1rem; border-top: 1px solid var(--color-line); }
  .cmp-row dt { font-size: 0.875rem; line-height: 1.5; color: var(--color-ash-dim); }
  .cmp-row dd { margin: 0.3rem 0 0; font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.4; }
  .cmp-us .cmp-row dd { color: var(--color-bone); }
  .cmp-handle { display: none; }

  .cmp.is-live .cmp-stage {
    position: relative; display: grid; grid-template-columns: 1fr; gap: 0; border-radius: 1.75rem; overflow: hidden;
    --p: 50%; --o: 0px; touch-action: pan-y;
  }
  .cmp.is-live .cmp-layer { grid-area: 1 / 1; border-radius: 0; border: 0; }
  .cmp.is-live .cmp-them { z-index: 2; clip-path: polygon(0 0, calc(var(--p) + var(--o)) 0, calc(var(--p) - var(--o)) 100%, 0 100%); }
  .cmp.is-live .cmp-them > :not(.cmp-vis) { max-width: 44%; }
  .cmp.is-live .cmp-us > :not(.cmp-vis) { max-width: 44%; margin-left: auto; text-align: right; }
  .cmp.is-live .cmp-us .cmp-rows { margin-top: 1.4rem; }

  .cmp.is-live .cmp-handle {
    display: block; position: absolute; z-index: 3; top: 0; bottom: 0; left: 0; width: 3rem; margin-left: -1.5rem;
    cursor: grab; touch-action: pan-y;
  }
  .cmp.is-live .cmp-handle:active { cursor: grabbing; }
  .cmp-line {
    position: absolute; left: 50%; top: 50%; width: 4px; height: var(--len, 120%); border-radius: 4px; background: var(--color-red);
    transform: translate(-50%, -50%) rotate(18deg);
  }
  .cmp-knob {
    position: absolute; left: 50%; top: 50%; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 999px;
    background: var(--color-red); color: #fff; transform: translate(-50%, -50%); transition: transform 0.3s var(--ease-out-expo);
  }
  .cmp-handle:hover .cmp-knob, .cmp-knob:focus-visible { transform: translate(-50%, -50%) scale(1.08); }
  .cmp-knob:focus-visible { outline: 2px solid var(--color-bone); outline-offset: 4px; border-radius: 999px; }
  .cmp-knob svg { width: 1.3rem; height: 1.3rem; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  .cmp-garantias { margin-bottom: 0; max-width: 60ch; color: var(--color-bone); font-family: var(--font-display); font-weight: 800; }
  .cmp-garantias .slash { padding-inline: 0.35em; }

  /* Dibujos: cada fila se descubre según --k (0 a 1), que el script toma de la manija; sin manija, completos */
  .cmp-vis { --k: 1; display: grid; gap: 0.9rem; margin-top: 1.75rem; }
  .cv-us { --k: var(--pu); }
  .cv-them { --k: var(--pt); }
  .cv-t { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(1.5rem, 2.4vw, 2.1rem); letter-spacing: -0.03em; line-height: 1; }
  .cv-us .cv-t { color: var(--color-red-text); }
  .cv-them .cv-t { color: var(--color-ash); }
  .cv-row {
    --r: clamp(0, calc(var(--k) * 4.6 - var(--n)), 1);
    display: grid; grid-template-columns: minmax(0, 9.5rem) minmax(0, 1fr); align-items: center; gap: 1rem;
    opacity: calc(0.18 + var(--r) * 0.82);
  }
  .cv-l { font-size: 0.875rem; line-height: 1.3; color: var(--color-ash); }
  .cv-lane { position: relative; display: flex; align-items: center; min-height: 1.5rem; clip-path: inset(-0.5rem calc((1 - var(--r)) * 100%) -0.5rem 0); }

  .cv-gantt { position: relative; display: grid; gap: 0.9rem; }
  .cv-grid { position: absolute; top: -0.4rem; bottom: -0.4rem; left: calc(min(9.5rem, 40%) + 1rem); right: 0; display: flex; justify-content: space-between; pointer-events: none; }
  .cv-grid i { width: 1px; background: var(--color-line); }
  .cv-bar { position: absolute; left: var(--a); width: var(--w); height: 0.75rem; border-radius: 99px; }
  .cv-striped { background: repeating-linear-gradient(135deg, var(--color-ash-dim) 0 6px, transparent 6px 10px); }
  .cv-gray { background: var(--color-ash-dim); }
  .cv-amber { background: var(--color-amber); height: 1rem; }
  .cv-coins { position: absolute; left: var(--a); display: flex; gap: 0.25rem; }
  .cv-coins i { width: 0.95rem; height: 0.95rem; border-radius: 99px; border: 2px solid var(--color-ash-dim); background: var(--color-surface-2); }
  .cv-flag { position: absolute; left: var(--a); width: 2px; height: 1.4rem; background: var(--color-ash); }
  .cv-flag::after { content: ''; position: absolute; left: 2px; top: 0; width: 0.8rem; height: 0.55rem; background: var(--color-ash); clip-path: polygon(0 0, 100% 50%, 0 100%); }

  .cv-weeks { gap: 0.45rem; }
  .cv-week { display: flex; gap: 0.15rem; }
  .cv-week i { width: 0.55rem; height: 1rem; border-radius: 0.15rem; background: color-mix(in srgb, var(--color-bone) 28%, transparent); }
  .cv-week i.is-vie { background: var(--color-red); }
  .cv-cuotas { gap: 0.35rem; }
  .cv-cuotas i { flex: 1; max-width: 2.6rem; height: 0.75rem; border-radius: 99px; background: var(--color-bone); }
  .cv-ticks { justify-content: space-between; }
  .cv-ticks i { width: 3px; height: 1.1rem; border-radius: 3px; background: var(--color-red); }

  /* Con manija: cada dibujo ocupa el 44 % opuesto a su texto, así con la barra al medio no se ve */
  .cmp.is-live .cmp-vis { position: absolute; top: clamp(1.4rem, 3vw, 2.4rem); bottom: clamp(1.4rem, 3vw, 2.4rem); width: 44%; margin: 0; align-content: center; }
  .cmp.is-live .cv-them { right: clamp(1.4rem, 3vw, 2.4rem); }
  .cmp.is-live .cv-us { left: clamp(1.4rem, 3vw, 2.4rem); }
  @media (max-width: 899px) {
    .cv-row { grid-template-columns: 1fr; gap: 0.35rem; }
    .cv-grid { left: 0; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../../scripts/motion';
  import { Draggable } from 'gsap/Draggable';
  import { InertiaPlugin } from 'gsap/InertiaPlugin';

  gsap.registerPlugin(Draggable, InertiaPlugin);

  const sec = document.querySelector<HTMLElement>('[data-cmp]')!;
  const stage = sec.querySelector<HTMLElement>('[data-cmp-stage]')!;
  const handle = sec.querySelector<HTMLElement>('[data-cmp-handle]')!;
  const knob = sec.querySelector<HTMLElement>('[data-cmp-knob]')!;
  const TAN = Math.tan((18 * Math.PI) / 180);

  gsap.matchMedia().add('(min-width: 640px)', () => {
    sec.classList.add('is-live');
    let w = 0, o = 0, pct = 50;

    // pct (0–100) recorre de la esquina izquierda a la derecha, contando la inclinación de la barra.
    const toX = (p: number) => -o + (p / 100) * (w + 2 * o);
    // Con NaN, gsap.utils.clamp devuelve una función en vez de un número: se ignora.
    const sync = (x: number) => {
      if (!Number.isFinite(x)) return;
      pct = gsap.utils.clamp(0, 100, ((x + o) / (w + 2 * o)) * 100);
      stage.style.setProperty('--p', `${x}px`);
      stage.style.setProperty('--pu', String(gsap.utils.clamp(0, 1, (50 - pct) / 40)));
      stage.style.setProperty('--pt', String(gsap.utils.clamp(0, 1, (pct - 50) / 40)));
      const v = Math.round(pct);
      knob.setAttribute('aria-valuenow', String(v));
      knob.setAttribute('aria-valuetext', `${v} % agencia tradicional, ${100 - v} % RebelDEV`);
    };

    const drag = Draggable.create(handle, {
      type: 'x',
      trigger: stage,
      inertia: !reduceMotion,
      edgeResistance: 0.85,
      allowNativeTouchScrolling: true,
      onPress() { gsap.killTweensOf(handle); },
      onDrag() { sync(this.x); },
      onThrowUpdate() { sync(this.x); },
    })[0];

    const measure = () => {
      w = stage.offsetWidth;
      const h = stage.offsetHeight;
      o = (TAN * h) / 2;
      stage.style.setProperty('--o', `${o}px`);
      handle.style.setProperty('--len', `${h / Math.cos((18 * Math.PI) / 180) + 8}px`);
      drag.applyBounds({ minX: -o, maxX: w + o });
      gsap.set(handle, { x: toX(pct) });
      drag.update();
      sync(toX(pct));
    };
    measure();
    const ro = new ResizeObserver(measure);
    ro.observe(stage);

    const goTo = (p: number, vars: gsap.TweenVars = {}) => gsap.to(handle, {
      x: toX(gsap.utils.clamp(0, 100, p)), duration: reduceMotion ? 0 : 0.6, ease: 'power3.out', overwrite: true,
      onUpdate: () => sync(gsap.getProperty(handle, 'x') as number),
      onComplete: () => drag.update(),
      ...vars,
    });

    const onKey = (e: KeyboardEvent) => {
      const step = e.shiftKey ? 20 : 5;
      const keys: Record<string, number> = { ArrowLeft: pct - step, ArrowDown: pct - step, ArrowRight: pct + step, ArrowUp: pct + step, PageDown: pct - 20, PageUp: pct + 20, Home: 0, End: 100 };
      if (!(e.key in keys)) return;
      e.preventDefault();
      goTo(keys[e.key]);
    };
    knob.addEventListener('keydown', onKey);

    // Vaivén de entrada: muestra que la barra se mueve y deja ver un poco de cada dibujo.
    if (!reduceMotion) {
      ScrollTrigger.create({
        trigger: stage, start: 'top 70%', once: true,
        onEnter: () => {
          gsap.timeline({ defaults: { ease: 'sine.inOut', onUpdate: () => sync(gsap.getProperty(handle, 'x') as number) }, onComplete: () => drag.update() })
            .to(handle, { x: toX(66), duration: 0.8 })
            .to(handle, { x: toX(34), duration: 1 })
            .to(handle, { x: toX(50), duration: 0.6 });
        },
      });
    }

    return () => {
      ro.disconnect();
      drag.kill();
      knob.removeEventListener('keydown', onKey);
      gsap.set(handle, { clearProps: 'transform' });
      ['--p', '--o', '--pu', '--pt'].forEach((v) => stage.style.removeProperty(v));
      sec.classList.remove('is-live');
    };
  });
</script>
