---
// Cierre con partículas: el polvo se junta en el </> al bajar. Sin WebGL, el SVG.
import { MARK } from '../../lib/mark';
import { contacto } from '../../data/contacto';

interface Props { titulo: string; bajada: string }
const { titulo, bajada } = Astro.props;
---
<section id="contacto" class="wrap fina-sec ci" aria-labelledby="ci-title" data-ci>
  <canvas class="ci-canvas" data-ci-canvas aria-hidden="true"></canvas>

  <div class="ci-mark" style={`aspect-ratio: ${MARK.width} / ${MARK.height}`} aria-hidden="true" data-ci-slot>
    <svg class="ci-fallback" viewBox={`0 0 ${MARK.width} ${MARK.height}`}>
      <g fill="none" stroke-width={MARK.stroke} stroke-linecap="round" stroke-linejoin="round">
        <path d={MARK.left} stroke="var(--color-bone)" /><path d={MARK.slash} stroke="var(--color-red)" /><path d={MARK.right} stroke="var(--color-bone)" />
      </g>
    </svg>
  </div>

  <div class="ci-text" data-ci-text>
    <h2 id="ci-title" class="text-d1">{titulo}</h2>
    <p class="mt-6 max-w-[40ch] text-lead text-ash">{bajada}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={contacto.whatsappLink} target="_blank" rel="noopener" class="btn btn-primary" data-magnetic>Agenda una demo por WhatsApp</a>
      <a href={`mailto:${contacto.correo}`} class="btn btn-ghost">Escríbenos</a>
    </div>
  </div>
</section>

<style>
  /* Solo recorta arriba y abajo: a los lados el polvo puede salir de la columna (.fina ya evita el scroll horizontal) */
  .ci { position: relative; overflow-x: visible; overflow-y: clip; display: grid; gap: clamp(3rem, 6vw, 5rem); }
  @media (min-width: 1024px) {
    .ci { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; min-height: 100svh; }
  }
  /* El lienzo va de borde a borde de la ventana (la sección es más angosta en pantallas anchas) y se desvanece
     cerca de los bordes: el polvo se pierde de a poco, en vez de cortarse en una línea recta. En el celular,
     el borde de los lados es el de la pantalla (calc da 0) y el </> armado no se toca. */
  .ci-canvas {
    position: absolute; top: 0; left: 50%; width: 100vw; height: 100%; translate: -50% 0; pointer-events: none;
    mask-image:
      linear-gradient(to right, transparent, #000 max(0px, calc(8% - 2.5rem)), #000 calc(100% - max(0px, calc(8% - 2.5rem))), transparent),
      linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
    mask-composite: intersect;
  }
  .ci-mark { position: relative; width: min(100%, 40rem); justify-self: center; }
  .ci-fallback { width: 100%; height: 100%; overflow: visible; }
  .ci.particles-on .ci-fallback { visibility: hidden; }
  .ci-text { position: relative; z-index: 1; }
  .ci-text h2 { max-width: 14ch; }
  :global(html.has-motion) [data-ci-text] > * { visibility: hidden; }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion, coarsePointer } from '../../scripts/motion';

  const sec = document.querySelector<HTMLElement>('[data-ci]')!;
  const canvas = sec.querySelector<HTMLCanvasElement>('[data-ci-canvas]')!;
  const slot = sec.querySelector<HTMLElement>('[data-ci-slot]')!;

  // scatter: 1 = polvo, 0 = </> armado.
  import('../../scripts/particles')
    .then(({ ParticleMark }) => {
      if (!ParticleMark.supported()) return;
      const pm = new ParticleMark(canvas, slot, { interactive: !reduceMotion && !coarsePointer, still: reduceMotion, formado: true, polvo: 2.2 });
      sec.classList.add('particles-on');
      if (reduceMotion) { pm.scatter = 0; return; }
      pm.scatter = 1;
      ScrollTrigger.create({
        trigger: sec, start: 'top bottom', end: 'center 55%', scrub: 0.6,
        onUpdate: (self) => { pm.scatter = 1 - self.progress; },
      });
      pm.start();
    })
    .catch((e) => console.warn('[rebeldev] partículas desactivadas', e));

  if (!reduceMotion) {
    gsap.fromTo('[data-ci-text] > *', { autoAlpha: 0, y: 24 }, {
      autoAlpha: 1, y: 0, duration: 1, ease: 'expo.out', stagger: 0.12,
      scrollTrigger: { trigger: '[data-ci-text]', start: 'top 70%', once: true },
    });
  }
</script>
