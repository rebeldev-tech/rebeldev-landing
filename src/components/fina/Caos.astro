---
// «Del caos al sistema» (base: v3/CaosSistema): caos, diagnóstico con escáner, encaje por capas y una pieza nueva por capa. Piezas ilustrativas.
import { pasosCaos, capas, piezas } from '../../data/v3';
import { caos } from '../../data/fina';

const nuevaDe = (capa: string) => caos.nuevas.find((n) => n.capa === capa);
---
<section id="como" class="cs" data-cs data-pulso={JSON.stringify(caos.pulso)} aria-labelledby="cs-title">
  <h2 id="cs-title" class="sr-only">Cómo trabajamos</h2>
  <div class="wrap cs-grid">
    <ol class="cs-steps" data-cs-steps>
      {pasosCaos.map((p, i) => (
        <li class="cs-step" data-cs-step>
          <span class="cs-n-mask" aria-hidden="true"><span class="cs-n text-note" data-cs-n>{i + 1}<span class="cs-of">/{pasosCaos.length}</span></span></span>
          <h3 class="text-d2 cs-t" data-cs-split>{p.t}</h3>
          <p class="mt-4 text-lead text-ash cs-d" data-cs-split>{p.d}</p>
        </li>
      ))}
    </ol>

    <div class="cs-stage" data-cs-stage aria-hidden="true">
      <div class="cs-zoom" data-cs-zoom>
        <div class="cs-chaos" data-cs-chaos></div>
        <svg class="cs-links" data-cs-links></svg>

        <div class="cs-order">
          <div class="cs-rows" data-cs-rows>
            {capas.map((c, ci) => {
              const nueva = nuevaDe(c.id);
              return (
                <div class="cs-row" data-cs-row data-capa={c.id}>
                  <p class="cs-label text-note" data-cs-label>{c.t}</p>
                  <div class="cs-box">
                    <svg class="cs-frame"><rect data-cs-frame width="100%" height="100%" rx="12" pathLength="100" /></svg>
                    <ul class="cs-slots">
                      {piezas.filter((p) => p.capa === c.id).map((p) => {
                        const n = piezas.indexOf(p);
                        const aviso = caos.avisos[p.antes];
                        return (
                          <li class="cs-slot">
                            <span class="pz" data-pz data-x={p.x} data-y={p.y} data-r={p.r} data-capa={p.capa} data-despues={p.despues}>
                              <span class="pz-off" data-pz-off>
                                <span class="pz-in" data-pz-in style={`--dur:${4 + (n % 5) * 0.7}s;animation-delay:${-n * 0.6}s`}>
                                  <span class="pz-dot"></span>
                                  <span class="pz-txt"><span class="pz-a">{p.antes}</span><span class="pz-d" data-pz-d>{p.despues}</span></span>
                                  {aviso && <span class:list={['pz-badge', { 'is-round': aviso.length < 3 }]} data-pz-badge>{aviso}</span>}
                                  <span class="pz-tag" data-pz-tag>{caos.etiquetas[p.capa]}</span>
                                </span>
                              </span>
                            </span>
                          </li>
                        );
                      })}
                      {nueva && (
                        <li class="cs-slot cs-slot-new">
                          <span class="cs-hole" data-cs-hole></span>
                          <span class="pz pz-new" data-cs-new>
                            <span class="pz-in">
                              <span class="pz-dot"></span>
                              <span class="pz-txt"><span class="pz-d">{nueva.t}</span></span>
                              <span class="pz-ring" data-pz-ring></span>
                            </span>
                          </span>
                        </li>
                      )}
                    </ul>
                  </div>
                  {ci < capas.length - 1 && <span class="cs-wire" data-cs-wire></span>}
                </div>
              );
            })}
            <svg class="cs-sys"><rect data-cs-sys width="100%" height="100%" rx="18" pathLength="100" /></svg>
            <span class="cs-pulse" data-cs-pulse></span>
          </div>
        </div>

        <span class="cs-scan" data-cs-scan></span>
      </div>
    </div>
  </div>
</section>

<style>
  .cs { position: relative; padding-block: clamp(5rem, 10vw, 8rem); }
  .cs-grid { display: grid; gap: 3rem; }
  .cs-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.5rem; }
  .cs-n-mask { display: block; overflow: clip; margin-bottom: 0.9rem; }
  .cs-n { display: block; font-variant-numeric: tabular-nums; color: var(--color-red-text); }
  .cs-of { color: var(--color-ash-dim); }
  .cs-t { margin: 0; max-width: 18ch; }
  .cs-d { margin-bottom: 0; max-width: 40ch; }

  /* Recorte arriba: las piezas que caen del hero entran por el mismo borde por donde salen las del hero */
  .cs { overflow-y: clip; }
  .cs-stage { --amp: 0px; position: relative; min-height: 26rem; }
  .cs-zoom { position: relative; }
  .cs-chaos { position: absolute; inset: 0; pointer-events: none; }
  .cs-links { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .cs-links :global(line) { stroke: var(--color-ash-dim); stroke-width: 1.25; }
  .cs-links :global(circle) { fill: var(--color-red-text); }
  .cs-links :global(.cs-trav) { filter: drop-shadow(0 0 5px var(--color-red-text)); }
  .cs-rows { position: relative; display: grid; gap: 1.6rem; }
  .cs-row { position: relative; display: grid; gap: 0.55rem; }
  .cs-label { margin: 0; color: var(--color-ash); }
  .cs-box { position: relative; }
  .cs-slots { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; }
  .cs-slot { position: relative; min-height: 3.1rem; border-radius: 0.7rem; display: flex; }
  /* flex: none para que la ranura no apriete la pieza mientras todavía está «en el caos» */
  .cs-slot > .pz { flex: none; }
  .cs-wire { position: absolute; left: 50%; bottom: -1.6rem; width: 2px; height: 1.6rem; background: var(--color-red); transform-origin: top; }

  /* pathLength 100: el trazo se dibuja igual aunque cambie el tamaño */
  .cs-frame, .cs-sys { position: absolute; overflow: visible; pointer-events: none; }
  .cs-frame { inset: -6px; width: calc(100% + 12px); height: calc(100% + 12px); }
  .cs-sys { inset: -14px; width: calc(100% + 28px); height: calc(100% + 28px); }
  .cs-frame rect, .cs-sys rect { fill: none; stroke-dasharray: 100; stroke-dashoffset: 0; }
  .cs-frame rect { stroke: var(--color-line-strong); stroke-width: 1; }
  .cs-sys rect { stroke: var(--color-red); stroke-width: 1.5; }

  /* Tres capas para que ninguna animación pise a otra: .pz la mueve Flip, .pz-off el desorden y .pz-in la tarjeta */
  .pz { position: relative; display: flex; width: 100%; }
  .pz-off { display: flex; width: 100%; }
  .pz-in {
    position: relative; display: flex; align-items: center; gap: 0.55rem; width: 100%;
    padding: 0.7rem 0.85rem; border-radius: 0.7rem; background: var(--color-surface); border: 1px solid var(--color-line-strong);
    font-size: 0.92rem; line-height: 1.25; color: var(--color-bone); white-space: normal;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .pz-dot { flex: none; width: 7px; height: 7px; border-radius: 99px; background: var(--color-red-text); transition: box-shadow 0.3s; }
  .pz-txt { display: grid; }
  .pz-a, .pz-d { grid-area: 1 / 1; }
  .pz-a { visibility: hidden; }
  .pz-new .pz-in { border-color: color-mix(in srgb, var(--color-red) 60%, transparent); }
  .pz-in:global(.is-hit) { border-color: var(--color-red); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-red) 22%, transparent); }
  .pz-in:global(.is-hit) .pz-dot { box-shadow: 0 0 10px 2px var(--color-red-text); }

  .pz-badge, .pz-tag, .pz-ring, .cs-hole, .cs-scan, .cs-pulse { display: none; }
  .cs:global(.is-live) .pz-badge {
    display: block; position: absolute; top: -0.55rem; right: -0.45rem; padding: 0.12rem 0.45rem; border-radius: 99px;
    background: var(--color-red); color: #fff; font-size: 0.68rem; font-weight: 600; line-height: 1.3; white-space: nowrap;
  }
  .cs:global(.is-live) .pz-badge.is-round { min-width: 1.15rem; text-align: center; }
  .cs:global(.is-chaos) .pz-badge { animation: pz-ping 1.6s ease-in-out infinite; }
  @keyframes pz-ping { 50% { scale: 1.12; } }
  .cs:global(.is-live) .pz-tag {
    display: block; position: absolute; left: 0.6rem; top: 0; translate: 0 -58%; padding: 0.05rem 0.4rem; border-radius: 0.3rem;
    background: var(--color-ink); border: 1px solid color-mix(in srgb, var(--color-red) 50%, transparent);
    color: var(--color-red-text); font-size: 0.68rem; font-weight: 600; line-height: 1.35; white-space: nowrap;
  }
  .cs:global(.is-live) .pz-ring { display: block; position: absolute; inset: -1px; border-radius: inherit; border: 2px solid var(--color-red); pointer-events: none; }
  .cs:global(.is-live) .cs-hole { display: block; position: absolute; inset: 0; border-radius: 0.7rem; border: 1px dashed var(--color-line-strong); pointer-events: none; }
  .cs:global(.is-live) .cs-scan {
    display: block; position: absolute; z-index: 3; left: 0; top: -20%; width: 4px; height: 140%; margin-left: -2px; border-radius: 4px;
    background: var(--color-red); box-shadow: 0 0 22px 2px color-mix(in srgb, var(--color-red) 55%, transparent); pointer-events: none;
  }
  .cs:global(.is-live) .cs-pulse {
    display: block; position: absolute; z-index: 4; left: 0; top: 0; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 99px;
    background: var(--color-red-text); box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-red) 25%, transparent), 0 0 18px var(--color-red-text);
    pointer-events: none;
  }

  .cs-chaos .pz { position: absolute; width: auto; }
  .cs-chaos .pz-in { max-width: 15rem; white-space: nowrap; }
  :global(.cs.is-chaos) .pz-in { animation: pz-float var(--dur, 5s) ease-in-out infinite alternate; }
  @keyframes pz-float { from { translate: 0 calc(var(--amp) * -1); } to { translate: 0 var(--amp); } }

  :global(html.has-motion) .cs-stage { visibility: hidden; }

  @media (min-width: 640px) {
    .cs-slots { gap: 0.65rem; }
    .pz-in { font-size: 0.98rem; }
  }
  @media (max-width: 639px) {
    .cs-slots { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cs-wire { display: none; }
  }

  @media (min-width: 1024px) {
    .cs-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(3rem, 6vw, 6rem); align-items: center; }
    :global(html.has-motion) .cs.is-pinned { height: 100vh; padding-block: 0; display: flex; align-items: center; }
    :global(html.has-motion) .cs.is-pinned .cs-steps { display: block; position: relative; min-height: 22rem; }
    :global(html.has-motion) .cs.is-pinned .cs-step { position: absolute; inset: 0 0 auto 0; }
    :global(html.has-motion) .cs.is-pinned .cs-t { text-wrap: wrap; }
    :global(html.has-motion) .cs.is-pinned .cs-stage { height: min(74vh, 42rem); }
    :global(html.has-motion) .cs.is-pinned .cs-zoom { height: 100%; }
    :global(html.has-motion) .cs.is-pinned .cs-order { position: absolute; inset: 0; display: grid; align-content: center; }
  }
  /* La sombra sin desenfoque tapa la franja de arriba cuando la barra se esconde al bajar */
  .cs.is-mobile .cs-stage { order: -1; position: sticky; top: 4.25rem; z-index: 1; min-height: 0; padding-block: 0.75rem; background: var(--color-ink); box-shadow: 0 -4.25rem 0 var(--color-ink); }
  .cs.is-mobile .cs-rows { gap: 0.9rem; }
  .cs.is-mobile .cs-slots { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.3rem; }
  .cs.is-mobile .cs-slot { min-height: 2.4rem; }
  .cs.is-mobile .cs-wire { display: block; bottom: -0.9rem; height: 0.9rem; }
  .cs.is-mobile .pz-in { padding: 0.4rem 0.45rem; font-size: 0.68rem; gap: 0.3rem; border-radius: 0.5rem; }
  .cs.is-mobile .pz-dot { width: 5px; height: 5px; }
  .cs.is-mobile .pz-tag, .cs.is-mobile .pz-badge { font-size: 0.6rem; }
  /* Con menos relleno, la etiqueta va casi entera por encima para no tapar el texto */
  .cs.is-mobile .pz-tag { translate: 0 -88%; }
  .cs.is-mobile .cs-label { font-size: 0.72rem; }
  .cs.is-mobile .cs-chaos .pz-in { max-width: 9.5rem; }
  .cs.is-mobile .cs-steps { gap: 0; }
  .cs.is-mobile .cs-step { min-height: 55vh; padding-top: 1.5rem; transition: opacity 0.5s; }
  .cs.is-mobile .cs-step:not(.is-on) { opacity: 0.6; }
  .cs.is-mobile .cs-t { font-size: clamp(1.5rem, 6.4vw, 2rem); }
  /* Celular en horizontal: pasos a la izquierda y el marco fijo a la derecha, más compacto para que entre bajo la barra */
  @media (max-width: 1023px) and (max-height: 520px) and (orientation: landscape) {
    .cs-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); column-gap: 1.5rem; align-items: start; }
    .cs.is-mobile .cs-stage { order: 0; grid-column: 2; grid-row: 1; padding-block: 0.4rem; }
    .cs.is-mobile .cs-steps { grid-column: 1; grid-row: 1; }
    .cs.is-mobile .cs-step { min-height: 75vh; }
    .cs.is-mobile .cs-t { font-size: 1.5rem; }
    .cs.is-mobile .cs-rows { gap: 0.55rem; }
    .cs.is-mobile .cs-row { gap: 0.3rem; }
    .cs.is-mobile .cs-label { font-size: 0.68rem; }
    .cs.is-mobile .cs-slot { min-height: 2.1rem; }
    .cs.is-mobile .cs-wire { bottom: -0.55rem; height: 0.55rem; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, SplitText, reduceMotion } from '../../scripts/motion';
  import { Flip } from 'gsap/Flip';
  import { ScrambleTextPlugin } from 'gsap/ScrambleTextPlugin';

  gsap.registerPlugin(Flip, ScrambleTextPlugin);

  type P = { x: number; y: number };
  const sec = document.querySelector<HTMLElement>('[data-cs]')!;
  const stage = sec.querySelector<HTMLElement>('[data-cs-stage]')!;
  const zoom = sec.querySelector<HTMLElement>('[data-cs-zoom]')!;
  const chaos = sec.querySelector<HTMLElement>('[data-cs-chaos]')!;
  const svg = sec.querySelector<SVGSVGElement>('[data-cs-links]')!;
  const rowsEl = sec.querySelector<HTMLElement>('[data-cs-rows]')!;
  const pulse = sec.querySelector<HTMLElement>('[data-cs-pulse]')!;
  const scan = sec.querySelector<HTMLElement>('[data-cs-scan]')!;
  const steps = gsap.utils.toArray<HTMLElement>('[data-cs-step]', sec);
  const pieces = gsap.utils.toArray<HTMLElement>('[data-pz]', sec);
  const offs = pieces.map((p) => p.querySelector<HTMLElement>('[data-pz-off]')!);
  const ins = pieces.map((p) => p.querySelector<HTMLElement>('[data-pz-in]')!);
  const tags = pieces.map((p) => p.querySelector<HTMLElement>('[data-pz-tag]')!);
  const slots = pieces.map((p) => p.parentElement!);
  const pzA = pieces.map((p) => p.querySelector<HTMLElement>('.pz-a')!);
  const pzD = pieces.map((p) => p.querySelector<HTMLElement>('[data-pz-d]')!);
  const badges = gsap.utils.toArray<HTMLElement>('[data-pz-badge]', sec);
  const news = gsap.utils.toArray<HTMLElement>('[data-cs-new]', sec);
  const holes = gsap.utils.toArray<HTMLElement>('[data-cs-hole]', sec);
  const rings = news.map((n) => n.querySelector<HTMLElement>('[data-pz-ring]')!);
  const labels = gsap.utils.toArray<HTMLElement>('[data-cs-label]', sec);
  const wires = gsap.utils.toArray<HTMLElement>('[data-cs-wire]', sec);
  const frames = gsap.utils.toArray<SVGRectElement>('[data-cs-frame]', sec);
  const sysRect = sec.querySelector<SVGRectElement>('[data-cs-sys]')!;
  const capaOrder = gsap.utils.toArray<HTMLElement>('[data-cs-row]', sec).map((r) => r.dataset.capa!);
  const capaOf = (i: number) => capaOrder.indexOf(pieces[i].dataset.capa!);
  const kOf = (i: number) => pieces.slice(0, i).filter((p) => p.dataset.capa === pieces[i].dataset.capa).length;
  const route = (JSON.parse(sec.dataset.pulso || '[]') as string[]).map((t) => pieces.findIndex((p) => p.dataset.despues === t)).filter((i) => i >= 0);
  const NS = 'http://www.w3.org/2000/svg';
  const ANG = (18 * Math.PI) / 180, TAN = Math.tan(ANG);
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  const T = { s2: 1.1, s3: 3.6, s4: 6.7 };

  function drawLinks() {
    svg.replaceChildren();
    const sr = stage.getBoundingClientRect();
    const center = (el: Element): P => { const r = el.getBoundingClientRect(); return { x: r.left - sr.left + r.width / 2, y: r.top - sr.top + r.height / 2 }; };
    const make = <K extends 'line' | 'circle'>(tag: K, attrs: Record<string, string | number>) => {
      const el = document.createElementNS(NS, tag);
      Object.entries(attrs).forEach(([k, v]) => el.setAttribute(k, String(v)));
      svg.appendChild(el);
      return el;
    };
    const lines: SVGLineElement[] = [], ends: SVGCircleElement[] = [], travelers: { el: SVGCircleElement; s: P; e: P }[] = [];
    capaOrder.forEach((capa) => {
      const list = ins.filter((_, i) => pieces[i].dataset.capa === capa);
      list.slice(1).forEach((el, i) => {
        const s = center(list[i]), e = center(el);
        lines.push(make('line', { x1: s.x, y1: s.y, x2: e.x, y2: e.y }));
        ends.push(make('circle', { cx: e.x, cy: e.y, r: 3 }));
        travelers.push({ el: make('circle', { cx: s.x, cy: s.y, r: 3.5, class: 'cs-trav' }), s, e });
      });
    });
    return { lines, ends, travelers };
  }

  function build(pinned: boolean) {
    sec.classList.add(pinned ? 'is-pinned' : 'is-mobile', 'is-chaos', 'is-live');
    const W = stage.clientWidth, H = stage.clientHeight;
    const clamp = gsap.utils.clamp;
    // En celular la altura sale del contenido: sin las piezas en sus casillas el marco se encogería y el caos quedaría afuera.
    if (!pinned) stage.style.minHeight = `${H}px`;

    // .pz queda en su grupo «en el aire» (de ahí parte Flip) y .pz-off la corre hasta su sitio en el caos.
    pieces.forEach((p) => chaos.appendChild(p));
    const size = pieces.map((p) => ({ w: p.offsetWidth, h: p.offsetHeight }));
    const caosPos = pieces.map((p, i) => ({
      x: clamp(0, W - size[i].w, (Number(p.dataset.x) / 100) * W),
      y: clamp(0, H - size[i].h, (Number(p.dataset.y) / 100) * H),
    }));
    const centros = [[0.27, 0.27], [0.73, 0.3], [0.3, 0.73], [0.72, 0.7]];
    const grupo = pieces.map((_, i) => {
      const [cx, cy] = centros[capaOf(i)], k = kOf(i);
      return {
        x: clamp(0, W - size[i].w, cx * W - size[i].w / 2 + (k - 1) * 22),
        y: clamp(0, H - size[i].h, cy * H - size[i].h / 2 + (k - 1) * size[i].h * 0.8),
      };
    });
    const depth = pieces.map((_, i) => i % 3); // 0 lejos, 2 cerca
    pieces.forEach((p, i) => gsap.set(p, { left: grupo[i].x, top: grupo[i].y, zIndex: depth[i] + 1 }));
    offs.forEach((o, i) => gsap.set(o, { x: caosPos[i].x - grupo[i].x, y: caosPos[i].y - grupo[i].y, rotation: Number(pieces[i].dataset.r) }));
    ins.forEach((el, i) => gsap.set(el, { scale: [0.84, 0.92, 1][depth[i]], opacity: [0.72, 0.86, 1][depth[i]] }));

    gsap.set(pzA, { visibility: 'visible', autoAlpha: 1 });
    gsap.set(pzD, { autoAlpha: 0 });
    gsap.set(stage, { '--amp': pinned ? '7px' : '4px' });
    const { lines, ends, travelers } = drawLinks();
    gsap.set(lines, { drawSVG: '0% 0%' });
    gsap.set(ends, { scale: 0, transformOrigin: '50% 50%' });
    gsap.set(travelers.map((t) => t.el), { autoAlpha: 0 });
    const state = Flip.getState(pieces);

    pieces.forEach((p, i) => { slots[i].appendChild(p); gsap.set(p, { clearProps: 'left,top,zIndex' }); });
    const delay = new Map(pieces.map((p, i) => [p, capaOf(i) * 0.14 + kOf(i) * 0.04]));
    const flip = Flip.from(state, { duration: 1.2, ease: 'expo.inOut', absolute: true, stagger: (i: number, el: Element) => delay.get(el as HTMLElement) ?? i * 0.04 });

    gsap.set([...labels, ...holes, ...tags], { autoAlpha: 0 });
    gsap.set([...frames, sysRect], { strokeDashoffset: 100 });
    gsap.set(wires, { scaleY: 0 });
    gsap.set(scan, { autoAlpha: 0, rotation: 18, x: -0.15 * W });
    gsap.set(pulse, { autoAlpha: 0 });
    const d = H * 0.7;
    gsap.set(news, { x: Math.sin(ANG) * d, y: -Math.cos(ANG) * d, rotation: 18, autoAlpha: 0 });
    gsap.set(rings, { autoAlpha: 0 });

    const lineSets: Element[][] = steps.map((s) => {
      const n = s.querySelector('[data-cs-n]')!;
      if (!pinned) return [n];
      const parts = gsap.utils.toArray<HTMLElement>('[data-cs-split]', s).flatMap((el) => SplitText.create(el, { type: 'lines', mask: 'lines' }).lines);
      return [n, ...parts];
    });
    if (pinned) gsap.set(lineSets.slice(1).flat(), { yPercent: 110 });

    const starts = [T.s2, T.s3, T.s4];
    let repel = true;
    const show = (k: number) => steps.forEach((s, i) => s.classList.toggle('is-on', i === k));
    const sync = () => {
      const t = tl.time();
      show(starts.filter((t0) => t >= t0).length);
      const on = t < T.s3;
      if (on !== repel) { repel = on; if (!on) ins.forEach((el) => gsap.to(el, { x: 0, y: 0, duration: 0.4, overwrite: 'auto' })); }
    };

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: pinned
        ? { trigger: sec, start: 'top top', end: '+=480%', pin: true, scrub: 0.7, refreshPriority: 1, onUpdate: sync }
        : { trigger: sec.querySelector('[data-cs-steps]'), start: 'top 70%', end: 'bottom 75%', scrub: 0.7, onUpdate: sync },
    });

    if (pinned) {
      const swap = (k: number, at: number) => tl
        .to(lineSets[k], { yPercent: -110, duration: 0.3, stagger: 0.03, ease: 'power2.in' }, at)
        .fromTo(lineSets[k + 1], { yPercent: 110 }, { yPercent: 0, duration: 0.45, stagger: 0.04, ease: 'power3.out', immediateRender: false }, at + 0.24);
      swap(0, T.s2 - 0.25); swap(1, T.s3 - 0.25); swap(2, T.s4 - 0.25);
    }

    const sc0 = T.s2 + 0.15, scDur = 1.3, x0 = -0.15 * W, x1 = 1.15 * W;
    tl.to(scan, { autoAlpha: 1, duration: 0.1 }, sc0)
      .fromTo(scan, { x: x0 }, { x: x1, duration: scDur, immediateRender: false }, sc0)
      .to(scan, { autoAlpha: 0, duration: 0.12 }, sc0 + scDur - 0.12);
    const sr = stage.getBoundingClientRect();
    ins.forEach((el, i) => {
      const r = el.getBoundingClientRect();
      const cx = r.left - sr.left + r.width / 2, cy = r.top - sr.top + r.height / 2;
      // Barra inclinada: a la altura cy pasa por x_c + (H/2 - cy)·tan18.
      const f = clamp(0, 1, (cx - (H / 2 - cy) * TAN - x0) / (x1 - x0));
      const at = sc0 + f * scDur;
      tl.fromTo(tags[i], { autoAlpha: 0, scale: 0.6 }, { autoAlpha: 1, scale: 1, duration: 0.18, ease: 'back.out(2)', immediateRender: false }, at);
    });
    const lk = sc0 + scDur + 0.05;
    tl.to(lines, { drawSVG: '0% 100%', duration: 0.5, stagger: 0.05 }, lk)
      .to(ends, { scale: 1, duration: 0.2, stagger: 0.05 }, lk + 0.3);
    travelers.forEach((t, j) => {
      tl.to(t.el, { autoAlpha: 1, duration: 0.05 }, lk + 0.35 + j * 0.05)
        .fromTo(t.el, { attr: { cx: t.s.x, cy: t.s.y } }, { attr: { cx: t.e.x, cy: t.e.y }, duration: 0.55, ease: 'power1.inOut', immediateRender: false }, lk + 0.35 + j * 0.05);
    });

    const g = T.s3 + 0.1;
    tl.to([...lines, ...ends, ...travelers.map((t) => t.el)], { autoAlpha: 0, duration: 0.3 }, g)
      .to(stage, { '--amp': '0px', duration: 0.5 }, g)
      .to(badges, { autoAlpha: 0, scale: 0.6, duration: 0.25 }, g)
      .to(offs, { x: 0, y: 0, rotation: 0, duration: 0.8, ease: 'power3.inOut', stagger: 0.02 }, g + 0.1)
      .to(ins, { scale: 1, opacity: 1, duration: 0.8, ease: 'power3.inOut' }, g + 0.1)
      .to(tags, { autoAlpha: 0, duration: 0.25 }, g + 1.0)
      .add(flip, g + 1.0)
      .to(pzA, { autoAlpha: 0, duration: 0.25, stagger: 0.04 }, g + 1.6)
      .to(pzD, { autoAlpha: 1, duration: 0.1, stagger: 0.04 }, g + 1.65)
      .to(pzD, { scrambleText: { text: '{original}', chars: '</>01', speed: 0.5 }, duration: 0.7, stagger: 0.04 }, g + 1.65)
      .to(frames, { strokeDashoffset: 0, duration: 0.6, stagger: 0.12, ease: 'power2.inOut' }, g + 2.1)
      .to(labels, { autoAlpha: 1, duration: 0.4, stagger: 0.1 }, g + 2.3)
      .to(wires, { scaleY: 1, duration: 0.35, stagger: 0.12 }, g + 2.5);

    const pState = { p: 0 };
    const place = () => {
      const p = pState.p, live = p > 0 && p < 1;
      const rr = rowsEl.getBoundingClientRect(), k = rr.width / rowsEl.offsetWidth || 1;
      const pts = route.map((i) => { const r = slots[i].getBoundingClientRect(); return { x: (r.left + r.width / 2 - rr.left) / k, y: (r.top + r.height / 2 - rr.top) / k }; });
      if (pts.length < 2) return;
      const seg = p * (pts.length - 1), i = Math.min(pts.length - 2, Math.floor(seg)), f = seg - i;
      gsap.set(pulse, { x: pts[i].x + (pts[i + 1].x - pts[i].x) * f, y: pts[i].y + (pts[i + 1].y - pts[i].y) * f, autoAlpha: live ? 1 : 0 });
      route.forEach((pi, j) => ins[pi].classList.toggle('is-hit', live && Math.abs(seg - j) < 0.35));
    };
    const pass = (at: number) => tl.fromTo(pState, { p: 0 }, { p: 1, duration: 0.9, immediateRender: false, onUpdate: place }, at);
    const h = T.s4 + 0.2, nw = h + 1.3;
    pass(h);
    tl.to(zoom, { scale: 0.92, transformOrigin: '50% 50%', duration: 0.5, ease: 'power2.inOut' }, h + 0.8)
      .to(holes, { autoAlpha: 1, duration: 0.25, stagger: 0.1 }, h + 1.0);
    news.forEach((n, j) => {
      const at = nw + j * 0.5;
      tl.to(n, { x: 0, y: 0, rotation: 0, autoAlpha: 1, duration: 0.55, ease: 'power3.out' }, at)
        .fromTo(rings[j], { autoAlpha: 1, scale: 1 }, { autoAlpha: 0, scale: 1.18, duration: 0.4, ease: 'power2.out', immediateRender: false }, at + 0.5)
        .to(holes[j], { autoAlpha: 0, duration: 0.2 }, at + 0.5);
    });
    pass(nw + 0.2);
    pass(nw + 1.2);
    tl.to(sysRect, { strokeDashoffset: 0, duration: 0.8, ease: 'power2.inOut' }, nw + 2.2)
      .to({}, { duration: 0.6 });
    show(0);

    // Caída desde el hero en yPercent, para no chocar con la x/y del desorden.
    gsap.fromTo(offs, { yPercent: (i: number) => -((H * (0.55 + (2 - depth[i]) * 0.2)) / (offs[i].offsetHeight || 40)) * 100 }, {
      yPercent: 0, ease: 'none',
      scrollTrigger: { trigger: pinned ? sec : stage, start: 'top bottom', end: pinned ? 'top top' : 'top 40%', scrub: 0.6 },
    });

    const qx = ins.map((el) => gsap.quickTo(el, 'x', { duration: 0.6, ease: 'power3.out' }));
    const qy = ins.map((el) => gsap.quickTo(el, 'y', { duration: 0.6, ease: 'power3.out' }));
    let raf = 0;
    const onMove = (e: PointerEvent) => {
      if (!repel || raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        offs.forEach((o, i) => {
          const r = o.getBoundingClientRect();
          const dx = r.left + r.width / 2 - e.clientX, dy = r.top + r.height / 2 - e.clientY;
          const dist = Math.hypot(dx, dy) || 1, push = Math.max(0, 1 - dist / 170) * (18 + depth[i] * 10);
          qx[i]((dx / dist) * push); qy[i]((dy / dist) * push);
        });
      });
    };
    const onLeave = () => ins.forEach((_, i) => { qx[i](0); qy[i](0); });
    if (pinned && finePointer) {
      stage.addEventListener('pointermove', onMove);
      stage.addEventListener('pointerleave', onLeave);
    }

    gsap.set(stage, { visibility: 'visible' });

    return () => {
      flip.kill();
      cancelAnimationFrame(raf);
      stage.removeEventListener('pointermove', onMove);
      stage.removeEventListener('pointerleave', onLeave);
      pieces.forEach((p, i) => { slots[i].appendChild(p); });
      svg.replaceChildren();
      stage.style.minHeight = '';
      gsap.set([...pieces, ...offs, ...ins, ...news, zoom, pulse], { clearProps: 'all' });
      ins.forEach((el) => el.classList.remove('is-hit'));
      sec.classList.remove('is-pinned', 'is-mobile', 'is-chaos', 'is-live');
      steps.forEach((s) => s.classList.remove('is-on'));
    };
  }

  if (!reduceMotion) {
    document.fonts.ready.then(() => {
      gsap.matchMedia().add({ desk: '(min-width: 1024px)', mob: '(max-width: 1023px)' }, (ctx) => build(!!ctx.conditions!.desk));
      // El pin se crea después de los ScrollTrigger de más abajo: reordenarlos para que cuenten su espacio.
      ScrollTrigger.sort();
      ScrollTrigger.refresh();
    });
  }
</script>
