---
// Fredy: su frase textual (de la entrevista), quién es y su trayectoria en una sola línea unida por la
// barra roja. Sección quieta. Solo datos aprobados (CLAUDE.md, sección 5): sin su trabajo actual, sin
// edad ni datos personales.
import { cita, fundador } from '../../data/estudio';
---
<section id="fredy" class="wrap v4-sec fd" aria-labelledby="fd-name">
  <figure class="fd-fig">
    <blockquote class="fd-quote">
      <p class="text-d2">{cita}</p>
    </blockquote>
    <figcaption class="fd-cap">
      <h2 id="fd-name" class="text-d3 fd-name">Fredy Ramos</h2>
      <p class="text-body text-ash">{fundador.cargo}</p>
    </figcaption>
  </figure>

  <div class="fd-more">
    <p class="text-note text-ash fd-form">{fundador.formacion}</p>
    <ol role="list" class="text-body fd-tray" aria-label="Trayectoria de Fredy">
      {fundador.trayectoria.map((t, i) => (
        <li>{i > 0 && <span class="slash" aria-hidden="true">/</span>}{t}</li>
      ))}
    </ol>
  </div>
</section>

<style>
  .fd-fig { margin: 0; }
  .fd-quote { margin: 0; }
  .fd-quote p { margin: 0; max-width: 20ch; }
  .fd-cap { margin-top: 2.5rem; display: grid; gap: 0.25rem; }
  .fd-name, .fd-cap p { margin: 0; }

  .fd-more { margin-top: 2rem; display: grid; gap: 1.25rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); }
  .fd-form { margin: 0; max-width: 60ch; }
  .fd-tray { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; row-gap: 0.35rem; }
  .fd-tray li { white-space: nowrap; }

  @media (min-width: 1024px) {
    .fd-cap { margin-top: 3.5rem; }
    .fd-more { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  }
</style>
