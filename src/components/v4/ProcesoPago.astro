---
// Proceso de la versión 4: la única sección clara dentro del tema oscuro (paleta invertida local), con una
// muesca curva arriba. A la izquierda, fijo, un aviso grande dice qué pasa con el pago en cada paso:
// «Todavía no pagas.» hasta la semana a prueba, «Desde aquí, en cuotas.» en la salida en vivo y «La revisión
// mensual va incluida.» en las revisiones. A la derecha, los ocho pasos; el que está a la altura de lectura
// marca su número en rojo. La semana a prueba lleva la píldora ámbar («a prueba»).
// El aviso es aria-hidden: su texto se repite como texto oculto en el paso donde empieza cada frase.
// Sin JavaScript: el aviso queda quieto con la primera frase (sin fijarse) y todo se ve.
// Móvil (<1024px): el aviso es una barra fija bajo la barra de navegación mientras dura la sección.
import { proceso } from '../../data/estudio';
import { pago } from '../../data/v4';

const PRUEBA = 5; // índice de «Una semana a prueba»

// Lengüeta centrada con hombros cóncavos (viewBox 400 × 56): base ancha abajo, esquinas redondeadas arriba.
const MUESCA = 'M0 56A24 24 0 0 0 24 32V24A24 24 0 0 1 48 0H352A24 24 0 0 1 376 24V32A24 24 0 0 0 400 56Z';
---
<section id="proceso" class="v4-sec pp" aria-labelledby="pp-title" data-pp>
  <svg class="pp-muesca" viewBox="0 0 400 56" aria-hidden="true" focusable="false"><path d={MUESCA} /></svg>

  <div class="wrap pp-grid">
    <div class="pp-lado">
      <h2 id="pp-title" class="text-d2 pp-title">{pago.titulo}</h2>
      <div class="pp-aviso" aria-hidden="true">
        {pago.avisos.map((a) => (
          <div class="pp-av" data-pp-av data-desde={a.desde}>
            <p class="text-d1 pp-av-t">{a.t}</p>
            <p class="text-body text-ash pp-av-d">{a.d}</p>
          </div>
        ))}
      </div>
    </div>

    <ol class="pp-lista" role="list">
      {proceso.map((p, i) => {
        const aviso = pago.avisos.find((a) => a.desde === i);
        return (
          <li class="pp-paso" data-pp-paso>
            <span class="pp-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="pp-txt">
              <h3 class="text-d3 pp-t">{p.t}</h3>
              {i === PRUEBA && <p class="pp-pildora">{pago.pildora}</p>}
              <p class="text-body text-ash pp-d">{p.d}</p>
              {aviso && <p class="sr-only">{aviso.t} {aviso.d}</p>}
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  /* Paleta invertida local: crema en el tema oscuro (valores de :root.light en global.css)… */
  .pp {
    color-scheme: light;
    --color-ink: #F4F0E8;
    --color-bone: #0B0A0E;
    --color-ash: #4F4954;
    --color-ash-dim: #5B5560;
    --color-red-text: #C40F1B;
    --color-line: rgb(11 10 14 / 0.12);
    --color-line-strong: rgb(11 10 14 / 0.28);
    --pp-margen: clamp(1.25rem, 4vw, 3rem); /* el mismo margen lateral de wrap */
    position: relative; background: var(--color-ink); color: var(--color-bone);
  }
  /* …y oscura si el visitante eligió el tema claro (valores del tema oscuro) */
  :global(:root.light) .pp {
    color-scheme: dark;
    --color-ink: #0B0A0E;
    --color-bone: #F4F0E8;
    --color-ash: #A7A0A8;
    --color-ash-dim: #8E8791;
    --color-red-text: #FF2D3F;
    --color-line: rgb(244 240 232 / 0.1);
    --color-line-strong: rgb(244 240 232 / 0.24);
  }

  /* Muesca: sale del borde de arriba, del color de la sección (1px de solape para que no quede costura) */
  .pp-muesca {
    position: absolute; left: 50%; bottom: calc(100% - 1px); transform: translateX(-50%);
    display: block; width: clamp(11rem, 28vw, 20rem); height: auto; aspect-ratio: 400 / 56;
    fill: var(--color-ink); pointer-events: none;
  }

  .pp-grid { display: grid; }
  .pp-title { margin: 0; max-width: 18ch; }

  /* Las tres frases ocupan la misma celda: el aviso no cambia de alto. Sin JS, solo la primera. */
  .pp-aviso { display: grid; margin-top: 2rem; }
  .pp-av { grid-area: 1 / 1; }
  .pp-av:not(:first-child) { visibility: hidden; }
  .pp-av-t { margin: 0; max-width: 14ch; text-wrap: balance; }
  .pp-av-d { margin: 1rem 0 0; max-width: 34ch; }

  .pp-lista { list-style: none; margin: 2.5rem 0 0; padding: 0; border-bottom: 1px solid var(--color-line); }
  .pp-paso {
    display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); align-items: baseline;
    padding-block: 1.75rem; border-top: 1px solid var(--color-line);
  }
  .pp-n {
    font-family: var(--font-mono); font-size: 0.875rem; font-variant-numeric: tabular-nums;
    color: var(--color-ash-dim); transition: color 0.35s;
  }
  .pp-paso.is-on .pp-n { color: var(--color-red-text); }
  .pp-t { margin: 0; }
  .pp-d { margin: 0.5rem 0 0; max-width: 46ch; }

  /* «A prueba»: relleno ámbar con texto oscuro (6,9:1). El dato lo lleva el texto, no el color. */
  .pp-pildora {
    display: block; width: fit-content; margin: 0.75rem 0 0; padding: 0.3rem 0.75rem; border-radius: 999px;
    background: var(--color-amber); color: #0B0A0E; font-size: 0.875rem; font-weight: 600; line-height: 1.3;
  }

  @media (min-width: 768px) {
    .pp-paso { grid-template-columns: 3.5rem minmax(0, 1fr); padding-block: 2.1rem; }
  }

  /* Escritorio: dos columnas, título y aviso fijos a la izquierda (solo con JS, que cambia la frase) */
  @media (min-width: 1024px) {
    .pp-grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); column-gap: clamp(2rem, 5vw, 5rem); align-items: start; }
    .pp.is-live .pp-lado { position: sticky; top: calc(var(--v4-nav, 4.25rem) + 2rem); }
    .pp-aviso { margin-top: 3rem; }
    .pp-lista { margin-top: 0; }
  }

  /* Móvil: el aviso pasa a ser una barra fija bajo la barra de navegación. Es sticky dentro de la grilla
     de la sección, así que solo se queda mientras la sección está en pantalla. */
  @media (max-width: 1023px) {
    .pp-lado { display: contents; }
    .pp.is-live .pp-aviso {
      position: sticky; top: var(--v4-nav, 4.25rem); z-index: 5; overflow: hidden;
      margin-inline: calc(-1 * var(--pp-margen)); padding: 0.85rem var(--pp-margen);
      background: var(--color-ink); border-block: 1px solid var(--color-line);
    }
    .pp.is-live .pp-av-t { max-width: none; font-size: 1.15rem; line-height: 1.25; letter-spacing: -0.02em; }
    .pp.is-live .pp-av-d { display: none; }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from '../../scripts/motion';

  const sec = document.querySelector<HTMLElement>('[data-pp]')!;
  const pasos = gsap.utils.toArray<HTMLElement>('[data-pp-paso]', sec);
  const avisos = gsap.utils.toArray<HTMLElement>('[data-pp-av]', sec);
  const desde = avisos.map((a) => Number(a.dataset.desde));
  // Frase que corresponde a un paso: la última cuyo «desde» ya se alcanzó.
  const avisoDe = (k: number) => desde.reduce((j, d, i) => (k >= d ? i : j), 0);

  // Con JS el aviso se fija (sin JS quedaría fijo con una frase que no corresponde a los últimos pasos).
  sec.classList.add('is-live');

  document.fonts.ready.then(() => {
    gsap.matchMedia().add(
      { calma: '(prefers-reduced-motion: reduce)', mov: '(prefers-reduced-motion: no-preference)' },
      (ctx) => {
        // Con «menos movimiento» la frase cambia igual (para que no quede una que ya no corresponde), pero al instante.
        const calma = !!ctx.conditions?.calma;
        let actual = 0;
        gsap.set(avisos, { autoAlpha: (i: number) => (i === 0 ? 1 : 0), y: 0 });

        const mostrar = (j: number) => {
          if (j === actual) return;
          actual = j;
          const ahora = avisos[j];
          const resto = avisos.filter((a) => a !== ahora);
          if (calma) {
            gsap.set(resto, { autoAlpha: 0 });
            gsap.set(ahora, { autoAlpha: 1 });
            return;
          }
          gsap.to(resto, { autoAlpha: 0, y: -12, duration: 0.3, ease: 'power2.in', overwrite: true });
          gsap.fromTo(ahora, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.55, delay: 0.12, ease: 'power3.out', overwrite: true });
        };

        const activar = (k: number) => {
          pasos.forEach((p, i) => p.classList.toggle('is-on', i === k));
          mostrar(avisoDe(Math.max(k, 0)));
        };

        // Cada paso está activo mientras cruza la línea del 60 % de la pantalla.
        pasos.forEach((p, i) => ScrollTrigger.create({
          trigger: p, start: 'top 60%', end: 'bottom 60%',
          onToggle: (self) => {
            if (self.isActive) activar(i);
            else if (i === 0 && self.direction < 0) activar(-1); // de vuelta arriba del primer paso
          },
        }));

        return () => pasos.forEach((p) => p.classList.remove('is-on'));
      },
    );
  });
</script>
