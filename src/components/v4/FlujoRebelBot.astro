---
// «Así responde RebelBot» (versión 4). Un diagrama vertical, para que se lea igual en el móvil:
// mensaje de tu cliente → RebelBot → datos de tu negocio, que se abre en dos caminos («Responde y agenda»
// o «Pasa a un asesor»). El visitante elige el caso con dos radios: el paquete rojo recorre su camino
// (MotionPath), los nodos se encienden a su paso y, al llegar, el globo de chat se transforma en
// calendario o en persona (MorphSVG). Debajo, la conversación de ejemplo del caso elegido.
// Todo va en un solo SVG: el paquete usa las coordenadas del viewBox y escala con él.
// Sin JavaScript o con «menos movimiento»: se ve el caso elegido completo (camino en rojo y final
// encendido) y el cambio de caso funciona solo con CSS (:has), sin viaje.
import { flujo } from '../../data/v4';

const [casoA, casoB] = flujo.casos;

// Geometría (unidades del viewBox, 360 × 480). Los caminos van de centro a centro de cada nodo:
// las cajas son opacas y tapan el tramo interior, así el paquete «entra» en cada nodo y vuelve a salir.
const CX = 180;
const CAJA = { x: 64, w: 232, h: 52, r: 14 };
const centro = (y: number) => y + CAJA.h / 2;
const nodos = [
  { k: 'mensaje', y: 4, t: flujo.nodos.mensaje },
  { k: 'bot', y: 118, t: flujo.nodos.bot },
  { k: 'datos', y: 232, t: flujo.nodos.datos },
];
const Y_DATOS = centro(232);
const Y_PUERTO = 420;
// El tronco es recto y RebelBot queda justo a la mitad: el paquete se detiene ahí (end: 0.5).
const TRONCO = `M${CX} ${centro(4)} V${Y_DATOS}`;
const rama = (x: number) => `M${CX} ${Y_DATOS} V318 C${CX} 351 ${x} 351 ${x} 384 V${Y_PUERTO}`;

// Íconos: formas cerradas de un solo trazo, centradas en 0,0, para que MorphSVG las cambie sin cruces.
const GLOBO = 'M-6.5 -8.75H6.5A2.5 2.5 0 0 1 9 -6.25V1.75A2.5 2.5 0 0 1 6.5 4.25H-1L-5.5 8.75V4.25H-6.5A2.5 2.5 0 0 1 -9 1.75V-6.25A2.5 2.5 0 0 1 -6.5 -8.75Z';
const CALENDARIO = 'M-7 -6H-5.5V-8.5A1.25 1.25 0 0 1 -3 -8.5V-6H3V-8.5A1.25 1.25 0 0 1 5.5 -8.5V-6H7A2 2 0 0 1 9 -4V7A2 2 0 0 1 7 9H-7A2 2 0 0 1 -9 7V-4A2 2 0 0 1 -7 -6Z';
const PERSONA = 'M0 -9A4.5 4.5 0 0 1 3.18 -1.32C6.6 -0.3 9 2.6 9 6.2V7A2 2 0 0 1 7 9H-7A2 2 0 0 1 -9 7V6.2C-9 2.6 -6.6 -0.3 -3.18 -1.32A4.5 4.5 0 0 1 0 -9Z';

const finales = [
  { caso: casoA.id, lado: 'a', x: 90, t: flujo.nodos.a, ico: CALENDARIO },
  { caso: casoB.id, lado: 'b', x: 270, t: flujo.nodos.b, ico: PERSONA },
];
const formas = JSON.stringify({ globo: GLOBO, [casoA.id]: CALENDARIO, [casoB.id]: PERSONA });
---
<section id="rebelbot" class="wrap v4-sec fr" aria-labelledby="fr-title" data-fr>
  <div class="fr-head">
    <h2 id="fr-title" class="text-d2 fr-title">{flujo.titulo}</h2>
    <p class="text-lead text-ash fr-texto">{flujo.texto}</p>
  </div>

  <fieldset class="fr-casos">
    <legend class="text-body text-ash fr-leyenda">{flujo.leyenda}</legend>
    <div class="fr-pills">
      {flujo.casos.map((c, i) => (
        <label class="fr-pill">
          <input
            type="radio" name="fr-caso" value={c.id} checked={i === 0} data-fr-radio
            class:list={['fr-r', i === 0 ? 'fr-r-a' : 'fr-r-b']}
          />
          <span>{c.label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <!-- El texto de arriba ya cuenta el recorrido completo: el dibujo lo repite y queda oculto para lectores de pantalla. -->
  <svg class="fr-diag" viewBox="0 0 360 480" aria-hidden="true" focusable="false" data-fr-diag>
    <!-- Líneas de base (se dibujan al entrar) -->
    <path class="fr-base" d={TRONCO} data-fr-base />
    {finales.map((f) => <path class="fr-base" d={rama(f.x)} data-fr-base />)}

    <!-- El camino activo, en rojo (sigue al paquete) -->
    <path class="fr-tr fr-tr-t" d={TRONCO} data-fr-tronco />
    {finales.map((f) => <path class:list={['fr-tr', `fr-tr-${f.lado}`]} d={rama(f.x)} data-fr-rama={f.caso} />)}

    <!-- Los dos finales: puerto, ícono y nombre -->
    {finales.map((f) => (
      <g class:list={['fr-end', `fr-end-${f.lado}`]} data-fr-end={f.caso}>
        <circle class="fr-port" cx={f.x} cy={Y_PUERTO} r="20" />
        <path class="fr-port-ico" d={f.ico} transform={`translate(${f.x} ${Y_PUERTO})`} />
        <text class="fr-lab" x={f.x} y={Y_PUERTO + 48} text-anchor="middle">{f.t}</text>
      </g>
    ))}

    <!-- El paquete: parte escondido detrás del mensaje; pasa por debajo de las cajas y se acopla al puerto -->
    <g class="fr-pkt" data-fr-pkt>
      <g transform={`translate(${CX} ${centro(4)})`}>
        <circle class="fr-pkt-c" r="17" />
        <path class="fr-pkt-ico" d={GLOBO} data-fr-ico data-formas={formas} />
      </g>
    </g>

    <!-- Los nodos (encima del paquete) -->
    {nodos.map((n) => (
      <g class:list={['fr-node', `fr-node-${n.k}`]} data-fr-node={n.k}>
        <rect x={CAJA.x} y={n.y} width={CAJA.w} height={CAJA.h} rx={CAJA.r} />
        <text x={CX} y={centro(n.y)} text-anchor="middle" dominant-baseline="central">{n.t}</text>
      </g>
    ))}
  </svg>

  <div class="fr-conv">
    <!-- Las dos conversaciones ocupan la misma celda: la caja no cambia de alto al cambiar de caso -->
    <div class="fr-chats" aria-live="polite">
      {flujo.casos.map((c, i) => (
        <div class:list={['fr-chat', i === 0 ? 'fr-chat-a' : 'fr-chat-b']} data-fr-chat={c.id}>
          <p class="fr-msg fr-msg-in text-body" data-fr-in><span class="sr-only">{flujo.nodos.mensaje}: </span>{c.in}</p>
          <p class="fr-msg fr-msg-out text-body" data-fr-out><span class="sr-only">{flujo.nodos.bot}: </span>{c.out}</p>
          <p class="fr-fin text-body text-ash" data-fr-out>{c.fin}</p>
        </div>
      ))}
    </div>
    <p class="text-note fr-nota">{flujo.nota}</p>
  </div>
</section>

<style>
  /* Móvil: título, casos, diagrama y conversación, apilados. Escritorio: texto a la izquierda y diagrama a la derecha. */
  .fr { display: grid; row-gap: 2.5rem; grid-template-areas: 'head' 'casos' 'diag' 'conv'; }
  .fr-head { grid-area: head; display: grid; gap: 1.25rem; }
  .fr-title { margin: 0; max-width: 18ch; }
  .fr-texto { margin: 0; max-width: 46ch; }
  .fr-casos { grid-area: casos; margin: 0; padding: 0; border: 0; min-inline-size: 0; }
  .fr-diag { grid-area: diag; }
  .fr-conv { grid-area: conv; }
  @media (min-width: 1024px) {
    .fr {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); grid-template-rows: auto auto 1fr;
      grid-template-areas: 'head diag' 'casos diag' 'conv diag';
      column-gap: clamp(2rem, 5vw, 5rem); row-gap: 3rem; align-items: start;
    }
  }

  /* Los dos casos: radios reales con forma de píldora */
  .fr-leyenda { padding: 0; margin: 0 0 0.9rem; }
  .fr-pills { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .fr-pill {
    display: inline-flex; align-items: center; gap: 0.65rem; padding: 0.75rem 1.15rem;
    border: 1px solid var(--color-line-strong); border-radius: 999px; cursor: pointer;
    font-weight: 600; font-size: 0.95rem; line-height: 1; transition: border-color 0.3s, background-color 0.3s;
  }
  .fr-pill:hover { border-color: var(--color-bone); }
  .fr-pill:has(.fr-r:checked) { border-color: var(--color-bone); background: var(--color-surface); }
  .fr-r {
    -webkit-appearance: none; appearance: none; flex: none; display: grid; place-content: center;
    width: 1rem; height: 1rem; margin: 0; border-radius: 50%; border: 1.5px solid var(--color-ash-dim);
    cursor: pointer; transition: border-color 0.3s;
  }
  .fr-r::before {
    content: ''; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-red-text);
    transform: scale(0); transition: transform 0.35s var(--ease-out-expo);
  }
  .fr-r:checked { border-color: var(--color-red-text); }
  .fr-r:checked::before { transform: scale(1); }
  /* El foco se ve en la píldora entera (donde se puede; si no, queda el del radio) */
  @supports selector(:has(*)) {
    .fr-r:focus-visible { outline: none; }
    .fr-pill:has(.fr-r:focus-visible) { outline: 2px solid var(--color-red-text); outline-offset: 3px; }
  }

  /* Alto contraste de Windows: el radio nativo, para que se vea cuál está elegido */
  @media (forced-colors: active) {
    .fr-r { appearance: auto; -webkit-appearance: auto; }
    .fr-r::before { content: none; }
  }

  /* Diagrama: flota sobre el fondo, sin caja */
  .fr-diag { display: block; width: 100%; max-width: 28rem; height: auto; aspect-ratio: 360 / 480; overflow: visible; }
  .fr-base, .fr-tr { fill: none; stroke-width: 2; }
  .fr-base { stroke: var(--color-line-strong); }
  .fr-tr { stroke: var(--color-red-text); }

  .fr-node rect { fill: var(--color-surface); stroke: var(--color-line-strong); stroke-width: 1.5; transition: stroke 0.35s; }
  .fr-node text { fill: var(--color-bone); font-family: var(--font-sans); font-weight: 600; font-size: 15px; }
  .fr-node-bot rect { stroke: var(--color-bone); }
  .fr-node-bot text { font-family: var(--font-display); font-weight: 800; font-size: 19px; letter-spacing: -0.02em; }
  /* El nodo por el que pasa el paquete */
  .fr-node.is-hit rect { stroke: var(--color-red-text); }

  /* Finales: apagados por defecto; los colores salen de variables para encenderlos en un solo lugar */
  .fr-end { --fr-lab: var(--color-ash); --fr-port: var(--color-ink); --fr-anillo: var(--color-line-strong); --fr-ico: var(--color-ash-dim); }
  .fr-port { fill: var(--fr-port); stroke: var(--fr-anillo); stroke-width: 1.5; transition: fill 0.35s, stroke 0.35s; }
  .fr-port-ico { fill: var(--fr-ico); transition: fill 0.35s; }
  .fr-lab { fill: var(--fr-lab); font-family: var(--font-sans); font-weight: 600; font-size: 15px; transition: fill 0.35s; }

  /* Sin animación (sin JS o «menos movimiento»): el caso elegido se ve completo, al instante.
     A por defecto; B si está marcado. Reglas separadas para que, sin :has, quede al menos el caso A. */
  .fr:not(.is-anim) .fr-end-a { --fr-lab: var(--color-bone); --fr-port: var(--color-red); --fr-anillo: var(--color-red); --fr-ico: #fff; }
  .fr:not(.is-anim):has(.fr-r-b:checked) .fr-end-a { --fr-lab: var(--color-ash); --fr-port: var(--color-ink); --fr-anillo: var(--color-line-strong); --fr-ico: var(--color-ash-dim); }
  .fr:not(.is-anim):has(.fr-r-b:checked) .fr-end-b { --fr-lab: var(--color-bone); --fr-port: var(--color-red); --fr-anillo: var(--color-red); --fr-ico: #fff; }
  .fr:not(.is-anim) .fr-tr-b { opacity: 0; }
  .fr:not(.is-anim):has(.fr-r-b:checked) .fr-tr-a { opacity: 0; }
  .fr:not(.is-anim):has(.fr-r-b:checked) .fr-tr-b { opacity: 1; }

  /* Con animación, el rojo lo pone el paquete; el final se enciende cuando llega */
  .fr.is-anim .fr-end.is-on { --fr-lab: var(--color-bone); --fr-anillo: var(--color-red-text); }

  .fr-pkt { visibility: hidden; }
  .fr-pkt-c { fill: var(--color-red); }
  .fr-pkt-ico { fill: #fff; }

  /* Mientras haya animación, ocultar solo lo que se dibuja o aparece */
  :global(html.has-motion) .fr-base,
  :global(html.has-motion) .fr-tr { visibility: hidden; }
  :global(html.has-motion) .fr-msg-out,
  :global(html.has-motion) .fr-fin { opacity: 0; }

  /* Conversación de ejemplo: la del caso elegido (también sin JS, con :has) */
  .fr-chats { display: grid; }
  .fr-chat { grid-area: 1 / 1; display: grid; gap: 0.6rem; align-content: start; }
  .fr-chat-b { visibility: hidden; }
  .fr:has(.fr-r-b:checked) .fr-chat-a { visibility: hidden; }
  .fr:has(.fr-r-b:checked) .fr-chat-b { visibility: visible; }
  .fr-msg {
    margin: 0; max-width: min(34ch, 88%); padding: 0.8rem 1.05rem;
    border: 1px solid var(--color-line); border-radius: 1.15rem;
  }
  .fr-msg-in { justify-self: start; background: var(--color-surface); border-bottom-left-radius: 0.35rem; }
  .fr-msg-out { justify-self: end; background: var(--color-surface-2); border-bottom-right-radius: 0.35rem; }
  .fr-fin { margin: 0.5rem 0 0; max-width: 48ch; }
  .fr-nota { margin: 1rem 0 0; color: var(--color-ash-dim); }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../../scripts/motion';
  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';
  import { MorphSVGPlugin } from 'gsap/MorphSVGPlugin';

  gsap.registerPlugin(MotionPathPlugin, MorphSVGPlugin);

  const sec = document.querySelector<HTMLElement>('[data-fr]')!;
  const diag = sec.querySelector<SVGSVGElement>('[data-fr-diag]')!;
  const radios = Array.from(sec.querySelectorAll<HTMLInputElement>('[data-fr-radio]'));
  const bases = Array.from(sec.querySelectorAll<SVGPathElement>('[data-fr-base]'));
  const tronco = sec.querySelector<SVGPathElement>('[data-fr-tronco]')!;
  const ramas = Array.from(sec.querySelectorAll<SVGPathElement>('[data-fr-rama]'));
  const pkt = sec.querySelector<SVGGElement>('[data-fr-pkt]')!;
  const ico = sec.querySelector<SVGPathElement>('[data-fr-ico]')!;
  const nodos = Array.from(sec.querySelectorAll<SVGGElement>('[data-fr-node]'));
  const finales = Array.from(sec.querySelectorAll<SVGGElement>('[data-fr-end]'));
  const chats = Array.from(sec.querySelectorAll<HTMLElement>('[data-fr-chat]'));
  const formas: Record<string, string> = JSON.parse(ico.dataset.formas ?? '{}');

  const nodo = (k: string) => nodos.find((n) => n.dataset.frNode === k)!;
  const rama = (c: string) => ramas.find((r) => r.dataset.frRama === c)!;
  const final = (c: string) => finales.find((f) => f.dataset.frEnd === c)!;
  const chat = (c: string) => chats.find((ch) => ch.dataset.frChat === c)!;
  const elegido = () => (radios.find((r) => r.checked) ?? radios[0]).value;

  const VIAJE = 0.5; // cada tramo del tronco
  const RAMA = 0.7;

  if (!reduceMotion) {
    document.fonts.ready.then(() => {
      gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
        sec.classList.add('is-anim');
        const lineas = [...bases, tronco, ...ramas];
        gsap.set(lineas, { drawSVG: '0% 0%', visibility: 'visible' });
        gsap.set(pkt, { autoAlpha: 0 });

        let tl: gsap.core.Timeline | null = null;
        let st: ScrollTrigger | undefined;
        let listo = false;

        // Un nodo se enciende en rojo mientras el paquete pasa por él.
        const pulso = (t: gsap.core.Timeline, k: string, en: string, dura: number) => t
          .call(() => nodo(k).classList.add('is-hit'), undefined, en)
          .call(() => nodo(k).classList.remove('is-hit'), undefined, `${en}+=${dura}`);

        // Recorre el caso elegido de punta a punta.
        function correr(caso: string, intro = false) {
          tl?.kill();
          nodos.forEach((n) => n.classList.remove('is-hit'));
          finales.forEach((f) => f.classList.remove('is-on'));
          const camino = rama(caso);
          const conv = chat(caso);
          const entrada = conv.querySelector('[data-fr-in]')!;
          const respuesta = conv.querySelectorAll('[data-fr-out]');
          // La respuesta de RebelBot espera a que el paquete llegue.
          gsap.set(respuesta, { opacity: 0, y: 8 });

          tl = gsap.timeline({ delay: intro ? 0.7 : 0 });
          if (!intro) tl.fromTo(entrada, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.45, ease: 'power3.out' }, 0);

          // Lo anterior se apaga: el paquete se va y el rojo se borra hacia abajo.
          tl.to(pkt, { autoAlpha: 0, duration: 0.2, ease: 'power1.in' }, 0)
            .to([tronco, ...ramas], { drawSVG: '100% 100%', duration: 0.35, ease: 'power2.in' }, 0)
            .set(ico, { morphSVG: formas.globo }, 0.4)

            // 1) El mensaje sale y entra en RebelBot (mitad del tronco).
            .addLabel('ida', 0.45)
            .set(pkt, { autoAlpha: 1 }, 'ida')
            .fromTo(tronco, { drawSVG: '0% 0%' }, { drawSVG: '0% 50%', duration: VIAJE, ease: 'power2.inOut', immediateRender: false }, 'ida')
            .to(pkt, { motionPath: { path: tronco, align: tronco, alignOrigin: [0.5, 0.5], start: 0, end: 0.5 }, duration: VIAJE, ease: 'power2.inOut' }, 'ida')
            .addLabel('bot')

            // 2) De RebelBot baja a los datos de tu negocio.
            .to(tronco, { drawSVG: '0% 100%', duration: VIAJE, ease: 'power2.inOut' }, 'bot+=0.2')
            .to(pkt, { motionPath: { path: tronco, align: tronco, alignOrigin: [0.5, 0.5], start: 0.5, end: 1 }, duration: VIAJE, ease: 'power2.inOut' }, 'bot+=0.2')
            .addLabel('datos')

            // 3) Busca el dato y sale por el camino de su caso.
            .addLabel('rama', 'datos+=0.3')
            .fromTo(camino, { drawSVG: '0% 0%' }, { drawSVG: '0% 100%', duration: RAMA, ease: 'power2.inOut', immediateRender: false }, 'rama')
            .to(pkt, { motionPath: { path: camino, align: camino, alignOrigin: [0.5, 0.5] }, duration: RAMA, ease: 'power2.inOut' }, 'rama')

            // 4) Llega: el globo se vuelve calendario o persona, y RebelBot responde.
            .addLabel('llega')
            .to(ico, { morphSVG: { shape: formas[caso] }, duration: 0.5, ease: 'power2.inOut' }, 'llega')
            .call(() => final(caso).classList.add('is-on'), undefined, 'llega')
            .to(respuesta, { opacity: 1, y: 0, duration: 0.5, stagger: 0.12, ease: 'power3.out' }, 'llega+=0.1');

          pulso(tl, 'mensaje', 'ida', 0.3);
          pulso(tl, 'bot', 'bot-=0.05', 0.35);
          pulso(tl, 'datos', 'datos-=0.05', 0.4);
        }

        // Al entrar, una sola vez: se dibujan las líneas y corre el caso elegido (A, salvo que ya hayan cambiado).
        function entrar() {
          if (listo) return;
          listo = true;
          st?.kill();
          gsap.timeline()
            .to(bases[0], { drawSVG: '0% 100%', duration: 0.7, ease: 'power2.inOut' })
            .to(bases.slice(1), { drawSVG: '0% 100%', duration: 0.6, ease: 'power2.inOut' }, '-=0.15');
          correr(elegido(), true);
        }

        st = ScrollTrigger.create({ trigger: diag, start: 'top 75%', onEnter: entrar, onEnterBack: entrar });

        const alCambiar = () => (listo ? correr(elegido()) : entrar());
        radios.forEach((r) => r.addEventListener('change', alCambiar));

        return () => {
          tl?.kill();
          st?.kill();
          radios.forEach((r) => r.removeEventListener('change', alCambiar));
          sec.classList.remove('is-anim');
          nodos.forEach((n) => n.classList.remove('is-hit'));
          finales.forEach((f) => f.classList.remove('is-on'));
          ico.setAttribute('d', formas.globo);
          gsap.set([...lineas, pkt, ...Array.from(sec.querySelectorAll('[data-fr-in], [data-fr-out]'))], { clearProps: 'all' });
          // html.has-motion sigue puesto: lo que estaba oculto para dibujarse vuelve a verse.
          lineas.forEach((l) => { l.style.visibility = 'visible'; });
          sec.querySelectorAll<HTMLElement>('[data-fr-out]').forEach((el) => { el.style.opacity = '1'; });
        };
      });
    });
  }
</script>
