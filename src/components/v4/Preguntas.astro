---
// Preguntas frecuentes de la versión 4: las 10 del estudio, primero las generales y después las de
// RebelBot. Si el visitante marcó algo en el diagnóstico, las que tienen que ver con eso suben arriba
// (sin perder su orden entre ellas) y aparece una nota que lo dice. Acordeón con <details name>: sin
// JavaScript funciona igual (una abierta a la vez); con JavaScript la respuesta se abre con su altura animada.
import { preguntas } from '../../data/estudio';
import { preguntasV4 } from '../../data/v4';

const lista = preguntasV4.orden.map((i) => ({ i, q: preguntas[i].q, a: preguntasV4.respuestas[i] ?? preguntas[i].a }));
---
<section id="preguntas" class="wrap v4-sec pq" aria-labelledby="pq-title">
  <div class="pq-head">
    <h2 id="pq-title" class="text-d2">{preguntasV4.titulo}</h2>
    <p class="text-note text-ash pq-nota" data-pq-nota hidden>{preguntasV4.nota}</p>
  </div>
  <div class="pq-list" data-pq-list>
    {lista.map((p) => (
      <details class="pq-item" name="faq" data-pq data-i={p.i}>
        <summary class="pq-q">
          <span class="text-d3">{p.q}</span>
          <span class="pq-ico" aria-hidden="true"></span>
        </summary>
        <div class="pq-a" data-pq-a>
          <p class="text-body text-ash">{p.a}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .pq { display: grid; gap: 2.5rem; }
  .pq-head h2 { margin: 0; max-width: 18ch; }
  .pq-nota { margin: 1rem 0 0; max-width: 32ch; }
  @media (min-width: 1024px) {
    .pq { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
    .pq-head { position: sticky; top: calc(var(--v4-nav, 4.25rem) + 2.5rem); }
  }
  .pq-list { border-bottom: 1px solid var(--color-line); }
  .pq-item { border-top: 1px solid var(--color-line); }
  .pq-q {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 1.5rem;
    cursor: pointer; list-style: none; color: var(--color-bone); transition: color 0.3s;
  }
  .pq-q::-webkit-details-marker { display: none; }
  .pq-q:hover { color: var(--color-max); }

  /* Más que se vuelve equis al abrir; el rojo marca la pregunta abierta */
  .pq-ico { position: relative; flex: none; width: 1.1rem; height: 1.1rem; transition: transform 0.45s var(--ease-out-expo); }
  .pq-ico::before, .pq-ico::after {
    content: ''; position: absolute; left: 0; top: 50%; width: 100%; height: 2px; margin-top: -1px; border-radius: 2px;
    background: currentColor; transition: background-color 0.3s;
  }
  .pq-ico::after { transform: rotate(90deg); }
  .pq-item[open]:not(.is-closing) .pq-ico { transform: rotate(135deg); }
  .pq-item[open]:not(.is-closing) .pq-ico::before, .pq-item[open]:not(.is-closing) .pq-ico::after { background: var(--color-red-text); }

  /* Alto contraste de Windows: el más/equis se dibuja con el color del texto */
  @media (forced-colors: active) {
    .pq-ico::before, .pq-ico::after { forced-color-adjust: none; background: CanvasText; }
  }

  .pq-a { overflow: hidden; }
  .pq-a p { margin: 0; padding-bottom: 1.6rem; max-width: 60ch; }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../../scripts/motion';
  import { alCambiar } from '../../scripts/v4/estado';
  import { preguntasV4 } from '../../data/v4';

  const list = document.querySelector<HTMLElement>('[data-pq-list]')!;
  const nota = document.querySelector<HTMLElement>('[data-pq-nota]')!;
  const items = gsap.utils.toArray<HTMLDetailsElement>('[data-pq]', list);
  const porIndice = new Map(items.map((d) => [Number(d.dataset.i), d]));

  // Recalcular posiciones una sola vez después de abrir, cerrar o reordenar varias seguidas.
  const refresh = (() => { let t = 0; return () => { clearTimeout(t); t = window.setTimeout(() => ScrollTrigger.refresh(true), 200); }; })();

  // Orden según lo marcado: arriba las que cruzan las piezas elegidas, cada grupo en su orden de siempre.
  // Queda fuera de pantalla cuando se marca, así que no se anima.
  alCambiar((d) => {
    const toca = (i: number) => (preguntasV4.etiquetas[i] ?? []).some((m) => d.modulos.includes(m));
    const suben = preguntasV4.orden.filter(toca);
    const resto = preguntasV4.orden.filter((i) => !toca(i));
    [...suben, ...resto].forEach((i) => { const el = porIndice.get(i); if (el) list.appendChild(el); });
    nota.hidden = suben.length === 0;
    refresh();
  });

  // Con «menos movimiento» se deja el comportamiento nativo del <details>.
  if (!reduceMotion) {
    const cerrar = (d: HTMLDetailsElement) => {
      const a = d.querySelector<HTMLElement>('[data-pq-a]')!;
      gsap.killTweensOf(a);
      d.classList.add('is-closing');
      gsap.to(a, {
        height: 0, opacity: 0, duration: 0.45, ease: 'power3.out',
        onComplete: () => { d.open = false; d.classList.remove('is-closing'); gsap.set(a, { clearProps: 'height,opacity' }); refresh(); },
      });
    };

    const abrir = (d: HTMLDetailsElement) => {
      const a = d.querySelector<HTMLElement>('[data-pq-a]')!;
      gsap.killTweensOf(a);
      // Si se estaba cerrando, sigue desde la altura en que quedó.
      const from = d.classList.contains('is-closing') ? a.offsetHeight : 0;
      d.classList.remove('is-closing');
      d.open = true;
      gsap.fromTo(a, { height: from, opacity: from ? Number(gsap.getProperty(a, 'opacity')) : 0 }, {
        height: 'auto', opacity: 1, duration: 0.55, ease: 'power3.out',
        onComplete: () => { gsap.set(a, { clearProps: 'height,opacity' }); refresh(); },
      });
    };

    items.forEach((d) => {
      // Con JavaScript la exclusividad la llevamos nosotros, para que la que se cierra también se anime
      // (con «name», el navegador la cerraría de golpe).
      d.removeAttribute('name');
      d.querySelector('summary')!.addEventListener('click', (e) => {
        e.preventDefault();
        if (!d.open || d.classList.contains('is-closing')) {
          items.forEach((o) => { if (o !== d && o.open && !o.classList.contains('is-closing')) cerrar(o); });
          abrir(d);
        } else {
          cerrar(d);
        }
      });
    });
  }
</script>
