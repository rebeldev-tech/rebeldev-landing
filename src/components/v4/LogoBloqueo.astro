---
// Logotipo `Rebel</DEV>` con la animación «Bloqueo» (decidida el 25 oct 2026; referencia en
// referencias/animacion-logo.html). Una sola vez al cargar: el `</>` arranca a la izquierda dentro de un
// marco de mira, el marco se abre, los signos van a su lugar, las letras aparecen desde el centro, los
// chevrones pasan a rojo y el marco se apaga. Sin JavaScript o con «menos movimiento», el logo final.
// El SVG se arma al compilar. Las letras usan currentColor (respetan el tema). Cada `<` y `>` lleva dos
// trazos superpuestos, el del texto y el rojo encima: el cambio de color es un fundido que sirve en los
// dos temas. La barra `/` es siempre roja. El nombre accesible lo pone el enlace que lo envuelve.
import { DATA, CAJA, TRAZO, signD, desplazamientos, esquinas } from '../../lib/logotipo';

const viewBox = `${CAJA.x} ${CAJA.y} ${CAJA.w} ${CAJA.h}`;
const signos = DATA.signs.map((sg, i) => ({ kind: sg.kind, d: signD(sg, sg.logoX), dx: desplazamientos[i] }));
---
<svg
  class="lb"
  viewBox={viewBox}
  style={`aspect-ratio: ${CAJA.w} / ${CAJA.h}`}
  aria-hidden="true"
  focusable="false"
  data-lb
>
  <g fill="currentColor">
    {DATA.letters.map((l) => <path d={l.d} data-lb-letra />)}
  </g>
  {signos.map((s) => (
    <g class="lb-signo" stroke-width={TRAZO} data-lb-signo data-dx={s.dx}>
      {s.kind === 'm'
        ? <path class="lb-rojo" d={s.d} />
        : <>
            <path class="lb-base" d={s.d} />
            <path class="lb-rojo" d={s.d} data-lb-funde />
          </>}
    </g>
  ))}
  {esquinas.map((e) => <path class="lb-esq" d={e.d} data-lb-esq data-dx={e.dx} />)}
</svg>

<style>
  .lb { display: block; height: 1.375rem; width: auto; overflow: visible; }
  .lb-signo { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .lb-base { stroke: currentColor; }
  .lb-rojo { stroke: var(--color-red); }
  /* Marco de mira: 1 px real a cualquier tamaño. En el logo final no se ve. */
  .lb-esq { fill: none; stroke: var(--color-red); stroke-width: 1px; stroke-linecap: square; vector-effect: non-scaling-stroke; opacity: 0; }

  /* Oculto hasta que arranca la animación (si el JavaScript no llega, Base.astro lo muestra a los 4 s) */
  :global(html.has-motion) .lb { visibility: hidden; }
</style>

<script>
  import { gsap, reduceMotion } from '../../scripts/motion';

  const svg = document.querySelector<SVGSVGElement>('[data-lb]');

  if (svg && !reduceMotion) {
    const q = gsap.utils.selector(svg);
    const letras = q('[data-lb-letra]');
    const signos = q('[data-lb-signo]');
    const funde = q('[data-lb-funde]');
    const esq = q('[data-lb-esq]');
    const dx = (_: number, el: SVGElement) => Number(el.dataset.dx);

    // Estado inicial: el `</>` a la izquierda, sin letras, con los chevrones del color del texto
    // y el marco encerrando el isotipo.
    gsap.set(signos, { x: dx });
    gsap.set(esq, { x: dx, opacity: 1 });
    gsap.set([letras, funde], { opacity: 0 });
    gsap.set(svg, { visibility: 'visible' });

    gsap.timeline()
      .to(esq, { x: 0, duration: 1.1, ease: 'expo.inOut' }, 0)
      .to(signos, { x: 0, duration: 1.2, ease: 'power4.inOut' }, 0.3)
      .to(letras, { opacity: 1, duration: 0.4, ease: 'power1.out', stagger: { each: 0.06, from: 'center' } }, 1.0)
      .to(funde, { opacity: 1, duration: 0.5, ease: 'power1.inOut' }, 1.4)
      .to(esq, { opacity: 0, duration: 0.5, ease: 'power1.out' }, 1.7);
  }
</script>
