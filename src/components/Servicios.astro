---
// Las 7 especialidades de LinkedIn + «¿Algo más?» del mock. Íconos SVG animados al pasar el ratón (Raycast).
import { contacto } from '../data/contacto';

const servicios = [
  { t: 'Desarrollo de software a medida', d: 'Sistemas pensados para cómo trabaja tu empresa, no al revés.', a: 'snap',
    i: `<path d="M10 16h8a4 4 0 1 1 8 0h8v8a4 4 0 1 1 0 8v8H10z"/><path class="ac piece" d="M34 24a4 4 0 1 1 0 8"/>` },
  { t: 'Automatización de procesos', d: 'Lo repetitivo lo hace el sistema; tu equipo se dedica a lo que importa.', a: 'spin',
    i: `<g class="rot"><circle cx="24" cy="24" r="7"/><path d="M24 7v5M24 36v5M7 24h5M36 24h5M12 12l3.5 3.5M32.5 32.5 36 36M12 36l3.5-3.5M32.5 15.5 36 12"/></g><circle class="ac" cx="24" cy="24" r="2"/>` },
  { t: 'Asistentes de WhatsApp', d: 'Como RebelBot: atienden, califican y agendan con los datos de tu negocio.', a: 'dots', href: '#rebelbot',
    i: `<path d="M8 12a4 4 0 0 1 4-4h24a4 4 0 0 1 4 4v15a4 4 0 0 1-4 4H20l-8 7v-7a4 4 0 0 1-4-4z"/><path class="ac d1" d="M17 19.5h.01"/><path class="ac d2" d="M24 19.5h.01"/><path class="ac d3" d="M31 19.5h.01"/>` },
  { t: 'Plataformas web', d: 'Webs y aplicaciones que tus clientes y tu equipo usan todos los días.', a: 'type',
    i: `<rect x="6" y="9" width="36" height="30" rx="4"/><path d="M6 16h36"/><path class="ac ln" d="M13 24h16"/><path class="ln ln2" d="M13 31h22"/>` },
  { t: 'Backend y APIs', d: 'La base que sostiene todo: ordenada, segura y lista para crecer.', a: 'stack',
    i: `<path class="l1" d="M24 8 41 16 24 24 7 16z"/><path class="l2" d="M7 24l17 8 17-8"/><path class="ac l3" d="M7 32l17 8 17-8"/>` },
  { t: 'Integraciones', d: 'Tus herramientas conectadas entre sí, sin copiar datos a mano.', a: 'link',
    i: `<rect x="5" y="17" width="13" height="13" rx="3"/><rect x="30" y="17" width="13" height="13" rx="3"/><path d="M18 23.5h12"/><circle class="ac pk" cx="24" cy="23.5" r="2.2"/>` },
  { t: 'Diseño UX/UI', d: 'Pantallas claras, que se entienden sin manual.', a: 'cursor',
    i: `<rect x="6" y="8" width="30" height="24" rx="4"/><path d="M12 16h12M12 22h8"/><path class="ac cur" d="M28 26l12 5-5 2-2 5z"/>` },
];
---
<section id="servicios" class="relative border-t border-line py-24 lg:py-36" aria-labelledby="srv-title">
  <div class="wrap">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-24" data-reveal>
      <h2 id="srv-title" class="text-d1">Y si es software, lo construimos.</h2>
      <p class="text-lead max-w-[44ch] text-ash lg:pt-3">RebelBot es la puerta de entrada. Detrás hay un estudio que crea soluciones a medida según lo que necesita cada empresa.</p>
    </div>

    <ul class="srv-list mt-16">
      {servicios.map((s) => {
        const Tag = s.href ? 'a' : 'div';
        return (
          <li data-reveal>
            <Tag class={`srv-row anim-${s.a}`} {...(s.href ? { href: s.href } : {})}>
              <svg class="srv-icon" viewBox="0 0 48 48" aria-hidden="true" set:html={s.i} />
              <h3 class="srv-name">{s.t}</h3>
              <p class="srv-desc text-body text-ash">{s.d}</p>
            </Tag>
          </li>
        );
      })}
      <li data-reveal>
        <a class="srv-row srv-more anim-plus" href={contacto.whatsappLink} target="_blank" rel="noopener">
          <svg class="srv-icon" viewBox="0 0 48 48" aria-hidden="true"><path class="ac rot" d="M24 12v24M12 24h24" /></svg>
          <h3 class="srv-name">¿Algo más?</h3>
          <p class="srv-desc text-body text-ash">Si implica software, probablemente podemos construirlo. Conversemos.</p>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .srv-list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--color-line); }
  .srv-row {
    display: grid; grid-template-columns: 3rem minmax(0, 1fr); column-gap: 1.25rem; row-gap: 0.4rem; align-items: center;
    padding: 1.6rem 0.5rem; border-top: 1px solid var(--color-line); color: inherit; text-decoration: none;
    transition: background-color .4s;
  }
  a.srv-row:hover { background: color-mix(in srgb, var(--color-bone) 3%, transparent); }
  .srv-name { font-size: clamp(1.35rem, 2.6vw, 2.2rem); line-height: 1.1; letter-spacing: -0.03em; margin: 0; }
  .srv-desc { grid-column: 2; margin: 0; }
  @media (min-width: 900px) {
    .srv-row { grid-template-columns: 3.5rem minmax(0, 1.2fr) minmax(0, 1fr); column-gap: 2rem; padding-block: 2rem; }
    .srv-desc { grid-column: 3; }
  }
  .srv-more .srv-name { color: var(--color-red-text); }

  .srv-icon { width: 3rem; height: 3rem; fill: none; stroke: var(--color-bone); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; overflow: visible; }
  .srv-icon :global(.ac) { stroke: var(--color-red-text); }
  .srv-icon :global(*) { transform-box: fill-box; transform-origin: center; transition: transform .6s var(--ease-out-expo), opacity .4s; }

  /* Animaciones al pasar el ratón o enfocar */
  .anim-snap:is(:hover, :focus-visible) :global(.piece) { transform: translateX(4px); }
  .anim-spin:is(:hover, :focus-visible) :global(.rot) { transform: rotate(90deg); }
  .anim-dots:is(:hover, :focus-visible) :global(.d1) { animation: hop .9s infinite; }
  .anim-dots:is(:hover, :focus-visible) :global(.d2) { animation: hop .9s .15s infinite; }
  .anim-dots:is(:hover, :focus-visible) :global(.d3) { animation: hop .9s .3s infinite; }
  .anim-type :global(.ln) { stroke-dasharray: 24; stroke-dashoffset: 0; transition: stroke-dashoffset .7s var(--ease-out-expo); }
  .anim-type:is(:hover, :focus-visible) :global(.ln) { animation: type 1.2s infinite; }
  .anim-type:is(:hover, :focus-visible) :global(.ln2) { animation-delay: .25s; }
  .anim-stack:is(:hover, :focus-visible) :global(.l1) { transform: translateY(-4px); }
  .anim-stack:is(:hover, :focus-visible) :global(.l3) { transform: translateY(4px); }
  .anim-link:is(:hover, :focus-visible) :global(.pk) { animation: travel 1.1s ease-in-out infinite; }
  .anim-cursor:is(:hover, :focus-visible) :global(.cur) { transform: translate(-10px, -9px); }
  .anim-plus:is(:hover, :focus-visible) :global(.rot) { transform: rotate(90deg); }

  @keyframes hop { 0%, 60%, 100% { transform: translateY(0) } 30% { transform: translateY(-4px) } }
  @keyframes type { 0% { stroke-dashoffset: 24 } 60%, 100% { stroke-dashoffset: 0 } }
  @keyframes travel { 0%, 100% { transform: translateX(-6px) } 50% { transform: translateX(6px) } }
</style>
