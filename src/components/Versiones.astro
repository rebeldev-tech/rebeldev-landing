---
// Selector flotante (abajo a la izquierda) para cambiar entre las versiones del landing.
import { versiones } from '../data/versiones';

interface Props { actual: string }
const { actual } = Astro.props;
const vigente = versiones.find((v) => v.id === actual);
---
<div class="vsw" data-vsw>
  <button type="button" class="vsw-btn" aria-expanded="false" aria-controls="vsw-panel" data-vsw-toggle>
    <span class="vsw-dot" aria-hidden="true"></span>
    <span>{vigente?.nombre ?? 'Versiones'}</span>
    <svg class="vsw-caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
  </button>

  <nav id="vsw-panel" class="vsw-panel" aria-label="Versiones del landing" hidden>
    <p class="vsw-title">Versiones para revisar</p>
    <ul>
      {versiones.map((v) => (
        <li>
          <a href={v.href} class:list={['vsw-item', { 'is-current': v.id === actual }]} aria-current={v.id === actual ? 'page' : undefined}>
            <span class="vsw-name">{v.nombre}</span>
            <span class="vsw-desc">{v.desc}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  .vsw { position: fixed; left: 1rem; bottom: 1rem; z-index: 60; }
  .vsw-btn {
    display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.6rem 0.95rem 0.6rem 0.8rem; border-radius: 999px;
    background: var(--color-surface); border: 1px solid var(--color-line-strong); color: var(--color-bone);
    font-family: var(--font-display); font-size: 0.875rem; font-weight: 600; cursor: pointer;
    box-shadow: 0 12px 30px -12px rgb(0 0 0 / 0.5); transition: border-color .3s;
  }
  .vsw-btn:hover, .vsw-btn[aria-expanded="true"] { border-color: var(--color-bone); }
  .vsw-dot { width: 0.5rem; height: 0.5rem; border-radius: 99px; background: var(--color-red); box-shadow: 0 0 10px var(--color-red-text); }
  .vsw-caret { width: 0.75rem; height: 0.75rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform .3s; }
  .vsw-btn[aria-expanded="true"] .vsw-caret { transform: rotate(180deg); }

  .vsw-panel[hidden] { display: none; }
  .vsw-panel {
    position: absolute; left: 0; bottom: calc(100% + 0.6rem); width: min(19rem, calc(100vw - 2rem));
    padding: 0.6rem; border-radius: 1.1rem; background: var(--color-surface); border: 1px solid var(--color-line-strong);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.6);
  }
  .vsw-title { margin: 0.3rem 0.6rem 0.5rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ash-dim); }
  .vsw-panel ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
  .vsw-item { display: grid; gap: 0.15rem; padding: 0.7rem 0.75rem; border-radius: 0.75rem; color: var(--color-bone); text-decoration: none; transition: background-color .2s; }
  .vsw-item:hover, .vsw-item:focus-visible { background: color-mix(in srgb, var(--color-bone) 6%, transparent); }
  .vsw-item.is-current { background: color-mix(in srgb, var(--color-red) 14%, transparent); }
  .vsw-name { font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; }
  .vsw-item.is-current .vsw-name::after { content: ' (en pantalla)'; color: var(--color-red-text); font-family: var(--font-sans); font-weight: 400; font-size: 0.8rem; }
  .vsw-desc { font-size: 0.8rem; color: var(--color-ash); }
</style>

<script>
  // Se abre y cierra con el botón; Escape y el clic afuera lo cierran.
  const root = document.querySelector<HTMLElement>('[data-vsw]')!;
  const btn = root.querySelector<HTMLButtonElement>('[data-vsw-toggle]')!;
  const panel = root.querySelector<HTMLElement>('.vsw-panel')!;

  const setOpen = (open: boolean) => {
    panel.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  };

  btn.addEventListener('click', () => setOpen(panel.hidden));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) { setOpen(false); btn.focus(); }
  });
  document.addEventListener('pointerdown', (e) => {
    if (!root.contains(e.target as Node)) setOpen(false);
  });
</script>
