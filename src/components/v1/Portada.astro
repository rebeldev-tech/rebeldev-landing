---
// La portada entera. libre: versión de prueba del scroll (/v2), donde solo el teléfono de RebelBot fija la pantalla.
// Producto primero (RebelBot y su panel), «Solo pagas lo que consumes» y la consultoría como opción.
// Los textos están en src/data/v1.ts y las cifras de precios en src/data/precios.ts.
// Las versiones anteriores (la Versión Fina y la primera v1) se recuperan del historial de git (355392a).
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Preguntas from '../../components/Preguntas.astro';
import Hero from '../../components/fina/Hero.astro';
import Caos from '../../components/fina/Caos.astro';
import Servicios from '../../components/fina/Servicios.astro';
import Proceso from '../../components/fina/Proceso.astro';
import Comparador from '../../components/fina/Comparador.astro';
import Fredy from '../../components/fina/Fredy.astro';
import Cierre from '../../components/fina/Cierre.astro';
import Producto from '../../components/v1/Producto.astro';
import Precios from '../../components/v1/Precios.astro';
import Pie from '../../components/v1/Pie.astro';
import { contacto } from '../../data/contacto';
import { datosEstructurados } from '../../data/seo';
import {
  metaV1, linksV1, heroV1, serviciosV1, aMedida, procesoV1, procesoV1Titulo, estacionesV1, medidorV1,
  comparacionV1, lineasV1, preguntasV1, cierreV1,
} from '../../data/v1';

interface Props { libre?: boolean; noindex?: boolean }
const { libre = false, noindex = false } = Astro.props;
---
<Base title={metaV1.title} description={metaV1.description} jsonLd={datosEstructurados(Astro.site!)} noindex={noindex}>
  <Nav links={linksV1} />

  <div class="fina">
    <main id="contenido">
      <Hero {...heroV1} />
      <Producto libre={libre} />
      <Precios />
      <Comparador filas={comparacionV1} lineas={lineasV1} />
      <Proceso titulo={procesoV1Titulo} pasos={procesoV1} estaciones={estacionesV1} medidor={medidorV1} libre={libre} />

      <!-- «A medida» y «Del caos al sistema» se leen como un solo comienzo: el primer paso queda pegado a este título -->
      <section id="a-medida" class="wrap v1-medida" aria-labelledby="am-title">
        <h2 id="am-title" class="text-d1 max-w-[18ch]" data-reveal>{aMedida.titulo}</h2>
        <p class="mt-6 max-w-[52ch] text-lead text-ash" data-reveal>{aMedida.texto}</p>
      </section>
      <Caos libre={libre} />
      <Servicios items={serviciosV1} libre={libre} />

      <Fredy />
      <Preguntas items={preguntasV1} />

      <Cierre {...cierreV1} />
    </main>

    <Pie />

    <div class="fina-cursor" data-fina-cursor aria-hidden="true"><span></span></div>
  </div>

  <!-- La demo, siempre a mano: abajo a la derecha, lleva al WhatsApp de RebelBot.
       Rebel, el gatito del chat, va justo encima (src/components/RebelChat.astro). -->
  {<a href={contacto.whatsappLink} target="_blank" rel="noopener" class="btn btn-primary demo-flot" data-demo-flot="cz" aria-label="Agenda una demo por WhatsApp (se abre en otra pestaña)">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 19.5l1.2-3.6A7.8 7.8 0 1 1 8.4 18.6z" /><path d="M9 10.5h6M9 13.5h4" /></svg>
    Agenda una demo
  </a>}
</Base>

<style is:global>
  .fina-sec { padding-block: clamp(6rem, 12vw, 10rem); }
  .fina section[id] { scroll-margin-top: 5rem; }
  .fina { overflow-x: clip; }
</style>

<style>
  .v1-medida { padding-block: clamp(6rem, 12vw, 10rem) clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--color-line); }

  /* Botón flotante de la demo: por debajo de la barra (z-50), así el menú del móvil lo tapa al abrirse.
     En pantallas angostas baja y se esconde mientras el cotizador está a la vista, para no taparlo. */
  .demo-flot {
    position: fixed; z-index: 40; gap: 0.55rem; white-space: nowrap;
    right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom));
    padding: 0.85rem 1.25rem; font-size: 0.95rem;
    box-shadow: 0 0.5rem 1.75rem rgb(0 0 0 / 0.45), 0 0 0 1px rgb(255 255 255 / 0.06) inset;
    transition: background-color .3s, color .3s, border-color .3s, translate 0.35s var(--ease-out-expo), visibility 0s;
  }
  .demo-flot svg { width: 1.2rem; height: 1.2rem; flex: none; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .demo-flot.is-oculto {
    translate: 0 calc(100% + 2rem); visibility: hidden;
    transition: background-color .3s, color .3s, border-color .3s, translate 0.35s var(--ease-out-expo), visibility 0s 0.35s;
  }
  @media (prefers-reduced-motion: reduce) { .demo-flot, .demo-flot.is-oculto { transition: none; } }
  @media (min-width: 1024px) { .demo-flot { right: 1.75rem; bottom: 1.75rem; padding: 0.95rem 1.4rem; font-size: 1rem; } }
  @media (prefers-reduced-motion: no-preference) {
    .demo-flot { animation: demo-in 0.6s var(--ease-out-expo) 0.8s both; }
    @keyframes demo-in { from { opacity: 0; transform: translateY(1rem); } }
  }

  .fina-cursor { display: none; }
  :global(html.has-cursor) .fina-cursor { display: block; position: fixed; left: 0; top: 0; z-index: 70; pointer-events: none; width: 0; height: 0; }
  .fina-cursor span {
    position: absolute; left: 14px; top: 10px; width: 3px; height: 20px; border-radius: 3px; background: var(--color-red);
    transform: rotate(18deg); transition: width 0.3s, height 0.3s, opacity 0.3s;
  }
  :global(html.has-cursor) .fina-cursor.is-link span { height: 30px; }
</style>

<script>
  import { gsap, initReveals, reduceMotion, coarsePointer } from '../../scripts/motion';

  initReveals();

  // Bajo 1024 px, el botón flotante se esconde mientras el cotizador está a la vista (en el celular lo tapaba).
  const flot = document.querySelector<HTMLAnchorElement>('[data-demo-flot]');
  const cz = document.querySelector('[data-cz]');
  if (flot && cz) {
    const angosta = window.matchMedia('(max-width: 1023px)');
    let aLaVista = false;
    const aplicar = () => {
      const oculto = aLaVista && angosta.matches;
      flot.classList.toggle('is-oculto', oculto);
      flot.inert = oculto;
    };
    new IntersectionObserver(([e]) => { aLaVista = e.isIntersecting; aplicar(); }).observe(cz);
    angosta.addEventListener('change', aplicar);
  }

  if (!reduceMotion && !coarsePointer) {
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      const x = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3.out' });
      const y = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3.out' });
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        x((e.clientX - r.left - r.width / 2) * 0.25);
        y((e.clientY - r.top - r.height / 2) * 0.35);
      });
      el.addEventListener('pointerleave', () => { x(0); y(0); });
    });

    // Cursor «/»: se inclina más cuanto más rápido se mueve.
    const cur = document.querySelector<HTMLElement>('[data-fina-cursor]')!;
    const bar = cur.querySelector('span')!;
    document.documentElement.classList.add('has-cursor');
    const cx = gsap.quickTo(cur, 'x', { duration: 0.35, ease: 'power3.out' });
    const cy = gsap.quickTo(cur, 'y', { duration: 0.35, ease: 'power3.out' });
    const tilt = gsap.quickTo(bar, 'rotation', { duration: 0.5, ease: 'power3.out' });
    let lx = 0, rest = 0;
    gsap.set(bar, { autoAlpha: 0 });
    window.addEventListener('pointermove', (e) => {
      if (!lx) { gsap.set(cur, { x: e.clientX, y: e.clientY }); gsap.to(bar, { autoAlpha: 1, duration: 0.2 }); }
      cx(e.clientX); cy(e.clientY);
      tilt(18 + gsap.utils.clamp(-30, 30, (e.clientX - lx) * 1.2));
      lx = e.clientX;
      clearTimeout(rest);
      rest = window.setTimeout(() => tilt(18), 120);
      cur.classList.toggle('is-link', !!(e.target as Element).closest?.('a, button, summary, input, [role="slider"]'));
    });
    document.addEventListener('pointerleave', () => gsap.to(bar, { autoAlpha: 0, duration: 0.2 }));
    document.addEventListener('pointerenter', () => gsap.to(bar, { autoAlpha: 1, duration: 0.2 }));
  }
</script>
