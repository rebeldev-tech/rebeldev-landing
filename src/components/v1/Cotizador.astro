---
// Cotizador «¿Cuántos créditos necesitas?»: dos deslizadores y una casilla; calcula créditos, modalidad y total con IGV.
// Sin JS: los controles quedan desactivados y se ve el ejemplo (150 + 0 → 157 créditos → S/ 185.64).
// La regla está dos veces (aquí para el HTML y en el <script>): si cambia, cambiar las dos.
import { credito, creditosMes, conIgv, soles, planes } from '../../data/precios';
import { contacto } from '../../data/contacto';

// Los deslizadores arrancan en un negocio chico: 150 conversaciones y ningún seguimiento.
const C = { min: 0, max: 6000, step: 50, valor: 150 };
const S = { min: 0, max: 4000, step: 50, valor: 0 };
const fmt = (n: number) => n.toLocaleString('en-US');
const pct = (v: number, max: number) => `${(v / max) * 100}%`;

function cotizar(c: number, s: number, crm: boolean) {
  const exacto = creditosMes(c, s);
  const cred = Math.round(exacto);
  if (cred <= credito.topePorUso && !crm) {
    const a = planes[0];
    return { cred, modo: 'Por uso, sin contrato', total: conIgv(Math.round(exacto * 100) / 100), linea: `El plan ${a.nombre} te costaría ${soles(conIgv(a.base))} con IGV al mes.`, plan: '', desde: false };
  }
  const p = planes.find((x) => x.creditos >= cred && (!crm || x.crm));
  if (p) return { cred, modo: `Plan ${p.nombre}`, total: conIgv(p.base), linea: `Incluye ${fmt(p.creditos)} créditos al mes.`, plan: p.id, desde: false };
  const pro = planes[planes.length - 1];
  return { cred, modo: `${pro.nombre} + recargas: te cotizamos tu volumen`, total: conIgv(pro.base), linea: `${pro.nombre} incluye ${fmt(pro.creditos)} créditos al mes; lo que pases va con recargas.`, plan: pro.id, desde: true };
}
const r = cotizar(C.valor, S.valor, false);
---
<div class="cz" data-cz data-reveal data-reveal-delay="0.1">
  <h3 class="text-d3">¿Cuántos créditos necesitas?</h3>

  <div class="cz-field">
    <div class="cz-row">
      <label for="cz-c">Conversaciones con clientes al mes</label>
      <output for="cz-c" class="cz-out" data-cz-oc>{fmt(C.valor)}</output>
    </div>
    <input id="cz-c" name="conversaciones" class="cz-range" type="range" min={C.min} max={C.max} step={C.step} value={C.valor}
      style={`--p:${pct(C.valor, C.max)}`} disabled data-cz-c />
  </div>

  <div class="cz-field">
    <div class="cz-row">
      <label for="cz-s">Seguimientos automáticos al mes</label>
      <output for="cz-s" class="cz-out" data-cz-os>{fmt(S.valor)}</output>
    </div>
    <input id="cz-s" name="seguimientos" class="cz-range" type="range" min={S.min} max={S.max} step={S.step} value={S.valor}
      style={`--p:${pct(S.valor, S.max)}`} disabled data-cz-s />
  </div>

  <label class="cz-check">
    <input type="checkbox" name="crm" disabled data-cz-crm />
    <span>Conectar con tu sistema de ventas (CRM)</span>
  </label>

  <div class="cz-res">
    <dl class="cz-dl">
      <div class="cz-kv"><dt>Créditos al mes</dt><dd class="cz-cred" data-cz-cred>{fmt(r.cred)}</dd></div>
      <div class="cz-kv"><dt>Modalidad recomendada</dt><dd data-cz-modo>{r.modo}</dd></div>
      <div class="cz-total"><dt data-cz-tl>Pagas al mes, con IGV</dt><dd class="cz-big" data-cz-total>{soles(r.total)}</dd></div>
    </dl>
    <p class="cz-line" data-cz-line>{r.linea}</p>
    <p class="sr-only" aria-live="polite" data-cz-live></p>
  </div>

  <p class="cz-note">
    La carga inicial de tu web y documentos cuesta {credito.cargaPor10Paginas} créditos por cada 10 páginas, solo el primer mes.
    El escaneo para cotizar es gratis.
  </p>
  <a class="btn btn-primary cz-cta" href={contacto.whatsappLink} target="_blank" rel="noopener">Pide tu cotización exacta</a>
</div>

<style>
  .cz {
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 1rem;
    padding: clamp(1.25rem, 3vw, 2.25rem); display: grid; gap: 1.5rem;
  }
  .cz-field { display: grid; gap: 0.25rem; }
  .cz-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .cz-row label { color: var(--color-ash); font-size: 0.9375rem; }
  .cz-out { font-family: var(--font-mono); font-size: 1.125rem; color: var(--color-bone); font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* Deslizador: 44 px de alto para el pulgar, pista fina con el tramo recorrido en rojo */
  .cz-range { -webkit-appearance: none; appearance: none; width: 100%; height: 2.75rem; background: transparent; cursor: pointer; margin: 0; touch-action: manipulation; }
  .cz-range:disabled { cursor: default; opacity: 0.65; }
  .cz-range::-webkit-slider-runnable-track {
    height: 6px; border-radius: 999px;
    background: linear-gradient(to right, var(--color-red) var(--p), var(--color-line-strong) var(--p));
  }
  .cz-range::-moz-range-track { height: 6px; border-radius: 999px; background: var(--color-line-strong); }
  .cz-range::-moz-range-progress { height: 6px; border-radius: 999px; background: var(--color-red); }
  .cz-range::-webkit-slider-thumb {
    -webkit-appearance: none; box-sizing: border-box; width: 1.75rem; height: 1.75rem; margin-top: calc(3px - 0.875rem);
    border-radius: 50%; background: var(--color-bone); border: 3px solid var(--color-red);
    transition: transform 0.2s var(--ease-out-expo);
  }
  .cz-range::-moz-range-thumb {
    box-sizing: border-box; width: 1.75rem; height: 1.75rem; border-radius: 50%;
    background: var(--color-bone); border: 3px solid var(--color-red);
  }
  .cz-range:not(:disabled):active::-webkit-slider-thumb { transform: scale(1.12); }

  .cz-check { display: flex; align-items: center; gap: 0.75rem; min-height: 2.75rem; cursor: pointer; font-size: 0.9375rem; touch-action: manipulation; }
  .cz-check:has(input:disabled) { cursor: default; }
  .cz-check input { width: 1.25rem; height: 1.25rem; accent-color: var(--color-red); flex: none; margin: 0; cursor: inherit; }

  .cz-res { background: var(--color-ink); border: 1px solid var(--color-line); border-radius: 0.75rem; padding: clamp(1rem, 2.5vw, 1.5rem); }
  .cz-dl { display: grid; gap: 0.75rem; margin: 0; }
  .cz-kv { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.25rem 1rem; }
  .cz-dl dt { color: var(--color-ash); font-size: 0.875rem; }
  .cz-dl dd { margin: 0; font-weight: 600; }
  .cz-cred { font-family: var(--font-mono); color: var(--color-red-text); font-variant-numeric: tabular-nums; }
  .cz-total { border-top: 1px solid var(--color-line); padding-top: 1rem; margin-top: 0.25rem; }
  .cz-dl .cz-big {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(2.4rem, 5.5vw, 3.6rem);
    line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; margin-top: 0.35rem;
  }
  .cz-line { color: var(--color-ash); font-size: 0.875rem; margin-top: 0.75rem; min-height: 2.6em; }
  .cz-note { color: var(--color-ash-dim); font-size: 0.8125rem; line-height: 1.5; }
  .cz-cta { justify-self: start; }
</style>

<script>
  import { gsap, reduceMotion } from '../../scripts/motion';
  import { credito, creditosMes, conIgv, soles, planes } from '../../data/precios';

  const fmt = (n: number) => n.toLocaleString('en-US');

  function cotizar(c: number, s: number, crm: boolean) {
    const exacto = creditosMes(c, s);
    const cred = Math.round(exacto);
    if (cred <= credito.topePorUso && !crm) {
      const a = planes[0];
      return { cred, modo: 'Por uso, sin contrato', total: conIgv(Math.round(exacto * 100) / 100), linea: `El plan ${a.nombre} te costaría ${soles(conIgv(a.base))} con IGV al mes.`, plan: '', desde: false };
    }
    const p = planes.find((x) => x.creditos >= cred && (!crm || x.crm));
    if (p) return { cred, modo: `Plan ${p.nombre}`, total: conIgv(p.base), linea: `Incluye ${fmt(p.creditos)} créditos al mes.`, plan: p.id, desde: false };
    const pro = planes[planes.length - 1];
    return { cred, modo: `${pro.nombre} + recargas: te cotizamos tu volumen`, total: conIgv(pro.base), linea: `${pro.nombre} incluye ${fmt(pro.creditos)} créditos al mes; lo que pases va con recargas.`, plan: pro.id, desde: true };
  }

  document.querySelectorAll<HTMLElement>('[data-cz]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const rc = q<HTMLInputElement>('[data-cz-c]');
    const rs = q<HTMLInputElement>('[data-cz-s]');
    const crm = q<HTMLInputElement>('[data-cz-crm]');
    const oc = q('[data-cz-oc]'), os = q('[data-cz-os]');
    const credEl = q('[data-cz-cred]'), modoEl = q('[data-cz-modo]'), tlEl = q('[data-cz-tl]');
    const totalEl = q('[data-cz-total]'), lineEl = q('[data-cz-line]'), liveEl = q('[data-cz-live]');

    const shown = { cred: 0, total: 0 };
    const render = () => {
      credEl.textContent = fmt(Math.round(shown.cred));
      totalEl.textContent = soles(Math.round(shown.total * 100) / 100);
    };
    let timer: number | undefined;

    function update(animar: boolean) {
      const c = Number(rc.value), s = Number(rs.value);
      oc.textContent = fmt(c);
      os.textContent = fmt(s);
      for (const i of [rc, rs]) i.style.setProperty('--p', `${(Number(i.value) / Number(i.max)) * 100}%`);

      const r = cotizar(c, s, crm.checked);
      const tl = r.desde ? 'Desde, al mes con IGV' : 'Pagas al mes, con IGV';
      modoEl.textContent = r.modo;
      tlEl.textContent = tl;
      lineEl.textContent = r.linea;

      if (animar && !reduceMotion) {
        gsap.to(shown, { cred: r.cred, total: r.total, duration: 0.4, ease: 'power2.out', overwrite: true, onUpdate: render });
      } else {
        gsap.killTweensOf(shown);
        shown.cred = r.cred; shown.total = r.total; render();
      }

      // Marca en «Planes mensuales» el plan que sale del cálculo.
      document.querySelectorAll<HTMLElement>('[data-plan-col]').forEach((el) => {
        const on = el.dataset.planCol === r.plan;
        el.classList.toggle('is-rec', on);
        el.querySelector('[data-plan-tag]')?.toggleAttribute('hidden', !on);
      });

      if (animar) {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          liveEl.textContent = `${fmt(r.cred)} créditos al mes. ${r.modo}. ${tl}: ${soles(r.total)}.`;
        }, 600);
      }
    }

    [rc, rs, crm].forEach((i) => { i.disabled = false; });
    rc.addEventListener('input', () => update(true));
    rs.addEventListener('input', () => update(true));
    crm.addEventListener('change', () => update(true));
    update(false); // por si el navegador restauró otros valores al volver atrás
  });
</script>
