---
// Precios: «Solo pagas lo que consumes.» Todas las cifras y textos salen de src/data/precios.ts.
// El momento llamativo es el precio por crédito; el resto se lee como tablas limpias.
import Cotizador from './Cotizador.astro';
import {
  credito, porUso, planes, notaPlanes, ladosModo, modalidades, acciones, topeAcciones, notaAcciones,
  queEs, cadaSol, notaCadaSol, niveles, notaNiveles, notaPie,
  conIgv, creditosMes, soles, solesEnteros,
} from '../../data/precios';

const num = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 2 });
const cred = (n: number | null) => (n === null ? 'Gratis' : `${num(n)} ${n === 1 ? 'crédito' : 'créditos'}`);
const precioCredito = conIgv(credito.precio).toLocaleString('en-US', { minimumFractionDigits: 2 });
const totalSol = cadaSol.reduce((a, [, v]) => a + v, 0);
// Marcas de la regla de consumo: 0 a 5 créditos y lo que cuestan con IGV.
const marcas = Array.from({ length: topeAcciones + 1 }, (_, i) => i);
---
<section id="precios" class="wrap fina-sec pc" aria-labelledby="pc-title" data-pc>
  <header class="pc-head" data-reveal>
    <h2 id="pc-title" class="text-d2">Solo pagas lo que consumes.</h2>
    <p class="text-lead text-ash pc-sub">
      Sin cargo fijo ni licencias. Pagas los créditos que usa tu asistente; la implementación, el soporte y las mejoras van por nuestra cuenta.
    </p>
  </header>

  <!-- Por uso + cotizador -->
  <div class="pc-top">
    <article class="pc-card pc-uso" aria-labelledby="pc-uso-t" data-reveal>
      <div class="pc-uso-top">
        <h3 id="pc-uso-t" class="text-d3">{porUso.nombre}</h3>
        <p class="pc-chip"><i aria-hidden="true"></i>{porUso.etiqueta}</p>
      </div>

      <p class="pc-price">
        <span class="pc-cur">S/</span><span class="pc-num">{precioCredito}</span><span class="pc-per">por crédito</span>
      </p>
      <p class="pc-mono">{soles(credito.precio)} + IGV</p>
      <p class="pc-eq">1 crédito = {num(credito.tokens)} tokens procesados ≈ 1 conversación típica</p>

      <ul class="pc-list">{porUso.incluye.map((t) => <li>{t}</li>)}</ul>

      <table class="pc-tbl pc-ej">
        <thead><tr><th scope="col">Si atiendes al mes</th><th scope="col" class="r">Pagas con IGV</th></tr></thead>
        <tbody>
          {porUso.ejemplos.map((n) => (
            <tr><td>{num(n)} conversaciones</td><td class="r pc-fig">{soles(conIgv(creditosMes(n, 0)))}</td></tr>
          ))}
        </tbody>
      </table>
    </article>

    <Cotizador />
  </div>

  <!-- Planes mensuales -->
  <div class="pc-block" data-reveal>
    <h3 class="text-d3">Planes mensuales</h3>
    <div class="pc-plans">
      {planes.map((p) => (
        <article class="pc-plan" aria-labelledby={`pc-p-${p.id}`} data-plan-col={p.id}>
          <p class="pc-tag" data-plan-tag hidden>Según tu cálculo</p>
          <h4 id={`pc-p-${p.id}`} class="pc-plan-name">{p.nombre}</h4>
          <p class="pc-plan-price"><span>{soles(conIgv(p.base))}</span> al mes</p>
          <p class="pc-mono">{solesEnteros(p.base)} + IGV</p>
          <p class="pc-plan-cred"><span class="pc-red">{num(p.creditos)} créditos</span> ≈ {num(p.conversaciones)} conversaciones al mes</p>
          <ul class="pc-list">{p.incluye.map((t) => <li>{t}</li>)}</ul>
        </article>
      ))}
    </div>
    <p class="text-note text-ash pc-after">{notaPlanes}</p>
  </div>

  <!-- Por uso o plan mensual: dos fichas enfrentadas. Las filas con cifra van grandes; el resto, en texto. -->
  <div class="pc-block" data-reveal>
    <h3 class="text-d3">Por uso o plan mensual</h3>
    <p class="text-body text-ash pc-lead">El asistente es el mismo. Cambia cuánto te comprometes y qué tan rápido te atendemos.</p>
    <!-- Los role se quedan: en el móvil la tabla pasa a grilla y algunos navegadores le quitan la semántica -->
    <table class="pc-vs" role="table">
      <thead role="rowgroup">
        <tr role="row">
          <td role="cell"></td>
          {(['uso', 'plan'] as const).map((k) => (
            <th scope="col" role="columnheader" class:list={['pc-vs-lado', { 'is-plan': k === 'plan' }]}>
              <span class="pc-vs-nombre">{ladosModo[k].nombre}</span>
              <span class="pc-vs-para">{ladosModo[k].para}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody role="rowgroup">
        {modalidades.map((m) => (
          <tr role="row" class:list={{ 'is-cifra': m.cifra }}>
            <th scope="row" role="rowheader" class="pc-vs-tema">{m.tema}</th>
            {(['uso', 'plan'] as const).map((k) => (
              <td role="cell" class:list={{ 'is-plan': k === 'plan' }} data-tema={m.tema}>
                <span class="pc-vs-v">{m[k].v}</span>
                {m[k].d && <span class="pc-vs-d">{m[k].d}</span>}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Lo que consume cada acción: barras sobre una regla de créditos y soles. La típica (≈ 1 crédito) es la medida. -->
  <div class="pc-block" data-reveal>
    <h3 class="text-d3">Lo que consume cada acción</h3>
    <p class="text-body text-ash pc-lead">Una conversación típica usa cerca de un crédito. Con esa medida, esto es lo que consume cada cosa que hace tu asistente.</p>

    <div class="pc-cons" data-pc-cons style={`--tope: ${topeAcciones}`}>
      <div class="pc-regla" aria-hidden="true">
        <span class="pc-regla-t">Créditos<br /><span>Con IGV</span></span>
        <div class="pc-regla-escala">
          {marcas.map((m) => (
            <span class="pc-marca" style={`--v: ${m}`}>
              <b>{m}</b>
              <span>{m === 0 ? 'S/ 0' : soles(conIgv(m * credito.precio))}</span>
            </span>
          ))}
        </div>
      </div>

      {acciones.map((g) => (
        <div class="pc-grupo">
          <p class="pc-grupo-t">{g.grupo}</p>
          <ul class="pc-barras">
            {g.items.map((a) => (
              <li class:list={['pc-barra', { 'is-ref': a.ref, 'is-gratis': a.n === null }]} style={`--v: ${a.n ?? 0}`}>
                <span class="pc-b-t">{a.t}<span class="pc-b-d">{a.d}</span></span>
                <span class="pc-b-pista">
                  <i class="pc-b-barra" data-pc-barra aria-hidden="true"></i>
                  <span class="pc-b-n" data-pc-num>{cred(a.n)}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="text-note text-ash pc-after">{notaAcciones}</p>
  </div>

  <!-- Transparencia -->
  <details class="pc-more" data-pc-more data-reveal>
    <summary>
      <h3 class="text-d3">Qué es un crédito y qué paga cada sol</h3>
      <span class="pc-plus" aria-hidden="true"></span>
    </summary>
    <div class="pc-more-body" data-pc-body>
      <div class="pc-more-in">
      <span class="pc-more-linea" data-pc-linea aria-hidden="true"></span>
      <div class="pc-more-grid">
        <div data-pc-pieza>
          <h4 class="pc-h4">{queEs.titulo}</h4>
          <p class="text-body text-ash">{queEs.texto}</p>
          <p class="text-note pc-quote">{queEs.nota}</p>
        </div>
        <div data-pc-pieza>
          <h4 class="pc-h4">Qué paga cada sol</h4>
          <table class="pc-tbl">
            <thead><tr><th scope="col">En qué se usa</th><th scope="col" class="r">De cada {soles(credito.precio)}</th></tr></thead>
            <tbody>{cadaSol.map(([t, v]) => <tr><td>{t}</td><td class="r pc-fig">{soles(v)}</td></tr>)}</tbody>
            <tfoot><tr><th scope="row">Total, sin IGV</th><td class="r pc-fig">{soles(totalSol)}</td></tr></tfoot>
          </table>
          <p class="text-note text-ash pc-after">{notaCadaSol}</p>
        </div>
      </div>

      <h4 class="pc-h4" data-pc-pieza>Niveles de respuesta</h4>
      <table class="pc-tbl pc-niv" data-pc-pieza>
        <thead><tr><th scope="col">Nivel</th><th scope="col">Para qué sirve</th><th scope="col" class="r">Créditos por {num(credito.tokens)} tokens</th></tr></thead>
        <tbody>{niveles.map(([n, uso, c]) => <tr><th scope="row">{n}</th><td>{uso}</td><td class="r pc-fig">{num(c)}</td></tr>)}</tbody>
      </table>
      <p class="text-note text-ash pc-after" data-pc-pieza>{notaNiveles}</p>
      </div>
    </div>
  </details>

  <p class="text-note pc-pie">{notaPie}</p>
</section>

<style>
  .pc-head { display: grid; gap: 1.25rem; align-items: end; }
  .pc-sub { max-width: 46ch; }
  @media (min-width: 1024px) { .pc-head { grid-template-columns: 1fr 1fr; gap: 3rem; } }

  .pc-top { display: grid; gap: 1.25rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 1024px) { .pc-top { grid-template-columns: 1fr 1fr; align-items: start; } }

  .pc-card { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 1rem; padding: clamp(1.25rem, 3vw, 2.25rem); }
  .pc-uso { border-color: var(--color-red); }
  .pc-uso-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; }
  .pc-chip {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.8rem; border-radius: 999px;
    border: 1px solid var(--color-line-strong); color: var(--color-ash); font-size: 0.8125rem;
  }
  .pc-chip i { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--color-red); box-shadow: 0 0 10px var(--color-red); }

  /* El momento llamativo: el precio por crédito */
  .pc-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.6rem; margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  .pc-cur { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.6rem, 3vw, 2.4rem); color: var(--color-ash); align-self: flex-start; margin-top: 0.4em; }
  .pc-num {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(5rem, 13vw, 9.5rem);
    line-height: 0.85; letter-spacing: -0.055em; font-variant-numeric: tabular-nums;
  }
  .pc-per { font-size: clamp(1rem, 1.6vw, 1.2rem); color: var(--color-ash); }

  .pc-mono { font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ash); margin-top: 0.75rem; font-variant-numeric: tabular-nums; }
  .pc-eq { color: var(--color-ash); font-size: 0.9375rem; margin-top: 0.25rem; }

  .pc-list { display: grid; gap: 0.5rem; margin-top: 1.25rem; font-size: 0.9375rem; }
  .pc-list li { position: relative; padding-left: 1.25rem; }
  .pc-list li::before { content: '/'; position: absolute; left: 0; color: var(--color-red-text); font-weight: 600; }

  /* Tablas */
  .pc-tbl { width: 100%; border-collapse: collapse; font-size: 0.9375rem; margin-top: 1.5rem; }
  .pc-tbl th, .pc-tbl td { text-align: left; vertical-align: top; padding: 0.8rem 0.75rem; }
  .pc-tbl :is(th, td):first-child { padding-left: 0; }
  .pc-tbl :is(th, td):last-child { padding-right: 0; }
  .pc-tbl thead th { color: var(--color-ash); font-weight: 600; font-size: 0.8125rem; padding-top: 0; border-bottom: 1px solid var(--color-line-strong); }
  .pc-tbl tbody tr + tr, .pc-tbl tfoot tr { border-top: 1px solid var(--color-line); }
  .pc-tbl tbody th { font-weight: 600; }
  .pc-tbl tfoot th { color: var(--color-ash); font-weight: 600; }
  .pc-tbl .r { text-align: right; }
  .pc-fig { font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pc-red { color: var(--color-red-text); }
  .pc-ej { margin-top: 1.75rem; }

  .pc-block { margin-top: clamp(4rem, 8vw, 6rem); }
  .pc-after { margin-top: 1rem; max-width: 72ch; }

  /* Planes: un solo panel dividido en columnas */
  .pc-plans { display: grid; margin-top: 1.5rem; border: 1px solid var(--color-line); border-radius: 1rem; background: var(--color-surface); overflow: hidden; }
  .pc-plan { position: relative; padding: clamp(1.25rem, 3vw, 2rem); transition: background-color 0.4s var(--ease-out-expo), box-shadow 0.4s var(--ease-out-expo); }
  .pc-plan + .pc-plan { border-top: 1px solid var(--color-line); }
  @media (min-width: 900px) {
    .pc-plans { grid-template-columns: repeat(3, 1fr); }
    .pc-plan + .pc-plan { border-top: 0; border-left: 1px solid var(--color-line); }
  }
  .pc-plan.is-rec { background: var(--color-surface-2); box-shadow: inset 0 3px 0 var(--color-red); }
  .pc-tag { color: var(--color-red-text); font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.5rem; }
  .pc-tag[hidden] { display: none; }
  .pc-plan-name { font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; }
  .pc-plan-price { margin-top: 1rem; color: var(--color-ash); }
  .pc-plan-price span {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(2rem, 3.2vw, 2.7rem);
    letter-spacing: -0.04em; color: var(--color-bone); font-variant-numeric: tabular-nums; margin-right: 0.25rem;
  }
  .pc-plan-cred { margin-top: 1rem; font-size: 0.9375rem; color: var(--color-ash); }
  .pc-plan-cred .pc-red { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

  .pc-lead { margin-top: 0.75rem; max-width: 58ch; }

  /* Por uso o plan mensual: cada columna de valores es una ficha (sus celdas se unen en una tarjeta) */
  .pc-vs {
    width: calc(100% + 1.5rem); margin: 2rem -0.75rem 0; border-collapse: separate; border-spacing: 0.75rem 0;
    font-size: 0.9375rem; table-layout: fixed;
  }
  .pc-vs :is(th, td) { text-align: left; vertical-align: top; padding: 1.1rem clamp(1rem, 2.4vw, 1.75rem); }
  .pc-vs thead td, .pc-vs .pc-vs-tema { width: 26%; padding-left: 0; background: none; }
  .pc-vs .pc-vs-lado, .pc-vs tbody td { background: var(--color-surface); }
  .pc-vs .is-plan { background: var(--color-surface-2); }
  .pc-vs .pc-vs-lado { padding-block: 1.5rem 1.25rem; border-radius: 1rem 1rem 0 0; }
  .pc-vs .pc-vs-lado.is-plan { box-shadow: inset 0 3px 0 var(--color-red); }
  .pc-vs tbody td { border-top: 1px solid var(--color-line); }
  .pc-vs tbody tr:last-child td { border-radius: 0 0 1rem 1rem; padding-bottom: 1.5rem; }
  .pc-vs-nombre { display: block; font-family: var(--font-display); font-weight: 800; font-size: clamp(1.15rem, 1.6vw, 1.4rem); letter-spacing: -0.02em; }
  .pc-vs-para { display: block; margin-top: 0.3rem; color: var(--color-ash); font-size: 0.875rem; font-weight: 400; }
  .pc-vs-tema { color: var(--color-ash); font-weight: 600; font-size: 0.875rem; line-height: 1.4; }
  .pc-vs-v { display: block; font-weight: 600; line-height: 1.4; }
  .pc-vs .is-cifra .pc-vs-v {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(1.3rem, 2.3vw, 1.95rem);
    line-height: 1.05; letter-spacing: -0.035em; font-variant-numeric: tabular-nums;
  }
  .pc-vs .is-cifra .pc-vs-tema { padding-top: 1.45rem; }
  .pc-vs-d { display: block; margin-top: 0.35rem; color: var(--color-ash); font-size: 0.875rem; line-height: 1.4; }
  /* En el móvil, el tema sale arriba de cada valor y las dos fichas quedan lado a lado */
  @media (max-width: 639px) {
    .pc-vs, .pc-vs :is(thead, tbody) { display: block; width: auto; margin-inline: 0; }
    .pc-vs tr { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 0.5rem; }
    .pc-vs thead td, .pc-vs .pc-vs-tema { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .pc-vs :is(th, td) { padding: 0.9rem 0.85rem; }
    .pc-vs .is-cifra .pc-vs-v { font-size: 1.2rem; }
    .pc-vs tbody td::before { content: attr(data-tema); display: block; margin-bottom: 0.35rem; color: var(--color-ash); font-size: 0.75rem; font-weight: 600; line-height: 1.3; }
    .pc-vs-d { font-size: 0.8125rem; }
  }

  /* Lo que consume cada acción: regla de créditos (con su precio) y una barra por acción */
  .pc-cons { --etiqueta: minmax(11rem, 0.38fr); --cifra: 7rem; margin-top: 2rem; }
  .pc-regla, .pc-barra { display: grid; grid-template-columns: var(--etiqueta) minmax(0, 1fr); column-gap: clamp(1rem, 3vw, 2.5rem); }
  .pc-regla { align-items: end; padding-bottom: 0.6rem; border-bottom: 1px solid var(--color-line-strong); }
  .pc-regla-t { color: var(--color-ash); font-size: 0.8125rem; font-weight: 600; line-height: 1.4; }
  .pc-regla-t span { color: var(--color-ash-dim); font-weight: 400; }
  .pc-regla-escala { position: relative; height: 2.6rem; margin-right: var(--cifra); }
  .pc-marca {
    position: absolute; bottom: 0; left: calc(var(--v) / var(--tope) * 100%); translate: -50% 0;
    display: grid; justify-items: center; line-height: 1.3; white-space: nowrap;
  }
  .pc-marca:first-child { translate: 0 0; justify-items: start; }
  .pc-marca:last-child { translate: -100% 0; justify-items: end; }
  .pc-marca b { font-family: var(--font-mono); font-weight: 500; font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  .pc-marca span { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ash-dim); font-variant-numeric: tabular-nums; }

  .pc-grupo-t { margin-top: 1.75rem; color: var(--color-ash); font-size: 0.8125rem; font-weight: 600; }
  .pc-barras { list-style: none; margin: 0.4rem 0 0; padding: 0; }
  .pc-barra { align-items: stretch; }
  .pc-b-t { padding-block: 0.7rem; font-weight: 600; line-height: 1.35; }
  .pc-b-d { display: block; color: var(--color-ash); font-size: 0.8125rem; font-weight: 400; }
  /* La pista lleva la cuadrícula: una línea por crédito, que sigue de fila en fila */
  .pc-b-pista {
    position: relative; display: flex; align-items: center; margin-right: var(--cifra);
    background: linear-gradient(to right, var(--color-line) 1px, transparent 1px) 0 0 / calc(100% / var(--tope)) 100%;
    box-shadow: inset -1px 0 var(--color-line);
  }
  .pc-b-barra {
    display: block; height: 0.9rem; width: calc(var(--v) / var(--tope) * 100%);
    border-radius: 0 4px 4px 0; background: var(--color-ash-dim); transform-origin: left center;
  }
  .pc-barra.is-ref .pc-b-barra { background: var(--color-red); }
  .pc-b-n {
    position: absolute; top: 50%; left: calc(var(--v) / var(--tope) * 100% + 0.6rem); translate: 0 -50%;
    font-family: var(--font-mono); font-size: 0.875rem; white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  .pc-barra.is-gratis .pc-b-n { left: 0.6rem; color: var(--color-red-text); font-weight: 600; }
  @media (max-width: 639px) {
    .pc-cons { --cifra: 0rem; }
    .pc-regla, .pc-barra { grid-template-columns: minmax(0, 1fr); }
    .pc-regla-t, .pc-marca span { display: none; }
    .pc-regla-escala { height: 1.4rem; }
    .pc-b-t { padding: 0.6rem 6.5rem 0.35rem 0; }
    .pc-b-pista { height: 1.6rem; }
    .pc-b-n, .pc-barra.is-gratis .pc-b-n { left: auto; right: 0; top: auto; bottom: calc(100% + 0.35rem); translate: none; }
  }

  /* Transparencia */
  .pc-more { margin-top: clamp(4rem, 8vw, 6rem); border-block: 1px solid var(--color-line); }
  .pc-more summary {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding-block: 1.5rem; cursor: pointer; list-style: none;
  }
  .pc-more summary::-webkit-details-marker { display: none; }
  .pc-more summary:hover .pc-plus { border-color: var(--color-bone); }
  .pc-more summary h3 { transition: translate 0.5s var(--ease-out-expo); }
  .pc-more summary:hover h3 { translate: 0.35rem 0; }
  /* El «+» gira media vuelta y se vuelve «−» (is-cerrando lo devuelve apenas empieza a cerrarse) */
  .pc-plus { position: relative; flex: none; width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1px solid var(--color-line-strong); transition: border-color 0.3s, transform 0.6s var(--ease-out-expo), background-color 0.3s; }
  .pc-plus::before, .pc-plus::after { content: ''; position: absolute; inset: 50% auto auto 50%; width: 0.9rem; height: 2px; margin: -1px 0 0 -0.45rem; background: var(--color-red-text); transition: transform 0.6s var(--ease-out-expo); }
  .pc-plus::after { transform: rotate(90deg); }
  .pc-more[open]:not(.is-cerrando) .pc-plus { transform: rotate(180deg); background: var(--color-surface); }
  .pc-more[open]:not(.is-cerrando) .pc-plus::after { transform: rotate(0deg); }
  .pc-more-body { overflow: clip; }
  .pc-more-in { position: relative; padding: 2rem 0 2.5rem; }
  /* Línea roja que se dibuja de izquierda a derecha al abrir */
  .pc-more-linea { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--color-red); transform-origin: left; }
  .pc-more-grid { display: grid; gap: 2.5rem 4rem; margin-bottom: 2.5rem; }
  @media (min-width: 1024px) { .pc-more-grid { grid-template-columns: 1fr 1fr; } }
  .pc-h4 { font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; margin-bottom: 0.75rem; }
  .pc-more-grid .pc-tbl { margin-top: 0; }
  .pc-quote { margin-top: 1rem; padding-left: 1rem; border-left: 2px solid var(--color-red); color: var(--color-bone); }
  .pc-niv { margin-top: 0; }
  .pc-niv th[scope='row'] { width: 7rem; }

  .pc-pie { margin-top: 2rem; color: var(--color-ash-dim); max-width: 80ch; }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../../scripts/motion';
  // «Qué es un crédito»: se abre con el alto creciendo, la línea roja dibujándose y el contenido entrando en orden
  // (las filas de las tablas, una tras otra); se cierra plegándose. Con menos movimiento, abre y cierra al instante.
  // En los dos casos cambia el alto de la página: al terminar se recalculan las secciones que siguen.
  document.querySelectorAll<HTMLDetailsElement>('[data-pc-more]').forEach((d) => {
    if (reduceMotion) { d.addEventListener('toggle', () => ScrollTrigger.refresh()); return; }
    const sum = d.querySelector('summary')!;
    const body = d.querySelector<HTMLElement>('[data-pc-body]')!;
    const linea = body.querySelector('[data-pc-linea]');
    const piezas = body.querySelectorAll('[data-pc-pieza]');
    const filas = body.querySelectorAll('tbody tr, tfoot tr');
    let abierto = d.open;
    let tl: ReturnType<typeof gsap.timeline> | undefined;

    sum.addEventListener('click', (e) => {
      e.preventDefault();
      tl?.kill();
      abierto = !abierto;
      if (abierto) {
        const desde = d.open ? body.offsetHeight : 0; // 0 si estaba cerrado; si se estaba cerrando, desde donde iba
        d.classList.remove('is-cerrando');
        d.open = true;
        tl = gsap.timeline({ onComplete: () => { gsap.set(body, { clearProps: 'height' }); ScrollTrigger.refresh(); } })
          .fromTo(body, { height: desde }, { height: () => body.scrollHeight, duration: 0.8, ease: 'expo.out' })
          .fromTo(linea, { scaleX: 0, transformOrigin: 'left' }, { scaleX: 1, duration: 0.9, ease: 'expo.out' }, 0)
          .fromTo(piezas, { autoAlpha: 0, y: 20 }, { autoAlpha: 1, y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.08 }, 0.12)
          .fromTo(filas, { autoAlpha: 0, x: -12 }, { autoAlpha: 1, x: 0, duration: 0.45, ease: 'power2.out', stagger: 0.035 }, 0.3);
      } else {
        d.classList.add('is-cerrando');
        tl = gsap.timeline({
          onComplete: () => {
            d.open = false;
            d.classList.remove('is-cerrando');
            gsap.set(body, { clearProps: 'height' });
            ScrollTrigger.refresh();
          },
        })
          .to([...piezas].reverse(), { autoAlpha: 0, y: -10, duration: 0.25, ease: 'power2.in', stagger: 0.03 })
          .to(linea, { scaleX: 0, transformOrigin: 'right', duration: 0.4, ease: 'power2.in' }, 0)
          .fromTo(body, { height: body.offsetHeight }, { height: 0, duration: 0.5, ease: 'power3.inOut' }, 0.12);
      }
    });
  });

  // Consumo: al llegar, las barras crecen desde la regla (una sola vez) y después aparece cada cifra.
  const cons = document.querySelector<HTMLElement>('[data-pc-cons]');
  if (cons && !reduceMotion) {
    const barras = cons.querySelectorAll('[data-pc-barra]');
    const cifras = cons.querySelectorAll('[data-pc-num]');
    gsap.set(barras, { scaleX: 0 });
    gsap.set(cifras, { autoAlpha: 0 });
    let hecho = false;
    const crecer = () => {
      if (hecho) return;
      hecho = true;
      gsap.to(barras, { scaleX: 1, duration: 1.1, ease: 'expo.out', stagger: 0.07 });
      gsap.to(cifras, { autoAlpha: 1, duration: 0.4, ease: 'power1.out', stagger: 0.07, delay: 0.45 });
    };
    const st = ScrollTrigger.create({ trigger: cons, start: 'top 75%', once: true, onEnter: crecer });
    if (st.scroll() > st.start) crecer();
  }
</script>
