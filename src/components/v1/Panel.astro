---
// Panel de RebelBot recreado y simplificado (sección Producto, «Así lo manejas tú»). Datos de ejemplo: src/data/panel.ts.
// Se dibuja en em y escala con el ancho de su contenedor (container-type: inline-size en Producto).
// El CSS es el estado final (pantalla Consumo); la línea de tiempo vive en el script de Producto.astro.
// .is-antes: lo que solo se ve antes de su paso (el script lo muestra al empezar y lo apaga a su tiempo).
import { negocio, menu, kpis, bandeja, citas, leads, conocimiento, aprendizaje, tablero, consumo, miles } from '../../data/panel';
import type { Temperatura } from '../../data/panel';

const temp: Record<Temperatura, string> = { Caliente: 'is-caliente', Tibio: 'is-tibio', Frío: 'is-frio' };

const tope = Math.max(...tablero.serie);
const cursor = '<svg class="pn-cursor-svg" viewBox="0 0 16 20"><path d="M1.5 1.5v14.6l3.7-3.5 2.6 6 2.6-1.1-2.6-5.9h5.3z"/></svg>';
---
<div class="pn" data-panel aria-hidden="true">
  <div class="pn-bar">
    <span class="pn-dots"><i></i><i></i><i></i></span>
    <span class="pn-negocio">{negocio}</span>
    <span class="pn-por">Panel por <span class="pn-rd">Rebel<b>&lt;/</b>DEV<b>&gt;</b></span></span>
    <span class="pn-tag">Ejemplo</span>
  </div>

  <div class="pn-body">
    <div class="pn-menu">
      {menu.map((g) => (
        <div class="pn-grupo">
          <p class="pn-grupo-t">{g.grupo}</p>
          <ul>
            {g.items.map((it) => (
              <li class="pn-item" data-pn="item" data-k={it.k} style={it.k === 'consumo' ? '--on: 1' : undefined}><span>{it.t}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="pn-main">
      <dl class="pn-kpis">
        {kpis.map((k) => (
          <div class="pn-kpi"><dt>{k.t}</dt><dd data-pn={k.k ? `kpi-${k.k}` : undefined} data-antes={k.antes}>{k.v}</dd></div>
        ))}
      </dl>

      <div class="pn-scrs">
        <!-- Bandeja -->
        <div class="pn-scr pn-ban" data-pn="scr">
          <ul class="pn-convs">
            {bandeja.conversaciones.map((c, i) => (
              <li class:list={['pn-conv', { 'is-sel': i === 0 }]}>
                <span class="pn-conv-n">{c.n}</span>
                <span class="pn-conv-h">{c.hace}</span>
                <span class="pn-conv-m">{c.m}</span>
                {i === 0 ? (
                  <span class="pn-swap"><span class="pn-chip is-antes" data-pn="b-bot">Bot</span><span class="pn-chip is-asesor" data-pn="b-asesor">Asesor</span></span>
                ) : (
                  <span class:list={['pn-chip', { 'is-asesor': c.quien === 'Asesor' }]}>{c.quien}</span>
                )}
              </li>
            ))}
          </ul>

          <div class="pn-hilo">
            <div class="pn-hilo-cab">
              <span class="pn-quien"><b>{bandeja.cliente.n}</b><span>{bandeja.cliente.tel}</span></span>
              <span class="pn-swap"><span class="pn-chip is-antes" data-pn="b-bot">Bot</span><span class="pn-chip is-asesor" data-pn="b-asesor">Asesor</span></span>
            </div>
            <div class="pn-msgs">
              {bandeja.hilo.map((m) => (
                <p class:list={['pn-msg', m.de === 'in' ? 'is-in' : 'is-out']}>{m.de !== 'in' && <span class="pn-msg-q">RebelBot</span>}{m.t}</p>
              ))}
              <p class="pn-msg is-in" data-pn="b-nuevo">{bandeja.nuevo}</p>
              <p class="pn-sys" data-pn="b-sys">{bandeja.aviso}</p>
            </div>
            <div class="pn-hilo-acc">
              <span class="pn-input">Escribe como asesor…</span>
              <span class="pn-btn-wrap">
                <span class="pn-swap">
                  <span class="pn-btn is-rojo is-antes" data-pn="b-tomar">Tomar control</span>
                  <span class="pn-btn" data-pn="b-devolver">Devolver al asistente</span>
                </span>
                <span class="pn-cursor" data-pn="b-cursor" set:html={cursor} />
              </span>
            </div>
          </div>

          <div class="pn-card pn-lead">
            <p class="pn-h">Lead</p>
            <dl>
              {bandeja.lead.map((d) => <div><dt>{d.k}</dt><dd>{d.v}</dd></div>)}
            </dl>
            <p class="pn-h">Resumen para el asesor</p>
            <p class="pn-resumen">{bandeja.resumen}</p>
          </div>
        </div>

        <!-- Citas: el horario de las 11:30 pasa de libre a la visita que agendó el asistente -->
        <div class="pn-scr pn-cit" data-pn="scr">
          <div class="pn-cab">
            <p class="pn-cab-t">Citas</p>
            <p class="pn-cab-s">El asistente solo ofrece tus horarios libres, evita las dobles reservas y le envía la ubicación al cliente.</p>
          </div>
          <div class="pn-cit-grid">
            <div class="pn-card pn-dia">
              <p class="pn-h">{citas.dia}</p>
              <ul class="pn-slots">
                {citas.horarios.map((s) => (
                  <li class="pn-slot">
                    <span class="pn-slot-h">{s.h}</span>
                    {s.nueva ? (
                      <span class="pn-swap">
                        <span class="pn-slot-libre is-antes" data-pn="ci-libre">Libre</span>
                        <span class="pn-slot-cita is-nueva" data-pn="ci-slot"><b>{s.quien}</b>{s.tipo}</span>
                      </span>
                    ) : s.quien ? (
                      <span class="pn-slot-cita"><b>{s.quien}</b>{s.tipo}</span>
                    ) : (
                      <span class="pn-slot-libre">Libre</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
            <div class="pn-card pn-prox">
              <p class="pn-h">Próximas citas</p>
              <table class="pn-tabla">
                <tbody>
                  {citas.proximas.map((c) => (
                    <tr class:list={{ 'is-nueva': c.nueva }} data-pn={c.nueva ? 'ci-fila' : undefined}>
                      <td>{c.cuando}</td><td><b>{c.n}</b></td><td>{c.tipo}</td><td class="pn-ancho">{c.p}</td>
                      <td><span class:list={['pn-chip', { 'is-asesor': c.por === 'Asesor' }]}>{c.por}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="pn-sys pn-ubic" data-pn="ci-ubic">{citas.ubicacion}</p>
            </div>
          </div>
        </div>

        <!-- Leads: Lucía M. queda registrada y pasa de nueva a caliente -->
        <div class="pn-scr pn-lds" data-pn="scr">
          <div class="pn-cab pn-cab-fila">
            <p class="pn-cab-t">Leads</p>
            <span class="pn-filtros">{leads.filtros.map((f, i) => <span class:list={['pn-campo', { 'is-on': i === 0 }]}>{f}</span>)}</span>
          </div>
          <table class="pn-tabla pn-lds-t">
            <thead>
              <tr><th>Cliente</th><th class="pn-ancho">Busca</th><th>Plazo</th><th class="pn-ancho">Pago</th><th>Estado</th></tr>
            </thead>
            <tbody>
              {leads.filas.map((l) => (
                <tr class:list={{ 'is-nueva': l.nueva }} data-pn={l.nueva ? 'l-fila' : undefined}>
                  <td><b>{l.n}</b></td><td class="pn-ancho">{l.busca}</td><td>{l.plazo}</td><td class="pn-ancho">{l.pago}</td>
                  <td>
                    {l.nueva ? (
                      <span class="pn-swap">
                        <span class="pn-chip is-antes" data-pn="l-antes">{leads.antes}</span>
                        <span class:list={['pn-temp', temp[l.estado]]} data-pn="l-estado">{l.estado}</span>
                      </span>
                    ) : (
                      <span class:list={['pn-temp', temp[l.estado]]}>{l.estado}</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="pn-card pn-lds-res" data-pn="l-res">
            <p class="pn-h">Resumen para el asesor</p>
            <p class="pn-resumen">{leads.resumen}</p>
          </div>
        </div>

        <!-- Conocimiento -->
        <div class="pn-scr pn-con" data-pn="scr">
          <div class="pn-cab">
            <p class="pn-cab-t">Base de conocimiento</p>
            <p class="pn-cab-s">Todo lo que el asistente puede decir sale de aquí. Si un dato está vacío, no lo inventa: ofrece que un asesor lo confirme.</p>
          </div>
          <ul class="pn-proys">
            {conocimiento.proyectos.map((p) => (
              <li class="pn-card pn-proy">
                <b>{p.n}</b>
                <span class="pn-chip">{p.etapa}</span>
                <span class="pn-proy-d">Desde {p.m2}&nbsp;m²<br />Desde S/&nbsp;{p.precio}</span>
                <span class="pn-proy-t">{p.d}</span>
              </li>
            ))}
          </ul>
          <table class="pn-tabla">
            <thead>
              <tr><th>Código</th><th class="pn-ancho">Proyecto</th><th class="pn-n">m²</th><th class="pn-n">Dorm.</th><th>Estado</th><th class="pn-n">Precio S/</th></tr>
            </thead>
            <tbody>
              {conocimiento.unidades.map((u) => (
                <tr>
                  <td>{u.c}</td><td class="pn-ancho">{u.p}</td><td class="pn-n">{u.m2}</td><td class="pn-n">{u.dorm}</td><td>{u.estado}</td>
                  <td class="pn-n">
                    {u.precio || (
                      <span class="pn-vacio">—<span class="pn-ring" data-pn="c-ring"></span><span class="pn-falta" data-pn="c-chip">Lo confirma un asesor</span></span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Aprendizaje -->
        <div class="pn-scr pn-apr" data-pn="scr">
          <div class="pn-cab">
            <p class="pn-cab-t">Aprendizaje supervisado</p>
            <p class="pn-cab-s">La IA propone preguntas frecuentes a partir de lo que respondieron tus asesores. Nada entra a la base de conocimiento sin tu aprobación.</p>
          </div>
          <ul class="pn-sugs">
            {aprendizaje.map((s, i) => (
              <li class="pn-card pn-sug">
                <span class="pn-sug-k">Pregunta</span>
                <span class="pn-sug-p">{s.p}</span>
                <span class="pn-sug-k">Respuesta propuesta</span>
                <span class="pn-sug-r">{s.r}</span>
                <span class="pn-sug-base">{s.base}</span>
                {i === 0 ? (
                  <span class="pn-sug-acc">
                    <span class="pn-swap">
                      <span class="pn-acc is-antes" data-pn="a-acc">
                        <span class="pn-btn-wrap"><span class="pn-btn is-rojo" data-pn="a-btn">Aprobar</span><span class="pn-cursor" data-pn="a-cursor" set:html={cursor} /></span>
                        <span class="pn-btn">Descartar</span>
                      </span>
                      <span class="pn-ok" data-pn="a-ok"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" /><path d="M4.8 8.3l2.2 2.2 4.2-4.6" /></svg>Aprobada: ya está en la base de conocimiento</span>
                    </span>
                  </span>
                ) : (
                  <span class="pn-sug-acc"><span class="pn-acc"><span class="pn-btn is-rojo">Aprobar</span><span class="pn-btn">Descartar</span></span></span>
                )}
              </li>
            ))}
          </ul>
        </div>

        <!-- Tablero -->
        <div class="pn-scr pn-tab" data-pn="scr">
          <div class="pn-cab pn-cab-fila">
            <p class="pn-cab-t">Tablero</p>
            <span class="pn-filtros">
              <span class="pn-campo"><small>Desde</small>{tablero.desde}</span>
              <span class="pn-campo"><small>Hasta</small>{tablero.hasta}</span>
              <span class="pn-btn">Exportar CSV</span>
            </span>
          </div>
          <ul class="pn-mets">
            {tablero.metricas.map((m) => (
              <li class="pn-card pn-met">
                <span class="pn-met-t">{m.t}</span>
                <b class="pn-met-v" data-pn="t-num" data-v={m.v} data-suf={m.suf}>{m.v}{m.suf}</b>
                <span class="pn-met-n">{m.nota}</span>
              </li>
            ))}
          </ul>
          <div class="pn-card pn-graf">
            <p class="pn-h">Conversaciones por día</p>
            <div class="pn-barras">{tablero.serie.map((v) => <i data-pn="t-bar" style={`--h: ${(v / tope).toFixed(3)}`}></i>)}</div>
          </div>
        </div>

        <!-- Consumo (estado final sin JS) -->
        <div class="pn-scr pn-cons" data-pn="scr">
          <div class="pn-cab">
            <p class="pn-cab-t">Consumo</p>
            <p class="pn-cab-s">Todo lo que hace la IA se mide en créditos: 1 crédito es 1 sol de tu saldo.</p>
          </div>
          <div class="pn-cons-grid">
            <div class="pn-card pn-cred">
              <p class="pn-h">Créditos usados de tu saldo</p>
              <p class="pn-cred-v"><b data-pn="k-num" data-v={consumo.usados}>{miles(consumo.usados)}</b> de {miles(consumo.total)}</p>
              <p class="pn-cred-tk"><span data-pn="k-tokens" data-v={consumo.tokens}>{miles(consumo.tokens)}</span> tokens procesados</p>
              <div class="pn-medidor">
                <span class="pn-fill" data-pn="k-fill" style={`--p: ${consumo.usados / consumo.total}`}></span>
                <span class="pn-marca"><small>Aquí te avisamos</small></span>
              </div>
              <p class="pn-aviso" data-pn="k-aviso"><i></i>Te queda el 20&nbsp;% de tu saldo.</p>
            </div>
            <div class="pn-lado">
              <div class="pn-card pn-usos">
                <p class="pn-h">En qué se usaron</p>
                <ul>
                  {consumo.usos.map((u) => <li><span>{u.t}</span><b>{u.v}</b><i data-pn="k-uso" style={`--w: ${(u.v / consumo.usados).toFixed(3)}`}></i></li>)}
                </ul>
              </div>
              <div class="pn-card pn-reg">
                <p class="pn-h">Registro de cada uso</p>
                <table class="pn-tabla">
                  <tbody>
                    {consumo.registro.map((r) => <tr><td>{r.h}</td><td>{r.t}</td><td class="pn-n">{r.tk} tokens</td></tr>)}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Ventana de app que sigue el tema: solo variables de la marca. Medidas en em (la letra sale del ancho del contenedor). */
  .pn {
    --r: 0.7em;
    position: relative; width: 100%; aspect-ratio: 16 / 10; min-height: 0; overflow: hidden;
    display: grid; grid-template-rows: auto minmax(0, 1fr);
    font-size: clamp(7px, 1.75cqw, 18px); line-height: 1.3; color: var(--color-bone); text-align: left;
    background: var(--color-ink); border: 1px solid var(--color-line-strong); border-radius: 1em;
    box-shadow: 0 2.5em 5em -2.5em rgb(0 0 0 / 0.55);
    user-select: none;
  }
  .pn * { box-sizing: border-box; }
  /* Solo márgenes: un padding aquí pisaría el de las burbujas y avisos (este selector pesa más) */
  .pn p, .pn dd { margin: 0; }
  .pn ul, .pn dl { margin: 0; padding: 0; list-style: none; }
  .is-antes { visibility: hidden; opacity: 0; }

  /* Barra de la ventana */
  .pn-bar { display: flex; align-items: center; gap: 0.9em; padding: 0.7em 1em; white-space: nowrap; background: var(--color-surface); border-bottom: 1px solid var(--color-line); }
  .pn-dots { display: flex; gap: 0.35em; }
  .pn-dots i { width: 0.6em; height: 0.6em; border-radius: 99px; background: var(--color-line-strong); }
  .pn-negocio { font-size: 0.9em; font-weight: 600; }
  .pn-por { font-size: 0.72em; color: var(--color-ash); }
  .pn-rd { font-family: var(--font-display); font-weight: 800; color: var(--color-bone); letter-spacing: -0.01em; }
  .pn-rd b { color: var(--color-red-text); font-weight: 800; }
  .pn-tag { margin-left: auto; padding: 0.2em 0.65em; border-radius: 99px; border: 1px solid var(--color-line-strong); font-size: 0.68em; color: var(--color-ash); }

  .pn-body { display: grid; grid-template-columns: 11.5em minmax(0, 1fr); min-height: 0; }

  /* Menú: --on (0–1) marca el ítem activo; la línea de tiempo lo pasa de uno a otro */
  .pn-menu { padding: 0.9em 0.6em; overflow: hidden; background: var(--color-surface); border-right: 1px solid var(--color-line); }
  .pn-grupo + .pn-grupo { margin-top: 0.7em; }
  .pn-grupo-t { padding: 0 0.75em 0.3em; font-size: 0.62em; font-weight: 600; color: var(--color-ash-dim); }
  .pn-item { --on: 0; position: relative; isolation: isolate; padding: 0.24em 0.75em; border-radius: 0.45em; font-size: 0.74em; white-space: nowrap; }
  .pn-item span { opacity: calc(0.6 + var(--on) * 0.4); }
  .pn-item::after { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: var(--color-surface-2); opacity: var(--on); }
  .pn-item::before {
    content: ''; position: absolute; left: 0; top: 22%; bottom: 22%; width: 0.22em; border-radius: 99px;
    background: var(--color-red); opacity: var(--on); transform: scaleY(var(--on));
  }

  .pn-main { display: grid; grid-template-rows: auto minmax(0, 1fr); gap: 0.9em; min-width: 0; min-height: 0; padding: 1em 1.1em; }

  /* Cifras de arriba */
  .pn-kpis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.6em; }
  .pn-kpi { display: grid; align-content: start; gap: 0.15em; padding: 0.55em 0.7em; border-radius: var(--r); background: var(--color-surface); border: 1px solid var(--color-line); }
  .pn-kpi dt { font-size: 0.64em; line-height: 1.25; color: var(--color-ash); }
  .pn-kpi dd { order: -1; justify-self: start; transform-origin: 0 80%; font-family: var(--font-display); font-weight: 800; font-size: 1.3em; line-height: 1.05; font-variant-numeric: tabular-nums; }

  /* Pantallas apiladas: sin JS se ve la última */
  .pn-scrs { display: grid; grid-template-areas: 'scr'; min-height: 0; }
  .pn-scr { grid-area: scr; min-width: 0; min-height: 0; overflow: hidden; visibility: hidden; opacity: 0; }
  .pn-scr.pn-cons { visibility: visible; opacity: 1; }

  .pn-cab { display: grid; gap: 0.2em; margin-bottom: 0.8em; }
  .pn-cab-t { font-family: var(--font-display); font-weight: 800; font-size: 1.15em; letter-spacing: -0.02em; }
  .pn-cab-s { max-width: 70em; font-size: 0.74em; color: var(--color-ash); }
  .pn-cab-fila { display: flex; align-items: center; justify-content: space-between; gap: 1em; }
  .pn-card { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--r); }
  .pn-h { font-size: 0.68em; font-weight: 600; color: var(--color-ash); }
  .pn-chip { display: inline-block; justify-self: start; padding: 0.15em 0.55em; border-radius: 99px; border: 1px solid var(--color-line-strong); font-size: 0.62em; line-height: 1.3; color: var(--color-ash); white-space: nowrap; }
  .pn-chip.is-asesor { color: var(--color-red-text); border-color: currentColor; }
  .pn-btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.42em 0.8em; border-radius: 0.5em; border: 1px solid var(--color-line-strong); font-size: 0.7em; font-weight: 600; white-space: nowrap; }
  .pn-btn.is-rojo { background: var(--color-red); border-color: var(--color-red); color: #fff; }
  .pn-swap { display: inline-grid; justify-items: start; }
  .pn-swap > * { grid-area: 1 / 1; }
  .pn-cursor { position: absolute; left: 55%; top: 45%; z-index: 2; width: 1.25em; visibility: hidden; opacity: 0; pointer-events: none; }
  .pn-cursor :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }
  .pn-cursor :global(path) { fill: var(--color-bone); stroke: var(--color-ink); stroke-width: 1.2; stroke-linejoin: round; }

  /* Bandeja */
  .pn-ban { display: grid; grid-template-columns: 12.5em minmax(0, 1fr) 11.5em; gap: 0.7em; }
  .pn-convs { display: grid; align-content: start; gap: 0.35em; }
  .pn-conv { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.25em 0.5em; padding: 0.55em 0.65em; border-radius: var(--r); border: 1px solid transparent; }
  .pn-conv.is-sel { background: var(--color-surface); border-color: var(--color-line-strong); }
  .pn-conv-n { font-size: 0.74em; font-weight: 600; }
  .pn-conv-h { align-self: center; font-size: 0.6em; color: var(--color-ash-dim); }
  .pn-conv-m { grid-column: 1 / -1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 0.66em; color: var(--color-ash); }
  .pn-hilo { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; min-width: 0; overflow: hidden; background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--r); }
  .pn-hilo-cab { display: flex; align-items: center; justify-content: space-between; gap: 0.5em; padding: 0.6em 0.75em; border-bottom: 1px solid var(--color-line); }
  .pn-quien { display: grid; font-size: 0.74em; }
  .pn-quien span { font-size: 0.85em; color: var(--color-ash-dim); }
  .pn-msgs { display: flex; flex-direction: column; justify-content: flex-end; gap: 0.45em; min-height: 0; padding: 0.7em; overflow: hidden; }
  .pn-msg { max-width: 85%; padding: 0.5em 0.7em; border-radius: 0.8em; font-size: 0.7em; line-height: 1.35; }
  .pn-msg.is-in { align-self: flex-start; background: var(--color-surface-2); border-bottom-left-radius: 0.25em; }
  .pn-msg.is-out { align-self: flex-end; background: var(--color-ink); border: 1px solid var(--color-line-strong); border-bottom-right-radius: 0.25em; }
