---
// Versión 5 «Cartel»: hecha con la skill design-taste-frontend (dirección «Loud and flat», semilla 691477906).
// Paneles planos que alternan negro y crema, tipo pesada y fotos de archivo de ingeniería. Sin etiquetas
// en mayúsculas, sin monoespaciada, sin numeración, sin líneas finas ni degradados (reglas de la skill).
// La pieza viva son las papeletas con fechas reales; el momento fuerte, el nombre que corre en la portada.
import Base from '../layouts/Base.astro';
import Versiones from '../components/Versiones.astro';
import Portada from '../components/v5/Portada.astro';
import Escalera from '../components/v5/Escalera.astro';
import Entregas from '../components/v5/Entregas.astro';
import Construimos from '../components/v5/Construimos.astro';
import Verbos from '../components/v5/Verbos.astro';
import Fredy from '../components/v5/Fredy.astro';
import Preguntas from '../components/v5/Preguntas.astro';
import Cierre from '../components/v5/Cierre.astro';
---
<Base
  title="RebelDEV · Versión 5"
  description="RebelDEV es un estudio de desarrollo de software: asistentes de WhatsApp, automatización, plataformas web, backend, APIs e integraciones. Entregamos en semanas y funciona una semana en producción antes de que pagues."
  grano={false}
>
  <div class="v5">
    <main id="contenido">
      <Portada />
      <Escalera />
      <Entregas />
      <Construimos />
      <Verbos />
      <Fredy />
      <Preguntas />
    </main>
    <Cierre />
  </div>

  <Versiones actual="v5" />
</Base>

<style is:global>
  /* Roles de color de la versión 5, tomados de la paleta de la marca (CLAUDE.md, sección 4).
     Fondo negro y tinta crema; los campos claros invierten. El rojo marca la acción. */
  .v5 {
    --c-bg: #0B0A0E; --c-surface: #141019; --c-surface-2: #1D1824;
    --c-ink: #F4F0E8; --c-muted: #A7A0A8;
    --c-paper: #F4F0E8; --c-paper-ink: #0B0A0E; --c-paper-muted: #3A353F;
    --c-red: #E4121F; --c-red-text: #FF2D3F; --c-red-on-paper: #C40F1B; --c-amber: #FF6A2C;
    --c-wa: #0B141A; --c-wa-in: #1F2C34; --c-wa-out: #144D37;
    /* Tamaños: enorme, grande, enunciado y mediano; el texto va a 18 px y la nota a 15 px */
    --t-xl: clamp(96px, 15vw, 240px);
    --t-l: clamp(44px, 6.4vw, 104px);
    --t-s: clamp(24px, 2.5vw, 36px);
    --t-m: clamp(20px, 1.7vw, 24px);
    --m: clamp(20px, 2.2vw, 32px);
    background: var(--c-bg); color: var(--c-ink); overflow-x: clip; font-size: 18px;
  }
  .v5 h1, .v5 h2, .v5 h3 { text-wrap: balance; }
  .v5 .campo-claro { background: var(--c-paper); color: var(--c-paper-ink); }
  .v5 .campo-claro ::selection { background: var(--c-paper-ink); color: var(--c-paper); }
  .v5 :focus-visible { border-radius: 0; }
  .v5 .campo-claro :focus-visible { outline-color: var(--c-red-on-paper); }

  /* Un solo botón en toda la página: rectángulo plano, rojo. */
  .b5 {
    display: inline-flex; align-items: center; min-height: 56px; padding: 0 26px;
    background: var(--c-red); color: #fff; font-weight: 600; font-size: 18px;
    transition: background-color .2s, color .2s, transform .2s var(--ease-out-expo);
  }
  .b5:hover { background: var(--c-paper); color: var(--c-paper-ink); }
  .b5:active { transform: scale(0.97); }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../scripts/motion';
  import { papeletas, proximoLunes, fechaLarga } from '../lib/calendario';

  // ── La pieza viva: el calendario de las papeletas ──
  const tiras = document.querySelector<HTMLElement>('[data-en-tiras]');
  const ctrl = document.querySelector<HTMLElement>('[data-en-ctrl]');
  if (tiras && ctrl) {
    const min = Number(tiras.dataset.min), max = Number(tiras.dataset.max);
    let semanas = Number(tiras.dataset.inicial);
    const inicio = proximoLunes();
    const salida = ctrl.querySelector<HTMLOutputElement>('[data-en-n]')!;
    const menos = ctrl.querySelector<HTMLButtonElement>('[data-en-menos]')!;
    const mas = ctrl.querySelector<HTMLButtonElement>('[data-en-mas]')!;
    ctrl.querySelector('[data-en-inicio]')!.textContent = fechaLarga(inicio);
    ctrl.hidden = false;

    const pintar = (animar: boolean) => {
      salida.textContent = `${semanas} semanas`;
      menos.disabled = semanas <= min;
      mas.disabled = semanas >= max;
      for (const p of papeletas(semanas, inicio)) {
        const caja = tiras.querySelector<HTMLElement>(`[data-en-tira="${p.id}"] [data-en-lineas]`);
        if (!caja) continue;
        const nuevo = p.lineas.map((l) => `<p>${l}</p>`).join('');
        if (caja.innerHTML === nuevo) continue;
        caja.innerHTML = nuevo;
        if (animar && !reduceMotion) gsap.fromTo(caja.parentElement, { y: 14 }, { y: 0, duration: 0.5, ease: 'power3.out' });
      }
    };
    menos.addEventListener('click', () => { if (semanas > min) { semanas--; pintar(true); } });
    mas.addEventListener('click', () => { if (semanas < max) { semanas++; pintar(true); } });
    pintar(false);
  }

  // ── La línea de la portada: 40 px por segundo, sin importar el ancho ──
  const pista = document.querySelector<HTMLElement>('[data-pt-pista]');
  const medir = () => { if (pista) pista.style.setProperty('--pt-dur', `${pista.scrollWidth / 2 / 40}s`); };
  medir();
  document.fonts.ready.then(medir);
  window.addEventListener('resize', medir);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Entrada de cada sección: sus partes suben en orden, una vez. Si el scroll salta por encima de una
    // sección (un ancla, una tecla), onLeave la muestra igual: nada se queda oculto.
    const mostrar = (lote: Element[]) => gsap.fromTo(lote, { autoAlpha: 0, y: 28 }, { autoAlpha: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08, overwrite: true });
    ScrollTrigger.batch('[data-reveal]', { start: 'top 88%', once: true, onEnter: mostrar, onLeave: mostrar });

    // Portada: el nombre y la frase entran; el cuadrado se abre.
    gsap.timeline({ defaults: { ease: 'power4.out' } })
      .from('.pt-linea', { yPercent: 40, autoAlpha: 0, duration: 1.1 })
      .from('.pt-cuadro', { scale: 0.6, autoAlpha: 0, duration: 1 }, 0.1)
      .from('.pt-sub > *, .pt-pie > *', { y: 20, autoAlpha: 0, duration: 0.8, stagger: 0.07 }, 0.35);

    // Papeletas: suben desde el borde cuando aparece la sección.
    gsap.from('.en-tira', {
      yPercent: 40, duration: 1, ease: 'power3.out', stagger: 0.07,
      scrollTrigger: { trigger: '.en-tiras', start: 'top 92%', once: true },
    });
    gsap.fromTo('[data-en-fondo]', { scale: 1.12 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: '.en', start: 'top bottom', end: 'bottom top', scrub: true } });

    // Verbos: la foto se acerca despacio y la palabra cruza de derecha a izquierda mientras pasa el panel.
    gsap.utils.toArray<HTMLElement>('.vb-panel').forEach((panel) => {
      const st = { trigger: panel, start: 'top bottom', end: 'bottom top', scrub: true };
      gsap.fromTo(panel.querySelector('[data-vb-foto]'), { scale: 1.15 }, { scale: 1, ease: 'none', scrollTrigger: st });
      gsap.fromTo(panel.querySelector('[data-vb-verbo]'), { xPercent: 12 }, { xPercent: -12, ease: 'none', scrollTrigger: { ...st } });
    });
  });
  mm.add('(prefers-reduced-motion: reduce)', () => { gsap.set('[data-reveal]', { autoAlpha: 1 }); });
</script>
