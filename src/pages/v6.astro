---
// Versión 6 «Tablero»: hecha con la skill design-taste-frontend (dirección «The well-kept board»,
// semilla en .taste-skill/v6/direction.json). La página es un tablero de bloques encajados sin huecos,
// sobre el crema del modo claro de la marca, con bloques negros, rojos, ámbar y hueso. Las imágenes son
// piezas del producto hechas en HTML (chat, agenda, revisión, semana a prueba) y el video de la versión 2.
// La pieza viva: la demo de RebelBot con su ficha; si apagas un dato, no lo inventa y llama a un asesor.
// (Primer intento «Sala oscura» descartado el 30 oct 2026: se parecía demasiado a la v5.)
import Base from '../layouts/Base.astro';
import Versiones from '../components/Versiones.astro';
import Portada from '../components/v6/Portada.astro';
import Intro from '../components/v6/Intro.astro';
import Demo from '../components/v6/Demo.astro';
import Tablero from '../components/v6/Tablero.astro';
import Barra from '../components/v6/Barra.astro';
import Equipo from '../components/v6/Equipo.astro';
import Preguntas from '../components/v6/Preguntas.astro';
import Cierre from '../components/v6/Cierre.astro';
---
<Base
  title="RebelDEV · Versión 6"
  description="RebelDEV es un estudio de desarrollo de software: asistentes de WhatsApp con IA, automatización, plataformas web, backend, APIs e integraciones. Demo cada viernes y una semana en producción antes de pagar."
  grano={false}
>
  <div class="v6">
    <main id="contenido">
      <Portada />
      <Intro />
      <Demo />
      <Tablero />
      <Barra />
      <Equipo />
      <Preguntas />
    </main>
    <Cierre />
  </div>

  <Versiones actual="v6" />
</Base>

<style is:global>
  /* Roles de color de la versión 6: el modo claro de la marca (CLAUDE.md, sección 4) como fondo y los
     colores de la marca como bloques. Los bloques se separan por el hueco de 8 px, nunca por una línea. */
  .v6 {
    --bg: #F4F0E8; --ink: #0B0A0E; --muted: #4F4954;
    --hueso: #E4DDD0; --tinta: #0B0A0E; --rojo: #E4121F; --ambar: #FF6A2C;
    --bone: #F4F0E8; --red-text: #C40F1B;
    --surface: #141019; --surface-2: #1D1824; --accent: #E4121F; --accent-text: #FF2D3F;
    --wa: #0B141A; --wa-in: #1F2C34; --wa-out: #144D37;
    /* Cinco tamaños: exhibición, enunciado, subtítulo, texto y nota */
    --t-1: clamp(48px, 7vw, 112px);
    --t-2: clamp(26px, 2.6vw, 38px);
    --t-3: 20px;
    --t-body: 17px;
    --t-note: 15px;
    --m: 16px;
    --gap: 8px;
    --r: 8px;
    --sec: clamp(96px, 10vw, 160px);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--bg); color: var(--ink); overflow-x: clip;
    font-family: var(--font-instrument), sans-serif; font-size: var(--t-body); line-height: 1.5;
  }
  /* Las piezas de interfaz son oscuras, como la app: dentro de ellas la tinta vuelve a ser clara */
  .v6 [data-ui] { --ink: #F4F0E8; --muted: #A7A0A8; --amber: #FF6A2C; --bg: #0B0A0E; }
  .v6 h1, .v6 h2, .v6 h3 { font-family: var(--font-bricolage), sans-serif; font-weight: 800; letter-spacing: -0.035em; line-height: 0.98; text-wrap: balance; }
  .v6 ::selection { background: var(--ink); color: var(--bone); }
  .v6 :focus-visible { outline: 3px solid var(--rojo); outline-offset: 3px; }
  .v6 .marco { padding-inline: var(--m); }
  .v6 .rejilla { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap); }

  /* Los cuatro tonos de bloque, cada uno con su tinta */
  /* Valores fijos (no var(--ink)): así un bloque dentro de una pieza data-ui no hereda la tinta clara */
  .v6 .t-hueso { --b: #E4DDD0; --i: #0B0A0E; --i2: #4F4954; }
  .v6 .t-tinta { --b: #0B0A0E; --i: #F4F0E8; --i2: #A7A0A8; }
  .v6 .t-rojo { --b: #E4121F; --i: #fff; --i2: #fff; }
  .v6 .t-ambar { --b: #FF6A2C; --i: #0B0A0E; --i2: #0B0A0E; }
  .v6 .bloque { background: var(--b); color: var(--i); border-radius: var(--r); overflow: hidden; }

  /* Un solo botón en toda la página: rectángulo plano y rojo, con el radio del tablero */
  .b6 {
    display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 22px;
    border-radius: var(--r); background: var(--rojo); color: #fff; font-weight: 600; font-size: var(--t-body);
    text-decoration: none; white-space: nowrap; transition: background-color 0.2s, color 0.2s, transform 0.2s var(--ease);
  }
  .b6:hover { background: var(--ink); color: var(--bone); }
  .b6:active { transform: scale(0.97); }
  .t-rojo .b6 { background: var(--ink); color: var(--bone); }
  .t-rojo .b6:hover { background: var(--bone); color: var(--ink); }
  .v6 .enlace6 { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; transition: opacity 0.2s; }
  .v6 .enlace6:hover { text-decoration-thickness: 2px; }
</style>

<script>
  import { gsap } from '../scripts/motion';

  const piezas = gsap.utils.toArray<HTMLElement>('[data-reveal]');
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Entrada de las partes de cada sección (data-reveal), una vez, en orden. Con IntersectionObserver: la
    // demo cambia el alto de la página y unas posiciones guardadas quedarían viejas. Lo que ya quedó arriba
    // de la pantalla también se muestra.
    let lote: HTMLElement[] = [];
    const vaciar = () => {
      gsap.fromTo(lote, { autoAlpha: 0, y: 28 }, { autoAlpha: 1, y: 0, duration: 0.8, ease: 'power3.out', stagger: 0.07 });
      lote = [];
    };
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting && e.boundingClientRect.top > 0) continue;
        io.unobserve(e.target);
        if (!lote.length) requestAnimationFrame(vaciar);
        lote.push(e.target as HTMLElement);
      }
    }, { rootMargin: '0px 0px -6% 0px' });
    piezas.forEach((p) => io.observe(p));
    return () => io.disconnect();
  });
  mm.add('(prefers-reduced-motion: reduce)', () => { gsap.set(piezas, { autoAlpha: 1 }); });
</script>
