---
// Versión 3 «Del caos al sistema»: el estudio completo, no solo el asistente de WhatsApp.
// Dos momentos fuertes: la barra roja que corta el titular (HeroCorte) y las piezas sueltas de un
// negocio que se ordenan en un sistema (CaosSistema). El resto se mueve cuando la persona actúa:
// pasar el ratón por el índice, arrastrar la barra del comparador, abrir una pregunta.
// Fondo negro liso (sin grano). RebelBot aparece como un ejemplo dentro de los servicios.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Versiones from '../components/Versiones.astro';
import HeroCorte from '../components/v3/HeroCorte.astro';
import CaosSistema from '../components/v3/CaosSistema.astro';
import IndiceServicios from '../components/v3/IndiceServicios.astro';
import IaRevisa from '../components/v3/IaRevisa.astro';
import ProcesoCircuito from '../components/v3/ProcesoCircuito.astro';
import Comparador from '../components/v3/Comparador.astro';
import Fundador from '../components/v3/Fundador.astro';
import PreguntasV3 from '../components/v3/Preguntas.astro';
import CierrePiezas from '../components/v3/CierrePiezas.astro';
import { contacto } from '../data/contacto';
---
<Base
  title="RebelDEV · Versión 3"
  description="RebelDEV es un estudio de desarrollo de software. Creamos soluciones a medida según lo que necesita cada empresa: plataformas web, automatización, backend, APIs, integraciones y asistentes de WhatsApp."
  grano={false}
>
  <div class="v3">
    <header class="v3-nav" data-v3-nav>
      <a href="#inicio" class="v3-logo" aria-label="RebelDEV, ir al inicio"><Logo /></a>
      <nav class="v3-links" aria-label="Principal">
        <a href="#como">Cómo trabajamos</a>
        <a href="#servicios">Servicios</a>
        <a href="#proceso">Proceso</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a href={contacto.whatsappLink} target="_blank" rel="noopener" class="btn btn-primary v3-demo" data-magnetic>Agenda una demo</a>
      <button type="button" class="v3-menu-btn" aria-expanded="false" aria-controls="v3-menu" data-v3-menu-btn>Menú</button>
      <nav id="v3-menu" class="v3-menu" aria-label="Principal (móvil)" hidden data-v3-menu>
        <a href="#como">Cómo trabajamos</a>
        <a href="#servicios">Servicios</a>
        <a href="#proceso">Proceso</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
    </header>

    <main id="contenido">
      <HeroCorte />
      <CaosSistema />
      <IndiceServicios />
      <IaRevisa />
      <ProcesoCircuito />
      <Comparador />
      <Fundador />
      <PreguntasV3 />
    </main>

    <CierrePiezas />

    <footer class="wrap v3-foot">
      <span class="text-bone"><Logo /></span>
      <ul class="text-note text-ash">
        <li><a href={`mailto:${contacto.correo}`}>{contacto.correo}</a></li>
        <li><a href={contacto.whatsappLink} target="_blank" rel="noopener">WhatsApp {contacto.whatsapp}</a></li>
      </ul>
    </footer>

    <div class="v3-cursor" data-v3-cursor aria-hidden="true"><span></span></div>
  </div>

  <Versiones actual="v3" />
</Base>

<style is:global>
  /* Ritmo común de las secciones de la versión 3 */
  .v3-sec { padding-block: clamp(6rem, 12vw, 10rem); }
  /* La barra de arriba puede volver al subir: más margen al llegar por un enlace */
  .v3 section[id] { scroll-margin-top: 6rem; }
  .v3 { overflow-x: clip; }
</style>

<style>
  /* Barra de arriba: ancho completo; se esconde al bajar y vuelve al subir */
  .v3-nav {
    position: fixed; z-index: 50; inset: 0 0 auto 0; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 0.9rem clamp(1.25rem, 4vw, 3rem); transition: background-color 0.4s, border-color 0.4s, transform 0.5s var(--ease-out-expo);
    border-bottom: 1px solid transparent;
  }
  .v3-nav.is-solid { background: color-mix(in srgb, var(--color-ink) 82%, transparent); border-color: var(--color-line); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .v3-nav.is-hidden { transform: translateY(-110%); }
  .v3-nav:focus-within { transform: none; }
  .v3-logo { font-size: 1.2rem; color: var(--color-bone); }
  .v3-links { display: none; gap: 2rem; margin-left: auto; }
  .v3-links a { color: var(--color-ash); font-size: 0.95rem; transition: color 0.3s; }
  .v3-links a:hover { color: var(--color-bone); }
  .v3-demo { padding: 0.75rem 1.1rem; font-size: 0.9rem; margin-left: auto; }
  @media (min-width: 900px) { .v3-links { display: flex; } .v3-demo { margin-left: 0; } }

  /* Menú en pantallas angostas */
  .v3-menu-btn { padding: 0.75rem 1rem; border-radius: 999px; border: 1px solid var(--color-line-strong); color: var(--color-bone); font-weight: 600; font-size: 0.9rem; line-height: 1; cursor: pointer; touch-action: manipulation; }
  .v3-menu-btn[aria-expanded="true"] { border-color: var(--color-bone); }
  .v3-menu { position: absolute; top: calc(100% + 0.5rem); right: clamp(1.25rem, 4vw, 3rem); display: grid; min-width: 14rem; padding: 0.5rem; border-radius: 1rem; background: var(--color-surface); border: 1px solid var(--color-line-strong); }
  .v3-menu[hidden] { display: none; }
  .v3-menu a { padding: 0.8rem 0.9rem; border-radius: 0.6rem; color: var(--color-bone); }
  .v3-menu a:hover { background: var(--color-surface-2); }
  @media (min-width: 900px) { .v3-menu-btn, .v3-menu { display: none; } }
  .v3-demo { white-space: nowrap; }
  @media (max-width: 480px) { .v3-demo { display: none; } .v3-menu-btn { margin-left: auto; } }

  .v3-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; padding-block: 3rem; }
  .v3-foot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .v3-foot a:hover { color: var(--color-bone); }

  /* Cursor: una barra roja que se inclina con la velocidad. El cursor del sistema sigue visible. */
  .v3-cursor { display: none; }
  :global(html.has-cursor) .v3-cursor {
    display: block; position: fixed; left: 0; top: 0; z-index: 70; pointer-events: none; width: 0; height: 0;
  }
  .v3-cursor span {
    position: absolute; left: 14px; top: 10px; width: 3px; height: 20px; border-radius: 3px; background: var(--color-red);
    transform: rotate(18deg); transition: width 0.3s, height 0.3s, opacity 0.3s;
  }
  :global(html.has-cursor) .v3-cursor.is-link span { height: 30px; }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion, coarsePointer } from '../scripts/motion';

  // Barra de arriba: con fondo cuando ya no está sobre el hero; se esconde al bajar y vuelve al subir.
  const nav = document.querySelector<HTMLElement>('[data-v3-nav]')!;
  const menuBtn = nav.querySelector<HTMLButtonElement>('[data-v3-menu-btn]')!;
  const menu = nav.querySelector<HTMLElement>('[data-v3-menu]')!;
  const setMenu = (open: boolean) => { menu.hidden = !open; menuBtn.setAttribute('aria-expanded', String(open)); };
  menuBtn.addEventListener('click', () => setMenu(menu.hidden));
  menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setMenu(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setMenu(false); menuBtn.focus(); } });
  document.addEventListener('pointerdown', (e) => { if (!nav.contains(e.target as Node)) setMenu(false); });
  ScrollTrigger.create({
    start: 80, end: 'max',
    onUpdate: (self) => nav.classList.toggle('is-hidden', !reduceMotion && menu.hidden && self.direction === 1 && self.scroll() > 400),
    onToggle: (self) => nav.classList.toggle('is-solid', self.isActive),
  });

  if (!reduceMotion && !coarsePointer) {
    // Botones magnéticos: se acercan un poco al puntero.
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      const x = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3.out' });
      const y = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3.out' });
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        x((e.clientX - r.left - r.width / 2) * 0.25);
        y((e.clientY - r.top - r.height / 2) * 0.35);
      });
      el.addEventListener('pointerleave', () => { x(0); y(0); });
    });

    // Cursor «/»: sigue al puntero y se inclina más cuanto más rápido se mueve.
    const cur = document.querySelector<HTMLElement>('[data-v3-cursor]')!;
    const bar = cur.querySelector('span')!;
    document.documentElement.classList.add('has-cursor');
    const cx = gsap.quickTo(cur, 'x', { duration: 0.35, ease: 'power3.out' });
    const cy = gsap.quickTo(cur, 'y', { duration: 0.35, ease: 'power3.out' });
    const tilt = gsap.quickTo(bar, 'rotation', { duration: 0.5, ease: 'power3.out' });
    let lx = 0, rest = 0;
    gsap.set(bar, { autoAlpha: 0 });
    window.addEventListener('pointermove', (e) => {
      if (!lx) { gsap.set(cur, { x: e.clientX, y: e.clientY }); gsap.to(bar, { autoAlpha: 1, duration: 0.2 }); }
      cx(e.clientX); cy(e.clientY);
      tilt(18 + gsap.utils.clamp(-30, 30, (e.clientX - lx) * 1.2));
      lx = e.clientX;
      clearTimeout(rest);
      rest = window.setTimeout(() => tilt(18), 120);
      cur.classList.toggle('is-link', !!(e.target as Element).closest?.('a, button, summary, [role="slider"]'));
    });
    document.addEventListener('pointerleave', () => gsap.to(bar, { autoAlpha: 0, duration: 0.2 }));
    document.addEventListener('pointerenter', () => gsap.to(bar, { autoAlpha: 1, duration: 0.2 }));
  }
</script>
