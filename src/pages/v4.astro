---
// Versión 4 «Tu diagnóstico»: el visitante marca lo que hoy le quita tiempo y una maqueta 3D arma
// el sistema que construiríamos. La selección viaja por toda la página (barra, preguntas, cierre)
// y llega escrita en el mensaje de WhatsApp. Un solo momento fuerte (la maqueta); el resto, quieto.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Versiones from '../components/Versiones.astro';
import LogoBloqueo from '../components/v4/LogoBloqueo.astro';
import Diagnostico from '../components/v4/Diagnostico.astro';
import FlujoRebelBot from '../components/v4/FlujoRebelBot.astro';
import ProcesoPago from '../components/v4/ProcesoPago.astro';
import IaDecide from '../components/v4/IaDecide.astro';
import Fundador from '../components/v4/Fundador.astro';
import Preguntas from '../components/v4/Preguntas.astro';
import Cierre from '../components/v4/Cierre.astro';
import { contacto } from '../data/contacto';
import { barra } from '../data/v4';
import { enlaceWhatsApp } from '../lib/diagnostico';
---
<Base
  title="RebelDEV · Versión 4"
  description="RebelDEV es un estudio de desarrollo de software. Marca lo que hoy le quita tiempo a tu negocio y mira qué construiríamos: asistentes de WhatsApp, automatización, plataformas web, backend, APIs e integraciones."
  grano={false}
>
  <div class="v4">
    <header class="v4-nav" data-v4-nav>
      <a href="#inicio" class="v4-logo" aria-label="RebelDEV, ir al inicio"><LogoBloqueo /></a>
      <a href="#sintomas" class="btn btn-primary v4-cta" data-v4-cta data-magnetic>
        <span class="v4-largo" data-v4-cta-largo>{barra.sin}</span><span class="v4-corto" data-v4-cta-corto>{barra.sinCorto}</span>
      </a>
    </header>

    <main id="contenido">
      <Diagnostico />
      <FlujoRebelBot />
      <ProcesoPago />
      <IaDecide />
      <Fundador />
      <Preguntas />
    </main>

    <Cierre />

    <footer class="wrap v4-foot">
      <span class="text-bone"><Logo /></span>
      <ul class="text-note text-ash" role="list">
        <li><a href={`mailto:${contacto.correo}`}>{contacto.correo}</a></li>
        <li><a href={enlaceWhatsApp([])} target="_blank" rel="noopener" data-v4-wa>WhatsApp {contacto.whatsapp}</a></li>
      </ul>
    </footer>
  </div>

  <Versiones actual="v4" />
</Base>

<style is:global>
  /* Ritmo común de las secciones de la versión 4 */
  .v4 { --v4-nav: 4.25rem; overflow-x: clip; }
  .v4-sec { padding-block: clamp(6rem, 12vw, 10rem); }
  .v4 section[id] { scroll-margin-top: var(--v4-nav); }
</style>

<style>
  /* Barra mínima: el logo y un solo botón. Transparente sobre el hero; con fondo al bajar. */
  .v4-nav {
    position: fixed; z-index: 50; inset: 0 0 auto 0; height: var(--v4-nav);
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding-inline: clamp(1.25rem, 4vw, 3rem); border-bottom: 1px solid transparent;
    transition: background-color 0.4s, border-color 0.4s;
  }
  .v4-nav.is-solid { background: color-mix(in srgb, var(--color-ink) 82%, transparent); border-color: var(--color-line); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .v4-logo { display: inline-flex; color: var(--color-bone); font-size: 1.2rem; }
  .v4-cta { padding: 0.75rem 1.1rem; font-size: 0.9rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .v4-corto { display: none; }
  /* Pantallas angostas: logo más chico y texto corto en el botón, para que quepan los dos */
  @media (max-width: 479px) {
    .v4-logo :global(.lb) { height: 1.125rem; }
    .v4-largo { display: none; }
    .v4-corto { display: inline; }
  }

  .v4-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; padding-block: 3rem; }
  .v4-foot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .v4-foot a:hover { color: var(--color-bone); }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion, coarsePointer, lenis } from '../scripts/motion';
  import { alCambiar } from '../scripts/v4/estado';
  import { enlaceWhatsApp } from '../lib/diagnostico';
  import { barra } from '../data/v4';

  const nav = document.querySelector<HTMLElement>('[data-v4-nav]')!;
  const cta = nav.querySelector<HTMLAnchorElement>('[data-v4-cta]')!;
  const ctaLargo = cta.querySelector<HTMLElement>('[data-v4-cta-largo]')!;
  const ctaCorto = cta.querySelector<HTMLElement>('[data-v4-cta-corto]')!;
  const waPie = document.querySelector<HTMLAnchorElement>('[data-v4-wa]');

  // Con fondo cuando ya no está sobre el inicio de la página.
  ScrollTrigger.create({ start: 40, end: 'max', onToggle: (self) => nav.classList.toggle('is-solid', self.isActive) });

  // El botón cambia según la selección: sin nada marcado lleva a los síntomas; con algo, abre WhatsApp.
  let n = 0;
  alCambiar((d) => {
    n = d.ids.length;
    if (waPie) waPie.href = enlaceWhatsApp(d.ids);
    if (n) {
      ctaLargo.textContent = `${barra.con} (${n})`;
      ctaCorto.textContent = `${barra.conCorto} (${n})`;
      cta.href = enlaceWhatsApp(d.ids);
      cta.target = '_blank';
      cta.rel = 'noopener';
    } else {
      ctaLargo.textContent = barra.sin;
      ctaCorto.textContent = barra.sinCorto;
      cta.href = '#sintomas';
      cta.removeAttribute('target');
      cta.removeAttribute('rel');
    }
  });

  // En el móvil la maqueta queda pegada bajo la barra: los síntomas tienen que quedar debajo de ella.
  const escenario = document.querySelector<HTMLElement>('[data-dg-stage]');
  const movil = window.matchMedia('(max-width: 1023px)');
  const margen = () => nav.offsetHeight + 20
    + (escenario && movil.matches && getComputedStyle(escenario).position === 'sticky' ? escenario.offsetHeight : 0);

  cta.addEventListener('click', (e) => {
    if (n) return;
    // Lenis también atiende los clics en anclas (en window) e ignora preventDefault: sin cortar la
    // propagación, su desplazamiento pisaría este (otro margen y sin foco al llegar).
    e.preventDefault();
    e.stopPropagation();
    const destino = document.getElementById('sintomas');
    if (!destino) return;
    const primero = destino.querySelector<HTMLInputElement>('input');
    const enfocar = () => primero?.focus({ preventScroll: true });
    if (lenis) lenis.scrollTo(destino, { offset: -margen(), onComplete: enfocar });
    else { window.scrollTo({ top: destino.getBoundingClientRect().top + window.scrollY - margen() }); enfocar(); }
  });

  if (!reduceMotion && !coarsePointer) {
    // Botones magnéticos: se acercan un poco al puntero.
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      const x = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3.out' });
      const y = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3.out' });
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        x((e.clientX - r.left - r.width / 2) * 0.2);
        y((e.clientY - r.top - r.height / 2) * 0.3);
      });
      el.addEventListener('pointerleave', () => { x(0); y(0); });
    });
  }
</script>
